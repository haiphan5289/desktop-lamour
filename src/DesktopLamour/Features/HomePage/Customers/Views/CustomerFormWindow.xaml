<Window x:Class="DesktopLamour.Features.HomePage.Customers.Views.CustomerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="{Binding WindowTitle}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- Decorative header -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="{Binding WindowTitle}"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Thông tin khách hàng"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form content -->
        <StackPanel Grid.Row="1" Margin="24,20,24,8">

            <!-- Mã khách hàng (read-only — auto-generated) -->
            <StackPanel Margin="0,0,0,16">
                <controls:AppLabel Text="Mã khách hàng (tự động sinh)"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Margin="0,0,0,6"/>
                <controls:AppTextField Text="{Binding Code, Mode=OneWay}"
                                       Placeholder="Tự động sinh (VD: KH00001)"
                                       IsEnabled="False"/>
            </StackPanel>

            <!-- Tên khách hàng (required) -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:AppLabel Text="Tên khách hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                    <controls:AppLabel Text=" *"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
                <controls:AppTextField Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="VD: CHI NHI"/>
            </StackPanel>

            <!-- Điện thoại (optional) -->
            <StackPanel Margin="0,0,0,16">
                <controls:AppLabel Text="Điện thoại"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Margin="0,0,0,6"/>
                <controls:AppTextField Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="VD: 0912345678"/>
            </StackPanel>

            <!-- Địa chỉ (optional) -->
            <StackPanel Margin="0,0,0,16">
                <controls:AppLabel Text="Địa chỉ"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Margin="0,0,0,6"/>
                <controls:AppTextField Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="VD: 351 Nguyễn Thiện Thuật, P.6, Q.3, HCM"/>
            </StackPanel>

            <!-- Two-column: Tỉnh + Nhóm KH -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Tỉnh"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,6"/>
                    <controls:AppTextField Text="{Binding Province, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VD: TP HỒ CHÍ MINH"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="Nhóm KH"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,6"/>
                    <controls:AppTextField Text="{Binding CustomerGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VD: TP HỒ CHÍ MINH"/>
                </StackPanel>
            </Grid>

            <!-- Mã số thuế (optional) -->
            <StackPanel Margin="0,0,0,16">
                <controls:AppLabel Text="Mã số thuế"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Margin="0,0,0,6"/>
                <controls:AppTextField Text="{Binding TaxCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="VD: 0123456789"/>
            </StackPanel>

            <!-- Error message -->
            <Border Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding ErrorMessage}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

        </StackPanel>

        <!-- Action buttons -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton Content="Hủy"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,12,0"/>
                <controls:AppButton Content="💾 Lưu"
                                    Style="{StaticResource AppButton.Primary.Large}"
                                    Command="{Binding SaveCommand}"
                                    Width="140"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
