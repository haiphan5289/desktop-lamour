<Window x:Class="DesktopLamour.Features.HomePage.Backups.Views.RestoreConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="Xác nhận phục hồi dữ liệu"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Warning header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Form content -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Action buttons -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 0: Warning header                          -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundErrorLight}"
                Padding="24,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <controls:AppLabel Text="Cảnh báo: hành động không thể hoàn tác"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextError}"
                                       VerticalAlignment="Center"/>
                </StackPanel>
                <controls:AppLabel Text="{Binding FileName, StringFormat='Toàn bộ dữ liệu hiện tại sẽ bị XÓA và thay bằng dữ liệu trong file: {0}'}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"
                                   Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 1: Form content                           -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="24,16,24,8">
            <controls:AppLabel Text="Nhập mật khẩu Admin để xác nhận"
                               Style="{StaticResource AppTypography.LabelSection}"
                               Margin="0,0,0,6"/>
            <controls:AppPasswordField BoundPassword="{Binding Password, Mode=TwoWay}"
                                       AutomationProperties.Name="Password"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 2: Action buttons                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton Content="Hủy"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,12,0"/>
                <controls:AppButton Content="🔄 Phục hồi"
                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                    Command="{Binding ConfirmCommand}"
                                    Width="140"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
