<UserControl x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderReportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar                                       -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="🖨️ In"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding PrintCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✉️ Gửi Email"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendEmailCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="💬 Zalo"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendZaloCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🧹 Xóa điều kiện"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ClearFiltersCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✖ Đóng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Title                                         -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0" HorizontalAlignment="Center">
            <controls:AppLabel Text="SỔ CHI TIẾT BÁN HÀNG"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               HorizontalAlignment="Center"/>
            <controls:AppLabel Text="{Binding Title}"
                               Style="{StaticResource AppTypography.BodySection}"
                               Foreground="{StaticResource AppColor.TextBrand}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
            <controls:AppLabel Text="{Binding FilterSummary}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid                                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,16,24,0">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="DetailGrid"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      ColumnHeaderHeight="56"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="DetailGrid_MouseDoubleClick"
                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- DataGridColumnHeader centers its content by default — without this, the filter
                     row (StackPanel/Grid + AppTextField/ComboBox, all set to Stretch) still just
                     sizes to its natural width and sits centered instead of filling the column. -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <!-- Ngày hạch toán — date column: operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Header="Ngày hạch toán"
                                        Binding="{Binding AccountingDate, StringFormat=\{0:dd/MM/yyyy\}}"
                                        Width="135">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngày hạch toán" FontWeight="SemiBold"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.AccountingDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                    SelectedDate="{Binding DataContext.AccountingDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FontSize="10" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số chứng từ — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Số chứng từ"
                                        Binding="{Binding DocumentNumber}"
                                        Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số chứng từ" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDocumentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Khách hàng — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Khách hàng"
                                        Binding="{Binding CustomerName}"
                                        Width="150">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Khách hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterCustomerName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Nhân viên — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Nhân viên"
                                        Binding="{Binding EmployeeName}"
                                        Width="130">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Nhân viên" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterEmployeeName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Mã hàng — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Mã hàng"
                                        Binding="{Binding ProductCode}"
                                        Width="90">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Mã hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterProductCode, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tên hàng — text column: plain Contains filter, inline. Fixed width (not "*") —
                         mixing a star column with HorizontalScrollBarVisibility="Auto" is a known WPF
                         DataGrid quirk that clips trailing columns instead of scrolling to them. -->
                    <DataGridTextColumn Header="Tên hàng"
                                        Binding="{Binding ProductName}"
                                        Width="220">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tên hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterProductName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ĐVT — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="ĐVT"
                                        Binding="{Binding Unit}"
                                        Width="70">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="ĐVT" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterUnit, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số lượng — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Số lượng"
                                        Binding="{Binding Quantity}"
                                        Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số lượng" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.QuantityFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.QuantityFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Đơn giá — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Đơn giá"
                                        Binding="{Binding UnitPrice, StringFormat=\{0:N0\}}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Đơn giá" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.UnitPriceFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.UnitPriceFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tỷ lệ CK(%) — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Tỷ lệ CK(%)"
                                        Binding="{Binding DiscountRate, StringFormat=\{0:N2\}}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tỷ lệ CK(%)" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.DiscountRateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.DiscountRateFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Thành tiền — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Thành tiền"
                                        Binding="{Binding Amount, StringFormat=\{0:N0\}}"
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Thành tiền" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.AmountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.AmountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Thuế suất — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Thuế suất"
                                        Binding="{Binding TaxRate, StringFormat={}{0:0}%}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Thuế suất" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.TaxRateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.TaxRateFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tiền thuế — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Tiền thuế"
                                        Binding="{Binding TaxAmount, StringFormat=\{0:N0\}}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tiền thuế" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.TaxAmountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.TaxAmountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tổng cộng — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Tổng cộng"
                                        Binding="{Binding GrandTotal, StringFormat=\{0:N0\}}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                                <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight"          Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tổng cộng" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.GrandTotalFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.GrandTotalFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="🧾" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Không có chứng từ nào khớp."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Footer                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="24,12,24,24"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:AppLabel Grid.Column="0"
                                   Text="{Binding RowCount, StringFormat='Số dòng = {0}'}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:AppLabel Text="Tổng SL:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalQuantity}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="60"/>

                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <controls:AppLabel Text="Tiền thuế:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalTaxAmount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="90"/>

                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <controls:AppLabel Text="Tổng cộng:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalGrandTotal, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="110"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
