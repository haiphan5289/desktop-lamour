<UserControl x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Page header -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Filter bar -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="Chứng từ bán hàng"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar actions                               -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="➕ Thêm"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding AddSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✏️ Sửa"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding EditSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="⏸ Treo"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding HoldSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🗑️ Xóa"
                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                    Command="{Binding DeleteSalesOrderCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Filter bar                                    -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="24,8,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <!-- Mọi ô cùng Height="36" + VerticalAlignment="Center" để nhãn/DatePicker/ô tìm kiếm/nút
                 Lọc canh giữa theo cùng 1 baseline (AppButton.Primary.Medium mặc định cao 40, các ô
                 khác 34 — lệch nhau nên phải ép về cùng chiều cao). -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:AppLabel Text="Từ ngày:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="20,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                            Width="130" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

                <controls:AppLabel Text="Đến ngày:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                            Width="130" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

                <controls:AppTextField Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="🔍 Tìm kiếm chứng từ..."
                                       Width="320" Height="36" VerticalAlignment="Center"
                                       Margin="24,0,0,0"/>

                <controls:AppButton Content="🔍 Lọc"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding FilterCommand}"
                                    Height="36" VerticalAlignment="Center"
                                    Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid + totals footer                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- DataGrid (+ overlays) -->
                <RowDefinition Height="Auto"/>  <!-- Totals footer -->
            </Grid.RowDefinitions>

            <!-- Error banner -->
            <Border Grid.Row="0" Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="OrdersGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding SalesOrders}"
                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                      PreviewMouseRightButtonDown="OrdersGrid_PreviewMouseRightButtonDown"
                      Visibility="{Binding HasSalesOrders, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Chuột phải trên lưới — chỉ 5 mục thao tác thật có nghiệp vụ tương ứng (Thêm/
                     Nhân bản/Xem/Xóa/Gửi email,Zalo), không rập khuôn toàn bộ menu tham chiếu (các
                     mục như "Ghi sổ"/"Lập phiếu xuất..."/"Sửa mẫu..." thuộc phần mềm khác, app này
                     chưa có nghiệp vụ đó). InputGestureText chỉ hiển thị chữ phím tắt cho giống ảnh
                     mẫu — KHÔNG wiring KeyBinding thật (ngoài phạm vi yêu cầu ban đầu). -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Thêm" InputGestureText="Ctrl+N" Command="{Binding AddSalesOrderCommand}"/>
                        <MenuItem Header="Nhân bản..." InputGestureText="Ctrl+C" Command="{Binding DuplicateSalesOrderCommand}"/>
                        <Separator/>
                        <MenuItem Header="Xem" InputGestureText="Ctrl+E" Command="{Binding EditSalesOrderCommand}"/>
                        <MenuItem Header="Xóa" InputGestureText="Ctrl+D" Command="{Binding DeleteSalesOrderCommand}"/>
                        <Separator/>
                        <MenuItem Header="Gửi email, Zalo" InputGestureText="Ctrl+Shift+G">
                            <MenuItem Header="Email" Command="{Binding SendEmailCommand}"/>
                            <MenuItem Header="Zalo" Command="{Binding SendZaloCommand}"/>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <!-- Trạng thái KHÔNG còn là 1 cột riêng — theo đúng UI MISA (ảnh mẫu: không có cột
                     "Trạng thái", chỉ tô màu chữ cả dòng theo trạng thái). Trước đây dùng
                     DataGrid.CellStyle tô nền vàng nhạt (AppColor.BackgroundWarningLight) cho ô
                     "Trạng thái" của dòng Treo — bug: khi CLICK CHỌN dòng đó, style mặc định của
                     DataGridCell đổi Foreground sang trắng cho trạng thái Selected, nhưng trigger
                     nền vàng ở đây vẫn đè lên nền xanh chọn mặc định → chữ trắng trên nền vàng nhạt
                     gần như vô hình ("click vào không thấy chữ"). Fix: bỏ hẳn nền tô riêng, đổi
                     sang tô FOREGROUND cả dòng qua RowStyle — TextElement.Foreground là thuộc tính
                     kế thừa nên mọi TextBlock con (trừ cột đã tự set Foreground riêng như "Tổng
                     thanh toán") tự động đổi màu theo, không đụng tới nền nên không còn xung đột với
                     màu nền/chữ lúc Selected nữa. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusLabel}" Value="⏸ Treo">
                                <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Số chứng từ" Binding="{Binding DocumentNumber}" Width="120"/>

                    <DataGridTextColumn Header="Ngày"
                                        Binding="{Binding DocumentDate, StringFormat=\{0:dd/MM/yyyy\}}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Description}" Width="200"/>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="180"/>
                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding EmployeeName}" Width="140"/>

                    <DataGridTextColumn Header="Tổng tiền hàng" Binding="{Binding TotalGross, StringFormat=\{0:N0\}}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Tổng CK" Binding="{Binding TotalDiscount, StringFormat=\{0:N0\}}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Tiền thuế GTGT" Binding="{Binding TotalTax, StringFormat=\{0:N0\}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Tổng thanh toán" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPayment, StringFormat=\{0:N0\}}" Padding="6,0" VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource AppColor.TextBrand}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="180"/>

                </DataGrid.Columns>
            </DataGrid>

            <!-- ══════════════════════════════════════════════ -->
            <!--  Totals footer — cộng dồn Tổng tiền hàng/Tổng CK/Tổng thanh toán trên danh sách đã   -->
            <!--  lọc, canh đúng theo bề rộng cột tương ứng ở DataGrid phía trên để đọc như 1 hàng    -->
            <!--  "Tổng cộng" gắn liền cuối lưới thay vì 1 khối tách rời.                             -->
            <!-- ══════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{StaticResource AppColor.BackgroundSecondary}"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1,0,1,1"
                    Visibility="{Binding HasSalesOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>  <!-- Trạng thái -->
                        <ColumnDefinition Width="120"/>  <!-- Số chứng từ -->
                        <ColumnDefinition Width="100"/>  <!-- Ngày -->
                        <ColumnDefinition Width="200"/>  <!-- Diễn giải -->
                        <ColumnDefinition Width="*"/>    <!-- Khách hàng -->
                        <ColumnDefinition Width="140"/>  <!-- Nhân viên -->
                        <ColumnDefinition Width="130"/>  <!-- Tổng tiền hàng -->
                        <ColumnDefinition Width="110"/>  <!-- Tổng CK -->
                        <ColumnDefinition Width="120"/>  <!-- Tiền thuế GTGT -->
                        <ColumnDefinition Width="140"/>  <!-- Tổng thanh toán -->
                        <ColumnDefinition Width="*"/>    <!-- Ghi chú -->
                    </Grid.ColumnDefinitions>

                    <controls:AppLabel Grid.Column="0" Grid.ColumnSpan="5"
                                       Text="{Binding TotalCount, StringFormat='Tổng cộng: {0} chứng từ'}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"
                                       Padding="6,10"/>

                    <TextBlock Grid.Column="6"
                               Text="{Binding TotalGrossSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"/>

                    <TextBlock Grid.Column="7"
                               Text="{Binding TotalDiscountSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"/>

                    <TextBlock Grid.Column="8"
                               Text="{Binding TotalTaxSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"/>

                    <TextBlock Grid.Column="9"
                               Text="{Binding TotalPaymentSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"
                               Foreground="{StaticResource AppColor.TextBrand}"/>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSalesOrders, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="🧾" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chưa có chứng từ bán hàng nào."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
