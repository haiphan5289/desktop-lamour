<UserControl x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             xmlns:local="clr-namespace:DesktopLamour.Features.HomePage.Sales.ViewModels"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <!-- Phím tắt thật (2026-09-11) — khớp danh sách hiển thị trên context menu bên dưới, TRỪ
         Ctrl+C (Nhân bản): DataGrid mặc định dùng Ctrl+C để copy giá trị ô/dòng đang chọn vào
         clipboard (dán qua Excel) — không gán đè, "Nhân bản..." trên menu vẫn chỉ hiển thị chữ
         "Ctrl+C" cho giống ảnh mẫu, không có KeyBinding thật đứng sau. -->
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding AddSalesOrderCommand}"/>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding EditSalesOrderCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DeleteSalesOrderCommand}"/>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding ConfirmSalesOrderCommand}"/>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding UnconfirmSalesOrderCommand}"/>
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Page header -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Filter bar -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="Chứng từ bán hàng"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar actions                               -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="➕ Thêm"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding AddSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✏️ Sửa"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding EditSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <!-- 2026-09-11: thêm "Ghi sổ" thẳng từ danh sách — mirror SalesReturnListView cùng
                     ngày, trước đó chỉ có "Bỏ ghi", không có action đối xứng. -->
                <controls:AppButton Content="📗 Ghi sổ"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ConfirmSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="↩️ Bỏ ghi"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding UnconfirmSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🗑️ Xóa"
                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                    Command="{Binding DeleteSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <!-- 2026-09-13: mirror SalesReturnListView — trước đây thiếu hẳn nút xuất Excel ở
                     màn này. -->
                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"
                                    Margin="0,0,8,0"/>
                <!-- 2026-09-14: tách "Gửi email, Zalo" (trước đây 1 nút dropdown) thành 2 nút riêng
                     biệt theo yêu cầu — Command gán thẳng như Sửa/Xóa nên WPF tự gray từng nút theo
                     CanExecute=HasSelection, không cần IsEnabled/Click code-behind thủ công nữa. -->
                <controls:AppButton Content="✉️ Gửi email"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendEmailCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="💬 Gửi Zalo"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendZaloCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Filter bar                                    -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="24,8,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <!-- Mọi ô cùng Height="36" + VerticalAlignment="Center" để nhãn/DatePicker/ô tìm kiếm/nút
                 Lọc canh giữa theo cùng 1 baseline (AppButton.Primary.Medium mặc định cao 40, các ô
                 khác 34 — lệch nhau nên phải ép về cùng chiều cao). -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 2026-09-13: mirror SalesReturnListView — trước đây thiếu hẳn "Kỳ" ở màn này. -->
                <controls:AppLabel Text="Kỳ:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{x:Static local:SalesOrderListViewModel.PeriodOptions}"
                          SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                          Width="150" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Margin="0,0,16,0"/>

                <controls:AppLabel Text="Từ ngày:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                            Width="130" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Margin="0,0,16,0"/>

                <controls:AppLabel Text="Đến ngày:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                            Width="130" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Margin="0,0,16,0"/>

                <!-- 2026-09-13: mirror SalesReturnListView — trước đây thiếu hẳn "Trạng thái" ở màn này. -->
                <controls:AppLabel Text="Trạng thái:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <!-- 2026-09-18: bỏ ô "Tìm kiếm chứng từ..." + nút "Lọc" theo yêu cầu, mirror
                     SalesReturnListView (đã bỏ từ 2026-09-14) — các bộ lọc khác (Kỳ/Từ-Đến
                     ngày/Trạng thái) và từng cột "Lọc..." riêng ở header DataGrid bên dưới đã tự áp
                     dụng ngay khi đổi (live filter), không phụ thuộc vào nút "Lọc" hay ô tìm kiếm
                     tổng quát này. -->
                <ComboBox ItemsSource="{x:Static local:SalesOrderListViewModel.StatusOptions}"
                          SelectedItem="{Binding FilterStatus, Mode=TwoWay}"
                          Width="120" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid + totals footer                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- DataGrid (+ overlays) -->
                <RowDefinition Height="Auto"/>  <!-- Totals footer -->
            </Grid.RowDefinitions>

            <!-- Error banner -->
            <Border Grid.Row="0" Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="OrdersGrid"
                      Grid.Row="0"
                      ItemsSource="{Binding SalesOrdersView}"
                      SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                      PreviewMouseRightButtonDown="OrdersGrid_PreviewMouseRightButtonDown"
                      Visibility="{Binding HasSalesOrders, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- Chuột phải trên lưới — chỉ mục thao tác thật có nghiệp vụ tương ứng (Thêm/
                     Nhân bản/Xem/Xóa/Ghi sổ/Bỏ ghi/Gửi email,Zalo), không rập khuôn toàn bộ menu
                     tham chiếu (các mục như "Lập phiếu xuất..."/"Sửa mẫu..." thuộc phần mềm khác,
                     app này chưa có nghiệp vụ đó). 2026-09-11: thêm icon + "Bỏ ghi" + "Ghi sổ"
                     (command đã có sẵn từ trước, trước đó chỉ chưa lên menu) + wiring KeyBinding
                     thật cho Ctrl+N/Ctrl+E/Ctrl+D/Ctrl+G/Ctrl+B (xem UserControl.InputBindings phía
                     trên) — RIÊNG Ctrl+C (Nhân bản) vẫn chỉ hiển thị chữ, không gán thật, để không
                     đè lên copy-ô mặc định của DataGrid. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="➕ Thêm" InputGestureText="Ctrl+N" Command="{Binding AddSalesOrderCommand}"/>
                        <MenuItem Header="📋 Nhân bản..." InputGestureText="Ctrl+C" Command="{Binding DuplicateSalesOrderCommand}"/>
                        <Separator/>
                        <MenuItem Header="👁 Xem" InputGestureText="Ctrl+E" Command="{Binding EditSalesOrderCommand}"/>
                        <MenuItem Header="🗑️ Xóa" InputGestureText="Ctrl+D" Command="{Binding DeleteSalesOrderCommand}"/>
                        <Separator/>
                        <MenuItem Header="📗 Ghi sổ" InputGestureText="Ctrl+G" Command="{Binding ConfirmSalesOrderCommand}"/>
                        <MenuItem Header="↩️ Bỏ ghi" InputGestureText="Ctrl+B" Command="{Binding UnconfirmSalesOrderCommand}"/>
                        <Separator/>
                        <MenuItem Header="📨 Gửi email, Zalo" InputGestureText="Ctrl+Shift+G">
                            <MenuItem Header="✉️ Email" Command="{Binding SendEmailCommand}"/>
                            <MenuItem Header="💬 Zalo" Command="{Binding SendZaloCommand}"/>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <!-- Trạng thái KHÔNG còn là 1 cột riêng — theo đúng UI MISA (ảnh mẫu: không có cột
                     "Trạng thái", chỉ tô màu chữ cả dòng theo trạng thái). Trước đây dùng
                     DataGrid.CellStyle tô nền vàng nhạt (AppColor.BackgroundWarningLight) cho ô
                     "Trạng thái" của dòng Treo — bug: khi CLICK CHỌN dòng đó, style mặc định của
                     DataGridCell đổi Foreground sang trắng cho trạng thái Selected, nhưng trigger
                     nền vàng ở đây vẫn đè lên nền xanh chọn mặc định → chữ trắng trên nền vàng nhạt
                     gần như vô hình ("click vào không thấy chữ"). Fix: bỏ hẳn nền tô riêng, đổi
                     sang tô FOREGROUND cả dòng qua RowStyle — TextElement.Foreground là thuộc tính
                     kế thừa nên mọi TextBlock con (trừ cột đã tự set Foreground riêng như "Tổng
                     thanh toán") tự động đổi màu theo, không đụng tới nền nên không còn xung đột với
                     màu nền/chữ lúc Selected nữa. -->
                <!-- 2026-09-11: gộp "Nháp" và "Treo" thành 1 label duy nhất "⏸ Treo" (xem
                     SalesOrderListItem.StatusLabel) — trigger "↩️ Bỏ ghi" cũ đã bỏ vì StatusLabel
                     không còn bao giờ trả về giá trị đó nữa. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeld}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <!-- 2026-09-18 (bug user report): dòng Treo lúc SELECTED trùng màu xanh mặc định với
                     dòng bình thường — Foreground/FontWeight ở RowStyle trên KHÔNG áp dụng lúc Selected
                     vì DataGridCell mặc định tự đặt Background/Foreground riêng ngay trong
                     ControlTemplate.Triggers của chính nó khi IsSelected=True (ưu tiên cao hơn mọi
                     Style/Trigger đặt từ ngoài lên cùng property — cùng nguyên nhân và cùng fix đã dùng
                     ở SalesReturnListView.xaml). Fix: thay hẳn Template của cell khi Held+Selected. -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHeld}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{StaticResource AppColor.ButtonPrimaryHover}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextElement.Foreground="{StaticResource AppColor.TextInverted}"
                                                                  TextElement.FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>

                    <!-- 2026-09-14 (theo ảnh mẫu MISA): "Ngày hạch toán" mới — hiển thị thêm cạnh
                         "Ngày chứng từ" (trước đây chỉ có 1 cột "Ngày" = DocumentDate).
                         2026-09-16: thêm ô lọc riêng (AccountingDateFilter) theo yêu cầu — mirror
                         đúng pattern "Ngày chứng từ" ngay bên dưới. -->
                    <DataGridTextColumn Header="Ngày hạch toán"
                                        Binding="{Binding AccountingDate, StringFormat=\{0:dd/MM/yyyy\}}"
                                        Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngày hạch toán" FontWeight="SemiBold"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.AccountingDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                    SelectedDate="{Binding DataContext.AccountingDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FontSize="10" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ngày chứng từ (2026-09-14: đổi tên từ "Ngày" cho khớp ảnh mẫu) — date column:
                         operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Header="Ngày chứng từ"
                                        Binding="{Binding DocumentDate, StringFormat=\{0:dd/MM/yyyy\}}"
                                        Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngày chứng từ" FontWeight="SemiBold"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.DocumentDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                    SelectedDate="{Binding DataContext.DocumentDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FontSize="10" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số chứng từ — text column: plain Contains filter, inline (2026-09-13, mirror
                         SalesReturnListView — trước đây không có ô lọc riêng theo cột nào cả). -->
                    <DataGridTextColumn Header="Số chứng từ" Binding="{Binding DocumentNumber}" Width="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số chứng từ" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDocumentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Khách hàng — text column: plain Contains filter, inline (2026-09-14: chuyển
                         lên trước Diễn giải, khớp thứ tự ảnh mẫu) -->
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="180">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Khách hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterCustomerName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Diễn giải — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Description}" Width="200">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Diễn giải" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDescription, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tổng tiền hàng — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Tổng tiền hàng" Binding="{Binding TotalGross, StringFormat=\{0:N0\}}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tổng tiền hàng" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.TotalGrossFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.TotalGrossFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tiền chiết khấu (2026-09-14: đổi tên từ "Tổng CK" cho khớp ảnh mẫu) — numeric
                         column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Tiền chiết khấu" Binding="{Binding TotalDiscount, StringFormat=\{0:N0\}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tiền chiết khấu" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.TotalDiscountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.TotalDiscountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tiền thuế GTGT — không có ô lọc riêng (giống SalesReturnListView). -->
                    <DataGridTextColumn Header="Tiền thuế GTGT" Binding="{Binding TotalTax, StringFormat=\{0:N0\}}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Tổng tiền thanh toán (2026-09-14: đổi tên từ "Tổng thanh toán" cho khớp ảnh
                         mẫu) — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTemplateColumn Header="Tổng tiền thanh toán" Width="150">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tổng tiền thanh toán" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.TotalPaymentFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.TotalPaymentFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalPayment, StringFormat=\{0:N0\}}" Padding="6,0" VerticalAlignment="Center" TextAlignment="Right"
                                           Foreground="{StaticResource AppColor.TextBrand}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 2026-09-14 (theo ảnh mẫu MISA): "Đã xuất hàng" — nhãn suy ra từ IsConfirmed
                         (xem StockExportedLabel/comment trong SalesOrderListItem), không phải field
                         BE riêng vì app xuất kho ngay lúc Ghi sổ. -->
                    <DataGridTextColumn Header="Đã xuất hàng" Binding="{Binding StockExportedLabel}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- 2026-09-14 (theo ảnh mẫu MISA): "Loại chứng từ" — luôn 1 câu cố định cho mọi
                         chứng từ bán hàng (xem DocumentTypeLabel), không phải field BE riêng. -->
                    <DataGridTextColumn Header="Loại chứng từ" Binding="{Binding DocumentTypeLabel}" Width="260"/>

                    <!-- Nhân viên — text column: plain Contains filter, inline (2026-09-14: không có
                         trong ảnh mẫu nhưng vẫn giữ lại theo yêu cầu — đẩy ra cuối, sau các cột khớp
                         ảnh mẫu) -->
                    <DataGridTextColumn Header="Nhân viên" Binding="{Binding EmployeeName}" Width="140">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Nhân viên" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterEmployeeName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="180"/>

                </DataGrid.Columns>
            </DataGrid>

            <!-- ══════════════════════════════════════════════ -->
            <!--  Totals footer — cộng dồn Tổng tiền hàng/Tổng CK/Tổng thanh toán trên danh sách đã   -->
            <!--  lọc, canh đúng theo bề rộng cột tương ứng ở DataGrid phía trên để đọc như 1 hàng    -->
            <!--  "Tổng cộng" gắn liền cuối lưới thay vì 1 khối tách rời.                             -->
            <!-- ══════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{StaticResource AppColor.BackgroundSecondary}"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1,0,1,1"
                    Visibility="{Binding HasSalesOrders, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- 2026-09-14: cập nhật lại ColumnDefinitions khớp đúng thứ tự/độ rộng cột mới của
                     DataGrid phía trên (thêm "Ngày hạch toán"/"Đã xuất hàng"/"Loại chứng từ", đổi tên
                     "Tổng CK"→"Tiền chiết khấu"/"Tổng thanh toán"→"Tổng tiền thanh toán", chuyển
                     "Nhân viên" ra sau "Loại chứng từ") — nếu không sửa, 4 số tổng cộng bên dưới sẽ
                     lệch cột so với header thật. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>  <!-- Ngày hạch toán -->
                        <ColumnDefinition Width="100"/>  <!-- Ngày chứng từ -->
                        <ColumnDefinition Width="120"/>  <!-- Số chứng từ -->
                        <ColumnDefinition Width="180"/>  <!-- Khách hàng -->
                        <ColumnDefinition Width="*"/>    <!-- Diễn giải -->
                        <ColumnDefinition Width="130"/>  <!-- Tổng tiền hàng -->
                        <ColumnDefinition Width="120"/>  <!-- Tiền chiết khấu -->
                        <ColumnDefinition Width="120"/>  <!-- Tiền thuế GTGT -->
                        <ColumnDefinition Width="150"/>  <!-- Tổng tiền thanh toán -->
                        <ColumnDefinition Width="100"/>  <!-- Đã xuất hàng -->
                        <ColumnDefinition Width="260"/>  <!-- Loại chứng từ -->
                        <ColumnDefinition Width="140"/>  <!-- Nhân viên -->
                        <ColumnDefinition Width="*"/>    <!-- Ghi chú -->
                    </Grid.ColumnDefinitions>

                    <controls:AppLabel Grid.Column="0" Grid.ColumnSpan="5"
                                       Text="{Binding TotalCount, StringFormat='Tổng cộng: {0} chứng từ'}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"
                                       Padding="6,10"/>

                    <TextBlock Grid.Column="5"
                               Text="{Binding TotalGrossSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"/>

                    <TextBlock Grid.Column="6"
                               Text="{Binding TotalDiscountSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"/>

                    <TextBlock Grid.Column="7"
                               Text="{Binding TotalTaxSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"/>

                    <TextBlock Grid.Column="8"
                               Text="{Binding TotalPaymentSum, StringFormat=\{0:N0\}}"
                               FontWeight="Bold"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Padding="6,10"
                               Foreground="{StaticResource AppColor.TextBrand}"/>
                </Grid>
            </Border>

            <!-- Empty state -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasSalesOrders, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="🧾" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chưa có chứng từ bán hàng nào."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
