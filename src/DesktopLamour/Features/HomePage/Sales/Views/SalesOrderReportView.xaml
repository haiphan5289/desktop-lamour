                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="130"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomerGroupColumnVisible}" Value="False">
                                        <Setter Property="Width" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <controls:AppLabel Grid.Column="0" Grid.ColumnSpan="6"
                                   Text="{Binding RowCount, StringFormat='Số dòng = {0}'}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"
                                   Padding="6,10"/>

                <TextBlock Grid.Column="6"
                           Text="{Binding TotalQuantitySold}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="7"
                           Text="{Binding TotalSalesAmount, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="8"
                           Text="{Binding TotalDiscountAmount, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="9"
                           Text="{Binding TotalReturnQuantity}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="10"
                           Text="{Binding TotalReturnValue, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="11"
                           Text="{Binding TotalDiscountValue, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="12"
                           Text="{Binding TotalNetRevenue, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"
                           Foreground="{StaticResource AppColor.TextBrand}"/>

                <TextBlock Grid.Column="16"
                           Text="{Binding TotalCostAmount, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"/>

                <TextBlock Grid.Column="17"
                           Text="{Binding TotalGrossProfit, StringFormat=\{0:N0\}}"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           Padding="6,10"
                           Foreground="{StaticResource AppColor.TextBrand}"/>
            </Grid>
        </Border>

    </Grid>

</UserControl>
