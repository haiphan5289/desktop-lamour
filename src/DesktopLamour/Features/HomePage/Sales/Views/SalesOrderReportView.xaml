<UserControl x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Title + Chọn tham số -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar                                       -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="⚙️ Chọn tham số..."
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ChooseParametersCommand}"
                                    Margin="0,0,16,0"/>
                <controls:AppButton Content="🖨️ In"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding PrintCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✖ Đóng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Title                                         -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0" HorizontalAlignment="Center">
            <controls:AppLabel Text="{Binding ReportTitle}"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               HorizontalAlignment="Center"/>
            <controls:AppLabel Text="{Binding CurrentFilter.Summary}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid                                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,16,24,0">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="ReportGrid"
                      ItemsSource="{Binding RowsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      MouseDoubleClick="ReportGrid_MouseDoubleClick"
                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True"
                                                      Background="{StaticResource AppColor.BackgroundBrand}"
                                                      BorderBrush="{StaticResource AppColor.BorderThin}"
                                                      BorderThickness="0,0,0,1"
                                                      Padding="0">
                                                <Expander.Template>
                                                    <ControlTemplate TargetType="{x:Type Expander}">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <DockPanel>
                                                                <ToggleButton DockPanel.Dock="Top"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                              OverridesDefaultStyle="True"
                                                                              Focusable="False"
                                                                              Cursor="Hand">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                            <DockPanel Background="Transparent">
                                                                                <Border DockPanel.Dock="Left"
                                                                                        Width="20" Height="20"
                                                                                        Margin="6,4,6,4"
                                                                                        BorderBrush="{StaticResource AppColor.TextBrand}"
                                                                                        BorderThickness="1.5"
                                                                                        CornerRadius="3"
                                                                                        Background="{StaticResource AppColor.BackgroundPrimary}">
                                                                                    <TextBlock x:Name="ToggleGlyph"
                                                                                               Text="−"
                                                                                               FontWeight="Bold"
                                                                                               FontSize="13"
                                                                                               Foreground="{StaticResource AppColor.TextBrand}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                                            </DockPanel>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="False">
                                                                                    <Setter TargetName="ToggleGlyph" Property="Text" Value="+"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <ContentPresenter ContentSource="Header"/>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="True">
                                                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Expander.Template>
                                                <Expander.Header>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="125"/>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="125"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="150"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontWeight="Bold"
                                                                   Text="{Binding Items, Converter={StaticResource GroupHeaderTextConverter}}"/>
                                                        <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=Quantity}"/>
                                                        <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=SalesAmount}"/>
                                                        <TextBlock Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=DiscountAmount}"/>
                                                        <TextBlock Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=ReturnQuantity}"/>
                                                        <TextBlock Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=ReturnValue}"/>
                                                        <TextBlock Grid.Column="6" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=DiscountValue}"/>
                                                        <TextBlock Grid.Column="7" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Foreground="{StaticResource AppColor.TextBrand}"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=NetRevenue}"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsPresenter/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>

                    <DataGridTextColumn x:Name="ProductCodeColumn"
                                        Header="Mã hàng"
                                        Binding="{Binding ProductCode}"
                                        Width="95"/>

                    <DataGridTextColumn x:Name="ProductNameColumn"
                                        Header="Tên hàng"
                                        Binding="{Binding ProductName}"
                                        Width="220"/>

                    <DataGridTextColumn x:Name="UnitColumn"
                                        Header="ĐVT"
                                        Binding="{Binding Unit}"
                                        Width="65"/>

                    <DataGridTextColumn Header="Số lượng bán"
                                        Binding="{Binding QuantitySold}"
                                        Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Doanh số bán"
                                        Binding="{Binding SalesAmount, StringFormat=\{0:N0\}}"
                                        Width="125">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Chiết khấu"
                                        Binding="{Binding DiscountAmount, StringFormat=\{0:N0\}}"
                                        Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="SL trả lại"
                                        Binding="{Binding ReturnQuantity}"
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Giá trị trả lại"
                                        Binding="{Binding ReturnValue, StringFormat=\{0:N0\}}"
                                        Width="125">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Giá trị giảm giá"
                                        Binding="{Binding DiscountValue, StringFormat=\{0:N0\}}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Doanh thu thuần"
                                        Binding="{Binding NetRevenue, StringFormat=\{0:N0\}}"
                                        Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                                <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight"          Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="🧾" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Không có dữ liệu khớp bộ lọc."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Footer                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="24,12,24,24"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:AppLabel Grid.Column="0"
                                   Text="{Binding RowCount, StringFormat='Số dòng = {0}'}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:AppLabel Text="Tổng SL bán:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalQuantitySold}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="60"/>

                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <controls:AppLabel Text="Doanh số bán:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalSalesAmount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="100"/>

                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <controls:AppLabel Text="Chiết khấu:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalDiscountAmount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="100"/>

                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <controls:AppLabel Text="Doanh thu thuần:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalNetRevenue, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       FontWeight="Bold"
                                       MinWidth="110"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
