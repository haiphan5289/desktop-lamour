<UserControl x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Title + Chọn tham số -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar                                       -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="⚙️ Chọn tham số..."
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ChooseParametersCommand}"
                                    Margin="0,0,16,0"/>
                <controls:AppButton Content="🖨️ In"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding PrintCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✉️ Gửi Email"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendEmailCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="💬 Zalo"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendZaloCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✖ Đóng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Title                                         -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="24,20,24,0" HorizontalAlignment="Center">
            <controls:AppLabel Text="{Binding ReportTitle}"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               HorizontalAlignment="Center"/>
            <controls:AppLabel Text="{Binding CurrentFilter.DateRangeSummary}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid                                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,16,24,0">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="ReportGrid"
                      ItemsSource="{Binding RowsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="#9CB8D4"
                      HorizontalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      MouseDoubleClick="ReportGrid_MouseDoubleClick"
                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- HorizontalContentAlignment="Stretch" — DataGridColumnHeader tự canh giữa nội
                     dung theo chiều rộng tự nhiên; thiếu Stretch thì StackPanel (nhãn cột + ô lọc)
                     trong HeaderTemplate không kéo giãn hết cột, ô lọc bị co lại giữa cột. -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- 2026-09-18 (theo yêu cầu, khớp ảnh mẫu MISA cây gom nhóm có thể thu gọn): khôi
                     phục lại GroupStyle/Expander glyph "−"/"+" đã từng có (2026-07-18) rồi bị bỏ
                     06/2026-08-31 khi đổi sang "bảng phẳng" (xem comment cũ ở OuterCode/OuterName
                     trong ReportDisplayRow.cs, và ghi chú known-limitation trong docs/sales.md dòng
                     ~1015/1021/1036 — bản Expander gốc CHẠY ĐƯỢC, known limitation chỉ là (a) căn cột
                     header nhóm với cột dữ liệu bên dưới là ước lượng cứng theo width, không tự động
                     100% chính xác, và (b) double-click trúng dòng group-header không kích hoạt
                     drill-down nếu chưa từng chọn dòng nào trước đó — KHÔNG phải lỗi crash/vỡ dữ
                     liệu). GroupDescriptions chỉ thêm khi report 2 chiều (xem RebuildDisplayRows) —
                     report 1 chiều (vd "Mặt hàng" đơn thuần) không có GroupKey nên WPF không tạo
                     group nào, DataGrid hiển thị y hệt bảng phẳng như hiện tại, không ảnh hưởng.
                     OuterCode/OuterName (Mã hàng/Tên hàng khi 2 chiều) giờ ẩn hẳn (xem
                     UpdateColumnVisibility trong code-behind) vì đã hiện trong header nhóm rồi, hiện
                     lại ở cả 2 chỗ sẽ dư thừa — khớp đúng ảnh mẫu (dòng con không lặp lại Mã/Tên hàng). -->
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True"
                                                      Background="{StaticResource AppColor.BackgroundBrand}"
                                                      BorderBrush="{StaticResource AppColor.BorderThin}"
                                                      BorderThickness="0,0,0,1"
                                                      Padding="0">
                                                <Expander.Template>
                                                    <ControlTemplate TargetType="{x:Type Expander}">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <DockPanel>
                                                                <ToggleButton DockPanel.Dock="Top"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                              OverridesDefaultStyle="True"
                                                                              Focusable="False"
                                                                              Cursor="Hand">
                                                                    <ToggleButton.Template>
                                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                                            <DockPanel Background="Transparent">
                                                                                <Border DockPanel.Dock="Left"
                                                                                        Width="20" Height="20"
                                                                                        Margin="6,4,6,4"
                                                                                        BorderBrush="{StaticResource AppColor.TextBrand}"
                                                                                        BorderThickness="1.5"
                                                                                        CornerRadius="3"
                                                                                        Background="{StaticResource AppColor.BackgroundPrimary}">
                                                                                    <TextBlock x:Name="ToggleGlyph"
                                                                                               Text="−"
                                                                                               FontWeight="Bold"
                                                                                               FontSize="13"
                                                                                               Foreground="{StaticResource AppColor.TextBrand}"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ContentPresenter VerticalAlignment="Center"/>
                                                                            </DockPanel>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsChecked" Value="False">
                                                                                    <Setter TargetName="ToggleGlyph" Property="Text" Value="+"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </ToggleButton.Template>
                                                                    <ContentPresenter ContentSource="Header"/>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="ExpanderContent" Visibility="Collapsed"/>
                                                            </DockPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsExpanded" Value="True">
                                                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Expander.Template>
                                                <!-- Widths khớp đúng 10 cột số liệu hiện tại của bảng (Số lượng bán/Doanh số bán/Chiết
                                                     khấu/Số lượng trả lại/Giá trị trả lại/Giá trị giảm giá/Doanh thu thuần/Tiền vốn/Lãi
                                                     gộp/Tỷ lệ lãi gộp) — report "Mặt hàng & khách hàng" (report DUY NHẤT dùng GroupStyle
                                                     này) có IsProfitColumnsVisible=true nên vẫn hiện đủ 3 cột lãi gộp trên từng dòng con,
                                                     header nhóm cũng cần tổng tương ứng cho nhất quán. Sửa cột nào trong DataGrid.Columns
                                                     bên dưới thì PHẢI sửa lại width tương ứng ở đây (known limitation kế thừa từ bản gốc
                                                     2026-07-18: không tự động đồng bộ 100%). -->
                                                <Expander.Header>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="125"/>
                                                            <ColumnDefinition Width="115"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="125"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="150"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="120"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontWeight="Bold" Margin="8,0,0,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupHeaderTextConverter}}"/>
                                                        <TextBlock Grid.Column="1" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=Quantity}"/>
                                                        <TextBlock Grid.Column="2" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=SalesAmount}"/>
                                                        <TextBlock Grid.Column="3" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=DiscountAmount}"/>
                                                        <TextBlock Grid.Column="4" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=ReturnQuantity}"/>
                                                        <TextBlock Grid.Column="5" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=ReturnValue}"/>
                                                        <TextBlock Grid.Column="6" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=DiscountValue}"/>
                                                        <TextBlock Grid.Column="7" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Foreground="{StaticResource AppColor.TextBrand}"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=NetRevenue}"/>
                                                        <TextBlock Grid.Column="8" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=CostAmount}"/>
                                                        <TextBlock Grid.Column="9" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Foreground="{StaticResource AppColor.TextBrand}"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=GrossProfit}"/>
                                                        <TextBlock Grid.Column="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,6,0"
                                                                   Text="{Binding Items, Converter={StaticResource GroupSumConverter}, ConverterParameter=GrossProfitRate}"/>
                                                    </Grid>
                                                </Expander.Header>
                                                <ItemsPresenter/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>

                    <!-- Cột dimension NGOÀI — chỉ hiện ở report 2 chiều (vd. "Nhân viên & khách
                         hàng"), bảng phẳng kiểu MISA: mọi dòng đều có Mã/Tên NV thật, không co
                         gọn theo group header. Ẩn hẳn ở report 1 chiều (UpdateColumnVisibility).
                         Header đổi động qua code-behind (SetColumnHeaders) — TextBlock nhãn dùng
                         {Binding} rỗng để tự phản ánh đúng giá trị Header hiện tại. -->
                    <DataGridTextColumn x:Name="OuterCodeColumn"
                                        Header="Mã NV"
                                        Binding="{Binding OuterCode}"
                                        Width="95">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterOuterCode, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="OuterNameColumn"
                                        Header="Tên NV"
                                        Binding="{Binding OuterName}"
                                        Width="180">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterOuterName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- 2026-09-18: "Tên khách hàng" — dimension GIỮA của report 3 chiều cố định
                         "Nhân viên, khách hàng và mặt hàng" (ảnh mẫu MISA không có cột Mã KH riêng
                         ở đây, chỉ Tên). Ẩn ở mọi report khác qua IsMiddleColumnVisible. -->
                    <DataGridTextColumn x:Name="MiddleNameColumn"
                                        Header="Tên khách hàng"
                                        Binding="{Binding MiddleName}"
                                        Width="180">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tên khách hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterMiddleName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="ProductCodeColumn"
                                        Header="Mã hàng"
                                        Binding="{Binding ProductCode}"
                                        Width="95">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterInnerCode, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="ProductNameColumn"
                                        Header="Tên hàng"
                                        Binding="{Binding ProductName}"
                                        Width="220">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterInnerName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="UnitColumn"
                                        Header="ĐVT"
                                        Binding="{Binding Unit}"
                                        Width="65">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="ĐVT" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterUnit, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="QuantitySoldColumn"
                                        Header="Số lượng bán"
                                        Binding="{Binding QuantitySold}"
                                        Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số lượng bán" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.QuantitySoldFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.QuantitySoldFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Doanh số bán"
                                        Binding="{Binding SalesAmount, StringFormat=\{0:N0\}}"
                                        Width="125">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Doanh số bán" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.SalesAmountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.SalesAmountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Chiết khấu"
                                        Binding="{Binding DiscountAmount, StringFormat=\{0:N0\}}"
                                        Width="115">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Chiết khấu" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.DiscountAmountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.DiscountAmountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="ReturnQuantityColumn"
                                        Header="Số lượng trả lại"
                                        Binding="{Binding ReturnQuantity}"
                                        Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số lượng trả lại" FontWeight="SemiBold" TextAlignment="Right"/>
