<UserControl x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <controls:AppButton Content="← Quay lại"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🏠 Trang chủ"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToHomeCommand}"/>
            </StackPanel>
            <controls:AppLabel Text="Bán hàng"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Quản lý chứng từ bán hàng"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Navigation tiles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,24">

                <controls:AppLabel Text="Nghiệp vụ bán hàng"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,0,0,12"/>
                <WrapPanel>

                    <!-- Chứng từ bán hàng -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSalesOrdersCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Chứng từ bán hàng"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hàng bán bị trả lại -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSalesReturnsCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↩️" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Hàng bán bị trả lại"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
