<Window x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="In hóa đơn bán hàng"
        Width="820"
        Height="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton Content="🖨️ In"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Click="PrintButton_Click"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✖️ Đóng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Invoice preview -->
        <FlowDocumentScrollViewer x:Name="InvoiceViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16"/>
    </Grid>
</Window>
