<Window x:Class="DesktopLamour.Features.HomePage.Sales.Views.SalesOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        xmlns:behaviors="clr-namespace:DesktopLamour.Shared.Behaviors"
        Title="Chứng từ bán hàng - CÔNG TY TNHH THƯƠNG MẠI DỊCH VỤ SPA LAMOUR"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Disable các cột không liên quan cho dòng ảo "Trừ cọc" (IsDepositDeductionRow) -->
        <Style x:Key="DisabledForDepositRow" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDepositDeductionRow}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Khoá cứng dòng "Trừ cọc" đã nạp lại từ chứng từ đã lưu (IsLocked) — khác dòng Trừ cọc
             mới đang gõ (chỉ IsDepositDeductionRow=True, IsLocked=False, vẫn sửa được Mã/Tên/Thành
             tiền). Áp cho đúng 3 cột mà DisabledForDepositRow bỏ qua (Mã hàng/Tên hàng/Thành tiền)
             vì dòng Trừ cọc mới cần sửa được các cột này. -->
        <Style x:Key="DisabledWhenLocked" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="6" IsLoading="{Binding IsBusy}"/>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Header                                                     -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🧾" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <controls:AppLabel Text="Chứng từ bán hàng"
                                           Style="{StaticResource AppTypography.DisplaySection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                        <controls:AppLabel Text="{Binding HeaderSubtitle}"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           Foreground="{StaticResource AppColor.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status badge -->
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="12,6"
                        CornerRadius="20"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusLabel}" Value="⏸ Treo">
                                    <Setter Property="Background" Value="{StaticResource AppColor.BackgroundWarningLight}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderBrand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusLabel}"
                               FontSize="13"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AppColor.TextPrimary}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusLabel}" Value="⏸ Treo">
                                        <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Toolbar                                                    -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                            BorderBrush="{StaticResource AppColor.BorderThin}"
                            BorderThickness="1" CornerRadius="6" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <!-- Ghi sổ/Xóa/Hoàn ẩn hoàn toàn ở chế độ chỉ xem (SalesOrderWindow mở
                                 read-only từ Sổ chi tiết bán hàng) — chỉ giữ In Hoá Đơn/Đóng. -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibilityConverter}}">
                                <controls:AppButton Content="🗑️ Xóa"
                                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                                    Command="{Binding DeleteCommand}"
                                                    Margin="0"/>
                                <Rectangle Width="1" Height="24" Fill="{StaticResource AppColor.BorderThin}" Margin="4,0"/>
                                <controls:AppButton Content="↩️ Hoàn"
                                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                                    Command="{Binding CancelCommand}"
                                                    Margin="0"/>
                                <Rectangle Width="1" Height="24" Fill="{StaticResource AppColor.BorderThin}" Margin="4,0"/>
                            </StackPanel>
                            <controls:AppButton Content="🖨️ In Hoá Đơn"
                                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                                Command="{Binding PrintCommand}"
                                                Margin="0"/>
                            <Rectangle Width="1" Height="24" Fill="{StaticResource AppColor.BorderThin}" Margin="4,0"/>
                            <controls:AppButton Content="✖️ Đóng"
                                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                                Click="CloseButton_Click"
                                                Margin="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Status actions — chỉ hiện khi đơn đã tồn tại VÀ không phải chế độ chỉ xem -->
                    <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                            BorderBrush="{StaticResource AppColor.BorderThin}"
                            BorderThickness="1" CornerRadius="6" Padding="4"
                            Margin="8,0,0,0"
                            Visibility="{Binding ShowHoldSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:AppButton Content="⏸ Treo"
                                                Style="{StaticResource AppButton.Secondary.Medium}"
                                                Command="{Binding HoldCommand}"
                                                Margin="0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Save -->
                <controls:AppButton Grid.Column="1"
                                    Content="💾 Ghi số"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding SaveCommand}"
                                    FontWeight="SemiBold"
                                    MinWidth="120"
                                    Padding="16,8"
                                    Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Form — Thông tin chung + Chứng từ                         -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="16,12,16,0" IsEnabled="{Binding IsEditable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Thông tin chung ── -->
            <Border Grid.Column="0"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Khách hàng — 2 ô cùng hàng: Mã số khách hàng (chọn khách hàng thật, set
                         CustomerId cho công nợ/báo cáo) + Tên Khách hàng (gợi ý theo tên nhưng
                         cho gõ đè tự do, chỉ ảnh hưởng hiển thị/in, không đổi CustomerId). -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Mã số KH"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppSearchableComboBox Grid.Column="1"
                            ItemsSource="{Binding Customers}"
                            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                            Placeholder="Chọn khách hàng"
                            IsNullable="True"
                            AddCommand="{Binding AddCustomerCommand}"/>
                        <controls:AppLabel Grid.Column="3" Text="Tên Khách hàng"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppSuggestTextBox Grid.Column="4"
                            Text="{Binding CustomerNameText, Mode=TwoWay}"
                            Suggestions="{Binding Customers}"
                            Placeholder="Tên khách hàng hiển thị trên hoá đơn"
                            SuggestionPickedCommand="{Binding CustomerNameSuggestionPickedCommand}"/>
                    </Grid>

                    <!-- Địa chỉ — mặc định lấy Customer.Address khi chọn khách hàng, cho sửa tự
                         do (không đổi Customer thật), truyền qua in hoá đơn giống Tên Khách hàng. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Địa chỉ"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding CustomerAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Địa chỉ khách hàng hiển thị trên hoá đơn"/>
                    </Grid>

                    <!-- Diễn giải -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Diễn giải"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Diễn giải chứng từ"/>
                    </Grid>

                    <!-- NV bán hàng -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="NV bán hàng"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppSearchableComboBox Grid.Column="1"
                            ItemsSource="{Binding Employees}"
                            SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                            Placeholder="Chọn nhân viên"
                            IsNullable="True"
                            AddCommand="{Binding AddEmployeeCommand}"/>
                    </Grid>

                    <!-- Tham chiếu — ẩn khỏi UI theo yêu cầu, giữ nguyên Reference/binding ở BE
                         (không xoá dữ liệu, chỉ không hiển thị/sửa được ở popup này nữa). -->
                    <Grid Grid.Row="8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Tham chiếu"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Số tham chiếu"/>
                    </Grid>

                    <!-- Điều khoản thanh toán -->
                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:AppLabel Grid.Column="0" Text="Điều khoản TT"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding PaymentTerms, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Điều khoản"/>

                        <controls:AppLabel Grid.Column="3" Text="Số ngày nợ"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="5"
                            Text="{Binding PaymentDueDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="0"/>

                        <controls:AppLabel Grid.Column="7" Text="Hạn thanh toán"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <DatePicker Grid.Column="9"
                                    SelectedDate="{Binding PaymentDueDate, Mode=TwoWay}"
                                    Height="34" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- ── Right: Chứng từ ── -->
            <Border Grid.Column="2"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <StackPanel>
                    <controls:AppLabel Text="Ngày hạch toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AccountingDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Ngày chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Số chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <controls:AppTextField
                        Text="{Binding DocumentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="{Binding DocumentNumberPlaceholder}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Tab area                                                   -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="3" Margin="16,8,16,0"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    IsEnabled="{Binding IsEditable}">

            <!-- ── Tab 1: Hàng tiền ── -->
            <TabItem Header="1. Hàng tiền">
                <Grid>
                    <DataGrid x:Name="LinesDataGrid"
                              ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                              AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              behaviors:DataGridRowNavigationBehavior.EnableArrowRowNavigation="True"
                              behaviors:DataGridLineContextMenuBehavior.EnableLineContextMenu="True">
                        <DataGrid.Columns>

                            <!-- Mã hàng — product picker (bao gồm cả lựa chọn "Trừ cọc" trộn sẵn trong Products).
                                 Width="Auto" (MinWidth giữ như cũ) để cột tự giãn khi ProductCode hiện text
                                 dài dạng "🔖 Trừ cọc — {số tiền}", tránh bị cắt chữ. -->
                            <DataGridTemplateColumn Header="Mã hàng" Width="Auto" MinWidth="140" CellStyle="{StaticResource DisabledWhenLocked}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductCode}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <controls:AppSearchableComboBox
                                            ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                            Placeholder="Chọn sản phẩm"
                                            IsNullable="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tên hàng — filter by name with dropdown (bao gồm cả lựa chọn "Trừ cọc") -->
                            <DataGridTemplateColumn Header="Tên hàng" Width="*" CellStyle="{StaticResource DisabledWhenLocked}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <controls:AppSearchableComboBox
                                            ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                            Placeholder="Chọn sản phẩm"
                                            IsNullable="True"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Kho — chọn kho xuất hàng cho dòng này -->
                            <DataGridTemplateColumn Header="Kho" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WarehouseName}"
                                                   VerticalAlignment="Center"
                                                   Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Warehouses, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedItem="{Binding SelectedWarehouse, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="DisplayText"
                                                  VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hàng KM — CheckBox đặt thẳng trong CellTemplate (không phải
                                 DataGridCheckBoxColumn) để bấm 1 lần là tick + commit ngay, không
                                 cần cell đã là current cell trước — tránh lỗi kinh điển của
                                 DataGridCheckBoxColumn: click đầu chỉ chọn cell, giá trị không
                                 thật sự đổi ở ViewModel (Thành tiền/Tổng tiền không cập nhật). -->
                            <DataGridTemplateColumn Header="Hàng KM" Width="70" CellStyle="{StaticResource DisabledForDepositRow}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsPromotion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- TK công nợ -->
                            <DataGridTextColumn Header="TK công nợ"
                                                Binding="{Binding ReceivableAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="95"
                                                CellStyle="{StaticResource DisabledForDepositRow}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- TK doanh thu -->
                            <DataGridTextColumn Header="TK doanh thu"
                                                Binding="{Binding RevenueAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100"
                                                CellStyle="{StaticResource DisabledForDepositRow}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ĐVT -->
                            <DataGridTextColumn Header="ĐVT"
                                                Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="60"
                                                CellStyle="{StaticResource DisabledForDepositRow}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Số lượng -->
                            <DataGridTextColumn Header="Số lượng"
                                                Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=0}"
                                                Width="75"
                                                CellStyle="{StaticResource DisabledForDepositRow}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="Padding"             Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Đơn giá -->
                            <DataGridTextColumn Header="Đơn giá"
                                                Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=N0}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="Padding"             Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPromotion}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDepositDeductionRow}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Tỷ lệ CK(%) -->
                            <DataGridTextColumn Header="Tỷ lệ CK(%)"
                                                Binding="{Binding DiscountRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=N2}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="Padding"             Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPromotion}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDepositDeductionRow}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Thành tiền: cho gõ tay để override — dòng tự chuyển sang chế độ thủ công
                                 (BE dùng thẳng giá trị này); sửa lại Đơn giá/SL/CK% sẽ tự tắt chế độ này.
                                 Bind DisplayAmount (không phải Amount thẳng) — dòng Trừ cọc cần luôn hiện
                                 số dương như lúc user gõ, dù Amount lưu âm nội bộ để cộng vào GrandTotal. -->
                            <DataGridTextColumn Header="Thành tiền"
                                                Binding="{Binding DisplayAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=N0}"
                                                Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="Padding"             Value="0,0,6,0"/>
                                        <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
                                        <Setter Property="FontWeight"          Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPromotion}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <!-- Thuế suất — TaxRate đã là số phần trăm nguyên (5/8/10), KHÔNG phải
                                 phân số 0-1, nên ConverterParameter phải giữ đúng "0\%" (dấu \ để
                                 .NET hiểu % là ký tự literal, không nhân giá trị lên 100 lần —
                                 xem System.Decimal.ToString custom format). Phải viết Binding dạng
                                 mở rộng (property-element) thay vì cú pháp rút gọn {Binding ...}
                                 — cú pháp rút gọn parse ConverterParameter theo ngữ pháp
                                 MarkupExtension, nơi dấu \ bị nuốt mất trước khi tới Converter,
                                 khiến "0\%" thành "0%" và TaxRate=8 hiện thành "800%" (bug đã gặp
                                 thực tế). Dạng mở rộng gán ConverterParameter như 1 attribute XML
                                 thường — không có luật escape \ — nên "0\%" giữ nguyên 3 ký tự. -->
                            <DataGridTextColumn Header="Thuế suất"
                                                Width="80"
                                                IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="TaxRate"
                                             Converter="{StaticResource BlankPreserveConverter}"
                                             ConverterParameter="0\%"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="Padding"             Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Tiền thuế -->
                            <DataGridTextColumn Header="Tiền thuế"
                                                Binding="{Binding TaxAmount, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=N0}"
                                                Width="100"
                                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment"   Value="Center"/>
                                        <Setter Property="Padding"             Value="0,0,6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Remove: ẩn nút xoá ở dòng trống (chưa chọn hàng) — không có gì để xoá -->
                            <DataGridTemplateColumn Header="" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource AppButton.RemoveLineIcon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProductCode}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ── Tabs 2–5: stub ── -->
            <TabItem Header="2. Thuế">
                <controls:AppLabel Text="(Không áp dụng)"
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
            </TabItem>

            <TabItem Header="3. Giá vốn">
                <controls:AppLabel Text="(Chưa triển khai)"
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
            </TabItem>

            <TabItem Header="4. Thống kê">
                <controls:AppLabel Text="(Chưa triển khai)"
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
            </TabItem>

            <TabItem Header="5. Khác">
                <controls:AppLabel Text="(Chưa triển khai)"
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
            </TabItem>

            <!-- ── Tab 6: Thông tin bổ sung ── -->
            <TabItem Header="6. Thông tin bổ sung">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ghi Chú -->
                    <controls:AppLabel Grid.Row="0" Grid.Column="0" Text="Ghi Chú"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <controls:AppTextField Grid.Row="0" Grid.Column="1"
                        Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Ghi chú thêm"
                        AcceptsReturn="True"
                        Height="72"
                        TextWrapping="Wrap"
                        VerticalContentAlignment="Top"/>

                    <!-- PT Giao hàng -->
                    <controls:AppLabel Grid.Row="2" Grid.Column="0" Text="PT Giao hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"/>
                    <controls:AppTextField Grid.Row="2" Grid.Column="1"
                        Text="{Binding DeliveryMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Phương thức giao hàng"/>

                    <!-- PT Thanh toán -->
                    <controls:AppLabel Grid.Row="4" Grid.Column="0" Text="PT Thanh toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"/>
                    <controls:AppTextField Grid.Row="4" Grid.Column="1"
                        Text="{Binding PaymentMethod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Phương thức thanh toán"/>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Error banner                                               -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Margin="16,4,16,0"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundErrorLight}"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:AppLabel Text="{Binding ErrorMessage}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"/>
        </Border>

        <!-- ══════════════════════════════════════════════════════════ -->
        <!-- Footer — totals                                            -->
        <!-- ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="5"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:AppLabel Grid.Column="0"
                                   Text="{Binding LineSummary}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tổng tiền hàng -->
                    <controls:AppLabel Text="Tổng tiền hàng:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalAmount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       MinWidth="110"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>

                    <!-- separator -->
                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <!-- Tổng tiền chiết khấu -->
                    <controls:AppLabel Text="Tổng tiền chiết khấu:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalDiscount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       MinWidth="110"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>

                    <!-- separator -->
                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <!-- Tổng tiền thanh toán -->
                    <controls:AppLabel Text="Tổng tiền thanh toán:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalPayment, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       MinWidth="110"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>

                    <!-- separator -->
                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <!-- Tổng tiền thuế -->
                    <controls:AppLabel Text="Tổng tiền thuế:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding TotalTaxAmount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       MinWidth="110"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>

                    <!-- separator -->
                    <controls:AppLabel Text="|"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.BorderThin}"
                                       Margin="16,0"/>

                    <!-- Tổng thanh toán (gồm thuế) -->
                    <controls:AppLabel Text="Tổng thanh toán (gồm thuế):"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,8,0"/>
                    <controls:AppLabel Text="{Binding GrandTotal, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       MinWidth="110"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
