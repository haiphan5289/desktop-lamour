<Window x:Class="DesktopLamour.Features.HomePage.ProductList.Views.ProductFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="{Binding WindowTitle}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Decorative header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Form content -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Action buttons -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 0: Decorative header strip                -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📦"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="{Binding WindowTitle}"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Thông tin sản phẩm"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 1: Form content                           -->
        <!-- ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="620">
        <StackPanel Margin="24,16,24,8">

                        <!-- Mã sản phẩm (optional, unique) -->
                        <StackPanel Margin="0,0,0,16">
                            <controls:AppLabel Text="Mã sản phẩm"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,0,0,6"/>
                            <controls:AppTextField Text="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Placeholder="VD: SP001"
                                                   IsEnabled="{Binding IsAddMode}"/>
                        </StackPanel>

                        <!-- Tên sản phẩm (required) -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <controls:AppLabel Text="Tên sản phẩm"
                                                   Style="{StaticResource AppTypography.LabelSection}"/>
                                <controls:AppLabel Text=" *"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Foreground="{StaticResource AppColor.TextBrand}"/>
                            </StackPanel>
                            <controls:AppTextField Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   Placeholder="VD: Son môi đỏ Ruby"/>
                        </StackPanel>

                        <!-- Two-column row: Danh mục + Đơn vị -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <controls:AppLabel Text="Danh mục"
                                                       Style="{StaticResource AppTypography.LabelSection}"/>
                                    <controls:AppLabel Text=" *"
                                                       Style="{StaticResource AppTypography.LabelSection}"
                                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                                </StackPanel>
                                <controls:AppTextField Text="{Binding Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: Son môi"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <controls:AppLabel Text="Đơn vị"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Margin="0,0,0,6"/>
                                <controls:AppTextField Text="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: Cái"/>
                            </StackPanel>
                        </Grid>

                        <!-- Two-column row: Giá nhập + Giá bán -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <controls:AppLabel Text="Giá nhập (VNĐ)"
                                                       Style="{StaticResource AppTypography.LabelSection}"/>
                                    <controls:AppLabel Text=" *"
                                                       Style="{StaticResource AppTypography.LabelSection}"
                                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                                </StackPanel>
                                <controls:AppTextField Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: 50000"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <controls:AppLabel Text="Giá bán (VNĐ)"
                                                       Style="{StaticResource AppTypography.LabelSection}"/>
                                    <controls:AppLabel Text=" *"
                                                       Style="{StaticResource AppTypography.LabelSection}"
                                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                                </StackPanel>
                                <controls:AppTextField Text="{Binding SellingPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: 80000"/>
                            </StackPanel>
                        </Grid>

                        <!-- Two-column row: Tồn kho + Hoạt động -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <controls:AppLabel Text="Tồn kho"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Margin="0,0,0,6"/>
                                <controls:AppTextField Text="{Binding StockQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: 100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                    <controls:AppLabel Text="Còn kinh doanh"
                                                       Style="{StaticResource AppTypography.BodySection}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ── Separator: Thông tin thuế ── -->
                        <Border BorderBrush="{StaticResource AppColor.BorderThin}"
                                BorderThickness="0,1,0,0"
                                Margin="0,4,0,16"/>

                        <!-- Two-column row: Thuế suất GTGT + Có giảm thuế -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thuế suất GTGT (%) -->
                            <StackPanel Grid.Column="0">
                                <controls:AppLabel Text="Thuế suất GTGT (%)"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding VatRateOptions}"
                                          SelectedItem="{Binding VatRate, Mode=TwoWay}"
                                          Height="36">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource VatRateDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Có giảm thuế -->
                            <StackPanel Grid.Column="2">
                                <controls:AppLabel Text="Có giảm thuế"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding TaxReductionStatusOptions}"
                                          SelectedItem="{Binding TaxReductionType, Mode=TwoWay}"
                                          Height="36">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource TaxReductionStatusDisplayConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Two-column row: Thuế suất NK + Thuế suất XK -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thuế suất NK (%) -->
                            <StackPanel Grid.Column="0">
                                <controls:AppLabel Text="Thuế suất NK (%)"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Margin="0,0,0,6"/>
                                <controls:AppTextField Text="{Binding ImportTaxRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: 5"/>
                            </StackPanel>

                            <!-- Thuế suất XK (%) -->
                            <StackPanel Grid.Column="2">
                                <controls:AppLabel Text="Thuế suất XK (%)"
                                                   Style="{StaticResource AppTypography.LabelSection}"
                                                   Margin="0,0,0,6"/>
                                <controls:AppTextField Text="{Binding ExportTaxRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       Placeholder="VD: 0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Nhóm HHDV chịu thuế TTĐB -->
                        <StackPanel Margin="0,0,0,16">
                            <controls:AppLabel Text="Nhóm HHDV chịu thuế TTĐB"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ExciseTaxGroupOptions}"
                                      SelectedItem="{Binding ExciseTaxGroup, Mode=TwoWay}"
                                      IsEditable="True"
                                      Height="36"/>
                        </StackPanel>

            <!-- Error message -->
            <Border Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding ErrorMessage}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 2: Action buttons                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton Content="Hủy"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,12,0"/>
                <controls:AppButton Content="💾 Lưu"
                                    Style="{StaticResource AppButton.Primary.Large}"
                                    Command="{Binding SaveCommand}"
                                    Width="140"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
