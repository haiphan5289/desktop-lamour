<UserControl x:Class="DesktopLamour.Features.HomePage.ProductList.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DesktopLamour.Shared.Behaviors"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <!-- HorizontalContentAlignment="Stretch" — thiếu thì StackPanel (nhãn cột + ô lọc) trong
             HeaderTemplate không kéo giãn hết cột, ô lọc bị co lại giữa cột. Cùng cách
             CustomerListView đang dùng cho lưới có filter theo cột. -->
        <Style x:Key="StretchHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Page header -->
            <RowDefinition Height="Auto"/>   <!-- Section 1: Toolbar -->
            <RowDefinition Height="*"/>      <!-- Section 2: DataGrid -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="Vật tư hàng hóa"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Section 1: Toolbar actions                    -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
            <StackPanel Orientation="Horizontal">

                <controls:AppButton Content="➕ Thêm"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding AddProductCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="📋 Nhân bản"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding DuplicateProductCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="✏️ Sửa"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding EditProductCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="🗑️ Xóa"
                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                    Command="{Binding DeleteProductCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="🔄 Nạp"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding LoadProductsCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="🏷️ Danh mục"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToCategoriesCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="📥 Nhập khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ImportExcelCommand}"
                                    Margin="0,0,8,0"/>

                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"/>

            </StackPanel>

            <!-- Bộ lọc "Nhóm vật tư, hàng hóa, dịch vụ" (khớp MISA). Ô tìm kiếm chung đã bỏ (2026-10-10) — dùng ô lọc riêng ở tiêu đề từng cột. -->
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <controls:AppLabel Text="Nhóm vật tư, hàng hóa, dịch vụ:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategoryOption, Mode=TwoWay}"
                          Width="240" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Margin="0"/>
            </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Section 2: Product DataGrid                   -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Error banner -->
            <Border Grid.Row="0"
                    Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- DataGrid — cột khớp màn "Vật tư hàng hóa" của MISA; mỗi cột có ô lọc riêng nhúng
                 trong header, AND với nhau và với dropdown Nhóm VTHH + ô Tìm kiếm chung. -->
            <DataGrid behaviors:DataGridRowDoubleClickBehavior.Command="{Binding EditProductCommand}"
                      Grid.Row="0"
                      ItemsSource="{Binding ProductsView}"
                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      ColumnHeaderStyle="{StaticResource StretchHeaderStyle}"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasProducts, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="110">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Mã" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterCode, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="260">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tên" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tính chất" Binding="{Binding Nature, Converter={StaticResource ProductNatureDisplayConverter}}" Width="140">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tính chất" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterNature, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Nhóm VTHH" Binding="{Binding CategoryName}" Width="130">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Nhóm VTHH" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterCategory, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="ĐVT chính" Binding="{Binding Unit}" Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="ĐVT chính" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterUnit, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số lượng tồn" Binding="{Binding StockQuantity, Converter={StaticResource MoneyConverter}}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số lượng tồn" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.StockQuantityFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.StockQuantityFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Giá trị tồn" Binding="{Binding StockValue, Mode=OneWay, Converter={StaticResource MoneyConverter}}" Width="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Giá trị tồn" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.StockValueFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.StockValueFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Giảm thuế theo QĐ" Binding="{Binding TaxReductionType, Converter={StaticResource TaxReductionStatusDisplayConverter}}" Width="160">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Giảm thuế theo QĐ" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterTaxReduction, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <!-- Ngừng theo dõi = đảo của IsActive. Mode=OneWay bắt buộc: IsStopTracking chỉ có getter,
                         binding TwoWay mặc định của DataGridCheckBoxColumn sẽ ném lỗi lúc runtime. Ô lọc là
                         checkbox 3 trạng thái: ▪ = tất cả, ✓ = chỉ dòng ngừng theo dõi, trống = chỉ dòng đang theo dõi. -->
                    <DataGridCheckBoxColumn Header="Ngừng theo dõi" Binding="{Binding IsStopTracking, Mode=OneWay}" Width="120" IsReadOnly="True">
                        <DataGridCheckBoxColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngừng theo dõi" FontWeight="SemiBold" TextAlignment="Center"/>
                                    <CheckBox IsThreeState="True"
                                              IsChecked="{Binding DataContext.FilterStopTracking, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                              HorizontalAlignment="Center" Height="22" VerticalContentAlignment="Center" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridCheckBoxColumn.HeaderTemplate>
                    </DataGridCheckBoxColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasProducts, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chưa có sản phẩm nào."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Footer — "Số dòng = N" + tổng Số lượng tồn / Giá trị tồn (khớp dòng tổng lưới MISA),
                 tính trên các dòng đang hiển thị sau lọc. -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="4,8,0,0"
                        Visibility="{Binding HasProducts, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding RowCountText}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"/>
                <controls:AppLabel Text="Tổng số lượng tồn:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="32,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalStockQuantityText}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   FontWeight="SemiBold"/>
                <controls:AppLabel Text="Tổng giá trị tồn:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="32,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalStockValueText}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   FontWeight="SemiBold"/>
            </StackPanel>

        </Grid>

    </Grid>

</UserControl>
