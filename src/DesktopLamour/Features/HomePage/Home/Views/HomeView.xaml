<UserControl x:Class="DesktopLamour.Features.HomePage.Home.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Nav items -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Header                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppLabel Text="Tổng quan"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Chọn mục để bắt đầu quản lý"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Navigation items                              -->
        <!-- ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,24">

                <!-- ── Section: Quản lý ──────────────── -->
                <controls:AppLabel Text="Quản lý"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,0,0,12"/>
                <WrapPanel Margin="0,0,0,24">

                    <!-- Khách hàng -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToCustomersCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Khách hàng"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nhân viên -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToEmployeesCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Nhân viên"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- ── Section: Kho & Hàng hóa ───────── -->
                <controls:AppLabel Text="Kho &amp; Hàng hóa"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,0,0,12"/>
                <WrapPanel>

                    <!-- Sản phẩm -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToProductsCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Sản phẩm"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Nhà cung cấp -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToSuppliersCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🏪" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Nhà cung cấp"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
