<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.WarehouseTransactionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <!-- Header nhấn nhá cùng tông với TongHopTonKhoView để đồng bộ trong module Kho -->
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#BDD7EE"/>

        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="{StaticResource GridHeaderBrush}"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Padding"      Value="8,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush"  Value="#9CB8D4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Căn giữa theo chiều dọc cho mọi ô — mặc định TextBlock trong DataGridCell dồn lên top khi RowHeight > chiều cao chữ -->
        <Style x:Key="VerticalCenterCellStyle" TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Toolbar filters: text căn giữa trong ô thay vì dồn trái, viền bo tròn nhẹ đồng bộ AppButton -->
        <Style x:Key="ToolbarDatePicker" TargetType="DatePicker">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AppColor.BorderRegular}"/>
            <Setter Property="Padding"         Value="4,0"/>
        </Style>

        <Style x:Key="ToolbarComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolbarComboBox" TargetType="ComboBox">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="BorderBrush"      Value="{StaticResource AppColor.BorderRegular}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ToolbarComboBoxItem}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <controls:AppButton Content="← Quay lại"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🏠 Trang chủ"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToHomeCommand}"/>
            </StackPanel>
            <controls:AppLabel Text="📦 Nhập, Xuất Kho"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Danh sách giao dịch nhập kho và xuất kho bán hàng"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar — filters                             -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="📥 Phiếu Nhập"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding OpenFormCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📤 Phiếu Xuất"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding OpenSalesOrderCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📊 Tổng hợp tồn kho"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToTongHopTonKhoCommand}"
                                    Margin="0,0,16,0"/>

                <Border Width="1" Height="24"
                        Background="{StaticResource AppColor.BorderThin}"
                        Margin="0,0,16,0"/>

                <controls:AppLabel Text="Từ" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            Language="vi-VN"
                            Style="{StaticResource ToolbarDatePicker}"
                            Width="130" Height="34" Margin="0,0,16,0"/>

                <controls:AppLabel Text="Đến" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            Language="vi-VN"
                            Style="{StaticResource ToolbarDatePicker}"
                            Width="130" Height="34" Margin="0,0,16,0"/>

                <controls:AppLabel Text="Loại" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox SelectedIndex="{Binding SelectedTypeIndex, Mode=TwoWay}"
                          Style="{StaticResource ToolbarComboBox}"
                          Width="140" Height="34" Margin="0,0,16,0">
                    <ComboBoxItem Content="Tất cả"/>
                    <ComboBoxItem Content="Nhập kho"/>
                    <ComboBoxItem Content="Xuất kho"/>
                </ComboBox>

                <controls:AppButton Content="Lấy dữ liệu"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Master + Detail                                -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="24,12,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <!-- Error banner -->
            <Border Grid.Row="0" Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <!-- Master grid: 1 dòng = 1 chứng từ (Nhập kho hoặc Xuất kho bán hàng) -->
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource AppColor.BorderThin}"
                      RowHeight="32"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      CellStyle="{StaticResource VerticalCenterCellStyle}"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày hạch toán"
                                        Binding="{Binding AccountingDate, StringFormat=dd/MM/yyyy}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Ngày chứng từ"
                                        Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Số chứng từ"
                                        Binding="{Binding DocumentNumber}"
                                        Width="110"/>
                    <DataGridTextColumn Header="Diễn giải"
                                        Binding="{Binding Description}"
                                        Width="*"/>
                    <DataGridTextColumn Header="Tổng tiền"
                                        Binding="{Binding TotalAmount, StringFormat=\{0:N0\}}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Người giao/Người nhận"
                                        Binding="{Binding DeliveryOrReceiver}"
                                        Width="150"/>
                    <DataGridTextColumn Header="Đối tượng"
                                        Binding="{Binding ObjectName}"
                                        Width="160"/>
                    <DataGridTemplateColumn Header="Đã lập CT bán hàng" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" Margin="4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSalesOrder}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSalesOrder}" Value="True">
                                                        <Setter Property="Text" Value="✓ Đã lập"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Ngày ghi sổ kho"
                                        Binding="{Binding LedgerDate, StringFormat=dd/MM/yyyy}"
                                        Width="110"/>
                    <DataGridTemplateColumn Header="Loại chứng từ" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFF8E1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocumentTypeLabel}" Value="Xuất kho bán hàng">
                                                    <Setter Property="Background" Value="#E3F2FD"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DocumentTypeLabel}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocumentTypeLabel}" Value="Xuất kho bán hàng">
                                                        <Setter Property="Foreground" Value="#1976D2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chưa có giao dịch nhập/xuất kho nào trong khoảng thời gian này."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Section label: Chi tiết -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="14" Background="{StaticResource AppColor.BackgroundBrand}"
                        CornerRadius="2" Margin="0,0,8,0"/>
                <controls:AppLabel Text="Chi tiết"
                                   Style="{StaticResource AppTypography.LabelSection}"/>
            </StackPanel>

            <!-- Detail grid: dòng hàng của chứng từ đang chọn -->
            <DataGrid Grid.Row="4"
                      ItemsSource="{Binding SelectedItem.Lines}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      VerticalGridLinesBrush="{StaticResource AppColor.BorderThin}"
                      HorizontalGridLinesBrush="{StaticResource AppColor.BorderThin}"
                      RowHeight="28"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      CellStyle="{StaticResource VerticalCenterCellStyle}"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}">

                <DataGrid.Resources>
                    <!-- Cột không có dữ liệu theo dõi (Mã quy cách/Số lô/Hạn sử dụng/Số khế ước) — tô
                         nền xám để phân biệt với cột có dữ liệu thật, khớp cách MISA tô các cột
                         "khóa"/không áp dụng trong ảnh tham chiếu. -->
                    <Style x:Key="UntrackedColumnCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource VerticalCenterCellStyle}">
                        <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã hàng"     Binding="{Binding ProductCode}"   Width="90"/>
                    <DataGridTextColumn Header="Tên hàng"    Binding="{Binding ProductName}"   Width="180"/>
                    <DataGridTextColumn Header="Kho"         Binding="{Binding WarehouseName}" Width="100"/>
                    <DataGridTextColumn Header="TK Nợ"       Binding="{Binding DebitAccount}"  Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TK Có"       Binding="{Binding CreditAccount}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Mã quy cách/Số lô/Hạn sử dụng/Số khế ước: hệ thống chưa theo dõi lô/hạn sử dụng — cột luôn trống, tô xám -->
                    <DataGridTextColumn Header="Mã quy cách" Width="90"  IsReadOnly="True" CellStyle="{StaticResource UntrackedColumnCellStyle}"/>
                    <DataGridTextColumn Header="ĐVT"         Binding="{Binding Unit}"          Width="70"/>
                    <DataGridTextColumn Header="Số lượng"    Binding="{Binding Quantity, StringFormat=N0}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Đơn giá"     Binding="{Binding UnitPrice, StringFormat=N0}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Thành tiền"  Binding="{Binding Amount, StringFormat=N0}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Số lô"         Width="80"  IsReadOnly="True" CellStyle="{StaticResource UntrackedColumnCellStyle}"/>
                    <DataGridTextColumn Header="Hạn sử dụng"   Width="100" IsReadOnly="True" CellStyle="{StaticResource UntrackedColumnCellStyle}"/>
                    <DataGridTextColumn Header="Số khế ước"    Width="90"  IsReadOnly="True" CellStyle="{StaticResource UntrackedColumnCellStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>

</UserControl>
