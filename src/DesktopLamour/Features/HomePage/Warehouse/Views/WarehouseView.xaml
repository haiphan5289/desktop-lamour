<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <controls:AppButton Content="← Quay lại"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🏠 Trang chủ"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToHomeCommand}"/>
            </StackPanel>
            <controls:AppLabel Text="Kho"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Quản lý kho hàng hóa"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Navigation tiles                              -->
        <!-- ══════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,24">

                <controls:AppLabel Text="Nghiệp vụ kho"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,0,0,12"/>
                <WrapPanel>

                    <!-- Tổng hợp tồn kho -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToTongHopTonKhoCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Tổng hợp tồn kho"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Phiếu Nhập Kho -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToPhieuNhapKhoCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📥" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Phiếu Nhập Kho"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Phiếu Xuất Kho (placeholder) -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Opacity="0.4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📤" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Phiếu Xuất Kho"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <controls:AppLabel Text="Cài đặt"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,8,0,12"/>
                <WrapPanel>

                    <!-- Đơn vị tính -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToProductUnitsCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📏" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Đơn vị tính"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Tài khoản kế toán -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToAccountSettingsCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📒" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Tài khoản kế toán"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách Kho -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToWarehousesCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🏬" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Danh sách Kho"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Phòng ban -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToDepartmentsCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Phòng ban"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Khoản mục chi phí -->
                    <Border Width="176" Height="160"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppRadius.Large}"
                            Margin="0,0,16,16"
                            Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AppColor.TextSecondary}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateToExpenseCategoriesCommand}"/>
                        </Border.InputBindings>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="💰" FontSize="40" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <controls:AppLabel Text="Khoản mục chi phí"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,12,0,0"
                                               HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
