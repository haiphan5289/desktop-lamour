<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.InventoryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <Style x:Key="CellNumber" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>
        <Style x:Key="LinkCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
            <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClickable}" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3" IsLoading="{Binding IsLoading}"/>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="SỔ CHI TIẾT VẬT TƯ HÀNG HÓA"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               HorizontalAlignment="Center"/>
            <controls:AppLabel Text="{Binding Title}"
                               Style="{StaticResource AppTypography.BodySection}"
                               Foreground="{StaticResource AppColor.TextBrand}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
            <controls:AppLabel Text="{Binding FilterSummary}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Số dư đầu kỳ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Số dư đầu kỳ:" Style="{StaticResource AppTypography.BodyLabel}" Margin="0,0,8,0"/>
                <controls:AppLabel Text="{Binding OpeningQty, StringFormat=\{0:N0\}}" Style="{StaticResource AppTypography.BodyLabel}" Margin="0,0,4,0"/>
                <controls:AppLabel Text="(" Style="{StaticResource AppTypography.BodyCaption}"/>
                <controls:AppLabel Text="{Binding OpeningValue, StringFormat=\{0:N0\}}" Style="{StaticResource AppTypography.BodyCaption}"/>
                <controls:AppLabel Text=")" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,24,0"/>

                <controls:AppLabel Text="Tồn cuối kỳ:" Style="{StaticResource AppTypography.BodyLabel}" Margin="0,0,8,0"/>
                <controls:AppLabel Text="{Binding ClosingQty, StringFormat=\{0:N0\}}" Style="{StaticResource AppTypography.BodyLabel}" Margin="0,0,4,0"/>
                <controls:AppLabel Text="(" Style="{StaticResource AppTypography.BodyCaption}"/>
                <controls:AppLabel Text="{Binding ClosingValue, StringFormat=\{0:N0\}}" Style="{StaticResource AppTypography.BodyCaption}"/>
                <controls:AppLabel Text=")" Style="{StaticResource AppTypography.BodyCaption}"/>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="2" Margin="24,12,24,24">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <DataGrid x:Name="LinesDataGrid"
                      ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      MouseDoubleClick="LinesDataGrid_MouseDoubleClick"
                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ngày hạch toán" Binding="{Binding AccountingDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Ngày chứng từ"  Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}"   Width="110"/>
                    <DataGridTextColumn Header="Số chứng từ"    Binding="{Binding DocumentNumber}" Width="110" ElementStyle="{StaticResource LinkCell}"/>
                    <DataGridTextColumn Header="Diễn giải"      Binding="{Binding Description}"    Width="*"/>
                    <DataGridTextColumn Header="ĐVT"            Binding="{Binding Unit}"            Width="60"/>

                    <DataGridTextColumn Header="SL Nhập"    Binding="{Binding ImportQty, StringFormat=\{0:N0\}}"    Width="80" ElementStyle="{StaticResource CellNumber}"/>
                    <DataGridTextColumn Header="Giá trị Nhập" Binding="{Binding ImportValue, StringFormat=\{0:N0\}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                    <DataGridTextColumn Header="SL Xuất"    Binding="{Binding ExportQty, StringFormat=\{0:N0\}}"    Width="80" ElementStyle="{StaticResource CellNumber}"/>
                    <DataGridTextColumn Header="Giá trị Xuất" Binding="{Binding ExportValue, StringFormat=\{0:N0\}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                    <DataGridTextColumn Header="SL Tồn"     Binding="{Binding RunningQty, StringFormat=\{0:N0\}}"    Width="80" ElementStyle="{StaticResource CellNumber}"/>
                    <DataGridTextColumn Header="Giá trị Tồn"  Binding="{Binding RunningValue, StringFormat=\{0:N0\}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <controls:AppLabel Text="Không có giao dịch nào trong khoảng ngày đã chọn."
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
