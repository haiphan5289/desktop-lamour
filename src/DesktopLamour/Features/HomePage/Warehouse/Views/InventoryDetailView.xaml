<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.InventoryDetailView"
             xmlns:helpers="clr-namespace:DesktopLamour.Shared.Helpers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>
        <Style x:Key="LinkCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
            <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsClickable}" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Dòng nhóm kho / nhóm mặt hàng / số dư đầu kỳ — đậm, nền nhạt (khớp sổ chi tiết MISA). -->
        <Style x:Key="LedgerRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowKind}" Value="WarehouseHeader">
                    <Setter Property="Background" Value="{StaticResource AppColor.BackgroundBrand}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowKind}" Value="ProductHeader">
                    <Setter Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RowKind}" Value="Opening">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3" IsLoading="{Binding IsLoading}"/>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="SỔ CHI TIẾT VẬT TƯ HÀNG HÓA"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               HorizontalAlignment="Center"/>
            <controls:AppLabel Text="{Binding Title}"
                               Style="{StaticResource AppTypography.BodySection}"
                               Foreground="{StaticResource AppColor.TextBrand}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
            <controls:AppLabel Text="{Binding FilterSummary}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <Grid Grid.Row="2" Margin="24,12,24,24">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <DataGrid x:Name="LinesDataGrid"
                      ItemsSource="{Binding Lines}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      ColumnHeaderHeight="56"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      RowStyle="{StaticResource LedgerRowStyle}"
                      MouseDoubleClick="LinesDataGrid_MouseDoubleClick"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- DataGridColumnHeader centers its content by default — without this, the filter
                     row (StackPanel/Grid + AppTextField/ComboBox, all set to Stretch) still just
                     sizes to its natural width and sits centered instead of filling the column. -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <!-- Tên kho — cột nhóm: dòng nhóm hiện "Mã kho : HH (1)", dòng thường hiện tên kho -->
                    <DataGridTextColumn Header="Tên kho" Binding="{Binding WarehouseName}" Width="140">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Tên kho" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterWarehouse, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tên hàng — chỉ hiện (sổ chi tiết của đúng 1 mặt hàng, không cần ô lọc) -->
                    <DataGridTextColumn Header="Tên hàng" Binding="{Binding ProductName}" Width="150">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Tên hàng" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ngày hạch toán — date column: operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Header="Ngày hạch toán" Binding="{Binding AccountingDateText}" Width="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngày hạch toán" FontWeight="SemiBold"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.AccountingDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                    SelectedDate="{Binding DataContext.AccountingDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FontSize="10" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ngày chứng từ — date column: operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Header="Ngày chứng từ" Binding="{Binding DocumentDateText}" Width="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngày chứng từ" FontWeight="SemiBold"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.DocumentDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                    SelectedDate="{Binding DataContext.DocumentDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FontSize="10" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số chứng từ — CLICKABLE LINK column (ElementStyle="LinkCell" + MouseDoubleClick
                         handler in code-behind opens the source document). Only the header gains a
                         plain Contains filter here — the cell template/click behavior is untouched. -->
                    <DataGridTextColumn Header="Số chứng từ" Binding="{Binding DocumentNumber}" Width="120" ElementStyle="{StaticResource LinkCell}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số chứng từ" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDocumentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Diễn giải — text column: plain Contains filter, inline -->
                    <!-- Fixed width (not "*") — mixing a star column with HorizontalScrollBarVisibility="Auto"
                         is a known WPF DataGrid quirk that clips trailing columns instead of scrolling to them. -->
                    <DataGridTextColumn Header="Diễn giải" Binding="{Binding Description}" Width="250">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Diễn giải" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDescription, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ĐVT — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="70">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="ĐVT" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterUnit, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Đơn giá — chỉ hiện (giá của chính dòng giao dịch) -->
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, Converter={StaticResource MoneyConverter}}" Width="100" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="Đơn giá" FontWeight="SemiBold" TextAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- SL Nhập — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="SL Nhập" Binding="{Binding ImportQty, Converter={StaticResource MoneyConverter}}" Width="90" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="SL Nhập" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.ImportQtyFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.ImportQtyFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Giá trị Nhập — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Giá trị Nhập" Binding="{Binding ImportValue, Converter={StaticResource MoneyConverter}}" Width="120" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Giá trị Nhập" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.ImportValueFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.ImportValueFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- SL Xuất — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="SL Xuất" Binding="{Binding ExportQty, Converter={StaticResource MoneyConverter}}" Width="90" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="SL Xuất" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.ExportQtyFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.ExportQtyFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Giá trị Xuất — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Giá trị Xuất" Binding="{Binding ExportValue, Converter={StaticResource MoneyConverter}}" Width="120" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Giá trị Xuất" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.ExportValueFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.ExportValueFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- SL Tồn — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="SL Tồn" Binding="{Binding RunningQty, Converter={StaticResource MoneyConverter}}" Width="90" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="SL Tồn" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.RunningQtyFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.RunningQtyFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Giá trị Tồn — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Giá trị Tồn" Binding="{Binding RunningValue, Converter={StaticResource MoneyConverter}}" Width="120" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Giá trị Tồn" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.RunningValueFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.RunningValueFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <controls:AppLabel Text="Không có giao dịch nào trong khoảng ngày đã chọn."
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasLines, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
