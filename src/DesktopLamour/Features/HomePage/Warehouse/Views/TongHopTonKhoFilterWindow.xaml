<Window x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.TongHopTonKhoFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="Tổng hợp tồn kho"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="640"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid Background="{StaticResource AppColor.BackgroundSecondary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:AppLoadingOverlay Grid.RowSpan="3" IsLoading="{Binding IsLoading}"/>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="24,20">
            <controls:AppLabel Text="Tổng hợp tồn kho"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               Foreground="{StaticResource AppColor.TextBrand}"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="24,20,24,8">

            <!-- Card: Tham số -->
            <Border Background="{StaticResource AppColor.BackgroundPrimary}"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppRadius.Large}"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel>
                    <controls:AppLabel Text="Tham số"
                                       Style="{StaticResource AppTypography.HeaderSection}"
                                       Margin="0,0,0,16"/>

                    <!-- Kỳ báo cáo -->
                    <StackPanel Margin="0,0,0,16">
                        <controls:AppLabel Text="Kỳ báo cáo" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding PeriodPresetOptions}"
                                  SelectedItem="{Binding PeriodPreset, Mode=TwoWay}"
                                  Height="36"/>
                    </StackPanel>

                    <!-- Từ ngày / Đến ngày -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <controls:AppLabel Text="Từ ngày" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <controls:AppLabel Text="Đến ngày" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Đơn vị tính / Nhóm VTHH -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <controls:AppLabel Text="Đơn vị tính" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,0,6"/>
                            <controls:AppSearchableComboBox
                                ItemsSource="{Binding ProductUnits}"
                                SelectedItem="{Binding SelectedProductUnit, Mode=TwoWay}"
                                Placeholder="Tất cả đơn vị tính"
                                IsNullable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <controls:AppLabel Text="Nhóm VTHH" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,0,6"/>
                            <controls:AppSearchableComboBox
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                Placeholder="Tất cả nhóm VTHH"
                                IsNullable="True"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card: Kho -->
            <Border Background="{StaticResource AppColor.BackgroundPrimary}"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource AppRadius.Large}"
                    Padding="20">
                <StackPanel>
                    <controls:AppLabel Text="Kho — bỏ chọn tất cả = tất cả kho"
                                       Style="{StaticResource AppTypography.HeaderSection}"
                                       Margin="0,0,0,16"/>

                    <DataGrid ItemsSource="{Binding WarehouseItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MaxHeight="240"
                              BorderBrush="{StaticResource AppColor.BorderThin}"
                              BorderThickness="1"
                              RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                              AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay}" Width="40"/>
                            <DataGridTextColumn Header="Mã kho" Binding="{Binding Code}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tên kho" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <Grid>
                <controls:AppButton Content="Xóa điều kiện"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding ClearConditionsCommand}"
                                    HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:AppButton Content="Hủy bỏ"
                                        Style="{StaticResource AppButton.Tertiary.Medium}"
                                        Command="{Binding CancelCommand}"
                                        Margin="0,0,12,0"/>
                    <controls:AppButton Content="✅ Đồng ý"
                                        Style="{StaticResource AppButton.Primary.Medium}"
                                        Command="{Binding ApplyCommand}"
                                        Width="120"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
