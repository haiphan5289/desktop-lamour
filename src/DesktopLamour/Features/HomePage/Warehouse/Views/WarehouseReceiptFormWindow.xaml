<Window x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.WarehouseReceiptFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        xmlns:behaviors="clr-namespace:DesktopLamour.Shared.Behaviors"
        Title="Phiếu Nhập Kho"
        Width="960"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="6" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════ -->
        <!-- Header                                     -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📥" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="Phiếu Nhập Kho"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Lập phiếu nhập kho hàng hóa"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Form                                       -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row A: Loại phiếu | Ngày hạch toán | Ngày chứng từ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Loại phiếu"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <ComboBox SelectedIndex="{Binding SelectedReceiptTypeIndex, Mode=TwoWay}"
                              Height="34">
                        <ComboBoxItem Content="1. Thành phẩm sản xuất"/>
                        <ComboBoxItem Content="2. Hàng bán bị trả lại"/>
                        <ComboBoxItem Content="3. Khác (NVL thừa, HH thuê gia công,...)"/>
                        <ComboBoxItem Content="4. Hàng nhận gia công"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="Ngày hạch toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding AccountingDate, Mode=TwoWay}" Height="34"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <controls:AppLabel Text="Ngày chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}" Height="34"/>
                </StackPanel>
            </Grid>

            <!-- Row B: Khách hàng | NV bán hàng -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Đối tượng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppSearchableComboBox
                        ItemsSource="{Binding Objects}"
                        SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                        Placeholder="Chọn khách hàng / nhà cung cấp"
                        IsNullable="True"
                        AddCommand="{Binding AddCustomerCommand}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="NV bán hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppSearchableComboBox
                        ItemsSource="{Binding Employees}"
                        SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                        Placeholder="Chọn nhân viên"
                        IsNullable="True"
                        AddCommand="{Binding AddEmployeeCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Row C: Người giao hàng | Diễn giải | Tham chiếu -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Người giao hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppTextField Text="{Binding DeliveryPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="Tên người giao hàng"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="Diễn giải"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppTextField Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="Mô tả phiếu nhập kho"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <controls:AppLabel Text="Tham chiếu"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppTextField Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="Số tham chiếu"/>
                </StackPanel>
            </Grid>

            <!-- Section label: Hàng hóa -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="14" Background="{StaticResource AppColor.BackgroundBrand}"
                        CornerRadius="2" Margin="0,0,8,0"/>
                <controls:AppLabel Text="Hàng hóa"
                                   Style="{StaticResource AppTypography.LabelSection}"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!-- Hàng hóa — Tab "Hàng tiền" / "Thống kê"    -->
        <!-- ══════════════════════════════════════════ -->
        <TabControl Grid.Row="2" Margin="20,6,20,0">

        <TabItem Header="1. Hàng tiền">
        <DataGrid ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource AppColor.BorderThin}"
                  BorderThickness="1"
                  MinHeight="96"
                  MaxHeight="240"
                  RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                  AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                  behaviors:DataGridRowNavigationBehavior.EnableArrowRowNavigation="True"
                  behaviors:DataGridLineContextMenuBehavior.EnableLineContextMenu="True">

            <DataGrid.Columns>

                <!-- Tên hàng -->
                <DataGridTemplateColumn Header="Tên hàng" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.Name}"
                                       VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:AppSearchableComboBox
                                ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                Placeholder="Chọn sản phẩm"
                                IsNullable="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Kho — mã kho ngầm định của sản phẩm đang chọn (HH/TB), không cho sửa tay.
                     Chưa gán kho ngầm định thì hiển thị/lưu fallback "HH" (Id=4). -->
                <DataGridTemplateColumn Header="Kho" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.DefaultWarehouseCode, TargetNullValue=HH}"
                                       VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ĐVT -->
                <DataGridTemplateColumn Header="ĐVT" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.Unit}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Số lượng -->
                <DataGridTextColumn Header="Số lượng"
                                    Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Đơn giá — read-only, auto-filled from product CostPrice -->
                <DataGridTextColumn Header="Đơn giá"
                                    Binding="{Binding UnitPrice, StringFormat=N0}"
                                    Width="110"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                            <Setter Property="Foreground"          Value="{StaticResource AppColor.TextError}"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Thành tiền -->
                <DataGridTextColumn Header="Thành tiền"
                                    Binding="{Binding Amount, StringFormat=N0}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- TK Nợ -->
                <DataGridTextColumn Header="TK Nợ"
                                    Binding="{Binding DebitAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- TK Có -->
                <DataGridTextColumn Header="TK Có"
                                    Binding="{Binding CreditAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Remove -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    Style="{StaticResource AppButton.RemoveLineIcon}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        </TabItem>

        <TabItem Header="2. Thống kê">
        <DataGrid ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource AppColor.BorderThin}"
                  BorderThickness="1"
                  MinHeight="96"
                  MaxHeight="240"
                  RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                  AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                  behaviors:DataGridRowNavigationBehavior.EnableArrowRowNavigation="True"
                  behaviors:DataGridLineContextMenuBehavior.EnableLineContextMenu="True">

            <DataGrid.Columns>

                <!-- Mã hàng -->
                <DataGridTextColumn Header="Mã hàng"
                                    Binding="{Binding SelectedProduct.Code}"
                                    Width="90"
                                    IsReadOnly="True"/>

                <!-- Tên hàng -->
                <DataGridTextColumn Header="Tên hàng"
                                    Binding="{Binding SelectedProduct.Name}"
                                    Width="160"
                                    IsReadOnly="True"/>

                <!-- Khoản mục CP -->
                <DataGridTextColumn Header="Khoản mục CP"
                                    Binding="{Binding CostItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>

                <!-- Đối tượng THCP -->
                <DataGridTextColumn Header="Đối tượng THCP"
                                    Binding="{Binding CostObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>

                <!-- Công trình -->
                <DataGridTextColumn Header="Công trình"
                                    Binding="{Binding Project, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <!-- Đơn đặt hàng -->
                <DataGridTextColumn Header="Đơn đặt hàng"
                                    Binding="{Binding PurchaseOrderNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <!-- Hợp đồng bán -->
                <DataGridTextColumn Header="Hợp đồng bán"
                                    Binding="{Binding SalesContractNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <!-- Số khế ước -->
                <DataGridTextColumn Header="Số khế ước"
                                    Binding="{Binding LoanContractNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="110"/>

                <!-- Mã thống kê -->
                <DataGridTextColumn Header="Mã thống kê"
                                    Binding="{Binding StatisticsCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

            </DataGrid.Columns>
        </DataGrid>
        </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════ -->
        <!-- Total row                                  -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="20,6,20,0"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppLabel Text="Tổng tiền:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Margin="0,0,12,0"/>
                <controls:AppLabel Text="{Binding TotalAmount, StringFormat=\{0:N0\}}"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Foreground="{StaticResource AppColor.TextBrand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Error banner                               -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Margin="20,4,20,0"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundErrorLight}"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:AppLabel Text="{Binding ErrorMessage}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"/>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Footer                                     -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="5"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="20,14"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <controls:AppButton Content="Hủy bỏ"
                                        Style="{StaticResource AppButton.Tertiary.Medium}"
                                        Command="{Binding CancelCommand}"
                                        Margin="0,0,10,0"/>
                    <controls:AppButton Content="💾 Cất"
                                        Style="{StaticResource AppButton.Primary.Medium}"
                                        Command="{Binding SaveCommand}"
                                        Width="130"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Window>
