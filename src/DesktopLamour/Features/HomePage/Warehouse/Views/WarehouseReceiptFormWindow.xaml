<Window x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.WarehouseReceiptFormWindow"
        xmlns:helpers="clr-namespace:DesktopLamour.Shared.Helpers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        xmlns:behaviors="clr-namespace:DesktopLamour.Shared.Behaviors"
        Title="Nhập kho khác - CÔNG TY TNHH THƯƠNG MẠI DỊCH VỤ SPA LAMOUR"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="6" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════ -->
        <!-- Header — tiêu đề "Phiếu nhập kho" + Loại phiếu ngay cạnh, như MISA. -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="20,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📥" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <controls:AppLabel Text="Phiếu nhập kho"
                                   Style="{StaticResource AppTypography.DisplaySection}"
                                   Foreground="{StaticResource AppColor.TextBrand}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>
                <ComboBox SelectedIndex="{Binding SelectedReceiptTypeIndex, Mode=TwoWay}"
                          IsEnabled="{Binding IsEditable}"
                          Width="300" Height="34"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center">
                    <ComboBoxItem Content="1. Thành phẩm sản xuất"/>
                    <ComboBoxItem Content="2. Hàng bán bị trả lại"/>
                    <ComboBoxItem Content="3. Khác (NVL thừa, HH thuê gia công,...)"/>
                    <ComboBoxItem Content="4. Hàng nhận gia công"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Toolbar — dải ribbon dùng chung (DocumentToolbar). "Bỏ ghi" chuyển từ header  -->
        <!-- xuống đây; "Cất"/"Hủy bỏ" chuyển từ footer lên đây — khớp bố cục 4 popup còn lại. -->
        <!-- Cất/Bỏ ghi/In disable (mờ) qua CanExecute (IsEditable/IsConfirmed) khi không   -->
        <!-- thực hiện được — không ẩn hẳn khỏi toolbar.                                    -->
        <!-- ══════════════════════════════════════════ -->
        <controls:DocumentToolbar Grid.Row="1"
                                  PrevCommand="{Binding NavigatePrevCommand}"
                                  NextCommand="{Binding NavigateNextCommand}"
                                  AddCommand="{Binding AddNewCommand}"
                                  SaveCommand="{Binding SaveCommand}"
                                  SaveLabel="Cất"
                                  UnpostCommand="{Binding UnconfirmCommand}"
                                  PrintCommand="{Binding PrintCommand}"
                                  CloseRequested="CloseButton_Click"/>

        <!-- ══════════════════════════════════════════ -->
        <!-- Form — Thông tin chung + Chứng từ (bố cục MISA, cùng khung với SalesOrderWindow) -->
        <!-- ══════════════════════════════════════════ -->
        <!-- Khóa toàn bộ field khi đang xem phiếu đã ghi sổ (Status=Confirmed) — phải "Bỏ ghi"
             trước mới sửa được, xem WarehouseReceiptFormViewModel.IsEditable. -->
        <Grid Grid.Row="2" Margin="16,12,16,0" IsEnabled="{Binding IsEditable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Thông tin chung ── -->
            <Border Grid.Column="0"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Đối tượng (bước 1) — ô mã nhà cung cấp ("+" thêm nhanh) + ô tên tự điền bên cạnh.
                         Chỉ liệt kê nhà cung cấp; phiếu cũ gắn khách hàng vẫn hiện đúng đối tượng của nó. -->
                    <controls:AppLabel Grid.Row="0" Grid.Column="0" Text="Đối tượng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"/>
                    <controls:AppSearchableComboBox Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding Objects}"
                        SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                        Placeholder="Chọn nhà cung cấp"
                        IsNullable="True"
                        CodeOnlyDisplay="True"
                        AddCommand="{Binding AddSupplierCommand}"/>
                    <controls:AppTextField Grid.Row="0" Grid.Column="3"
                        Text="{Binding SelectedObject.Name, Mode=OneWay}"
                        IsReadOnly="True"
                        Focusable="False"
                        Placeholder="Tên nhà cung cấp"/>

                    <controls:AppLabel Grid.Row="2" Grid.Column="0" Text="Người giao hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"/>
                    <controls:AppTextField Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                        Text="{Binding DeliveryPerson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Tên người giao hàng"/>

                    <!-- Diễn giải (bước 2) — gõ tay tự do -->
                    <controls:AppLabel Grid.Row="4" Grid.Column="0" Text="Diễn giải"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"/>
                    <controls:AppTextField Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                        Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Mô tả phiếu nhập kho"/>

                    <controls:AppLabel Grid.Row="6" Grid.Column="0" Text="Tham chiếu"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       VerticalAlignment="Center"/>
                    <controls:AppTextField Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3"
                        Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Số tham chiếu"/>
                </Grid>
            </Border>

            <!-- ── Right: Chứng từ ── -->
            <Border Grid.Column="2"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1" CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <StackPanel>
                    <controls:AppLabel Text="Ngày hạch toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AccountingDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Ngày chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <!-- Số chứng từ — chỉ đọc. Phiếu mới hiện trước số kế tiếp (BE cấp số thật lúc Cất). -->
                    <controls:AppLabel Text="Số chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <controls:AppTextField Text="{Binding ReceiptNumber, Mode=OneWay}"
                                           IsReadOnly="True"
                                           Focusable="False"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!-- Hàng hóa — Tab "Hàng tiền" / "Thống kê"    -->
        <!-- ══════════════════════════════════════════ -->
        <!-- Không đặt IsEnabled={Binding IsEditable} trên TabControl — theme WPF làm mờ toàn bộ nội dung
             tab khi Disabled (thấy rõ từ khi "Cất" giữ popup mở với phiếu đã khóa). Khóa bằng
             DataGrid.IsReadOnly + CanExecute của AddLine/RemoveLine, cùng cách SalesOrderWindow. -->
        <TabControl Grid.Row="3" Margin="16,8,16,0"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1">

        <TabItem Header="1. Hàng tiền">
        <DataGrid x:Name="LinesDataGrid"
                  ItemsSource="{Binding Lines}"
                  IsReadOnly="{Binding IsGridLocked}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#9CB8D4"
                  VerticalGridLinesBrush="#9CB8D4"
                  BorderThickness="0"
                  RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                  AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                  behaviors:DataGridRowNavigationBehavior.EnableArrowRowNavigation="True"
                  behaviors:DataGridLineContextMenuBehavior.EnableLineContextMenu="True">

            <DataGrid.Columns>

                <!-- Mã hàng (bước 3) — gõ mã rồi Enter/Tab là chọn (CommitTypedText): mã khớp hẳn, không thì
                     mã bắt đầu bằng chữ đã gõ. Tên hàng/Kho/ĐVT/Đơn giá/TK tự điền theo sản phẩm. -->
                <DataGridTemplateColumn Header="Mã hàng" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.Code}"
                                       VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:AppSearchableComboBox
                                ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                Placeholder="Mã hàng"
                                IsNullable="True"
                                CodeOnlyDisplay="True"
                                CommitTypedText="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Tên hàng — tìm theo tên, chọn xong tự điền Mã hàng -->
                <DataGridTemplateColumn Header="Tên hàng" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.Name}"
                                       VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <controls:AppSearchableComboBox
                                ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                Placeholder="Chọn sản phẩm"
                                IsNullable="True"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Kho — mã kho ngầm định của sản phẩm đang chọn (HH/TB), không cho sửa tay.
                     Chưa gán kho ngầm định thì hiển thị/lưu fallback "HH" (Id=4). -->
                <DataGridTemplateColumn Header="Kho" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.DefaultWarehouseCode, TargetNullValue=HH}"
                                       VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- TK Nợ -->
                <DataGridTextColumn Header="TK Nợ"
                                    Binding="{Binding DebitAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- TK Có -->
                <DataGridTextColumn Header="TK Có"
                                    Binding="{Binding CreditAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- ĐVT -->
                <DataGridTemplateColumn Header="ĐVT" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding SelectedProduct.Unit}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Số lượng (bước 4) — 0 hiện trống (chưa nhập) thay vì "0" chình ình, khớp cách
                     SalesOrderWindow hiển thị dòng trống chưa chọn sản phẩm. -->
                <DataGridTextColumn Header="Số lượng"
                                    Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=0}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Đơn giá — read-only, auto-filled from product CostPrice -->
                <DataGridTextColumn Header="Đơn giá"
                                    Binding="{Binding UnitPrice, Converter={StaticResource MoneyConverter}}"
                                    Width="120"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                            <Setter Property="Foreground"          Value="{StaticResource AppColor.TextError}"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                            <!-- Dòng trống nạp sẵn (chưa chọn hàng) không hiện số 0 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Thành tiền -->
                <DataGridTextColumn Header="Thành tiền"
                                    Binding="{Binding Amount, StringFormat=N0, ConverterCulture=vi-VN}"
                                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                            <!-- Dòng trống nạp sẵn (chưa chọn hàng) không hiện số 0 -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Remove -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    Style="{StaticResource AppButton.RemoveLineIcon}"
                                    HorizontalAlignment="Center"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
        </TabItem>

        <TabItem Header="2. Thống kê">
        <DataGrid ItemsSource="{Binding Lines}"
                  IsReadOnly="{Binding IsGridLocked}"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#9CB8D4"
                  VerticalGridLinesBrush="#9CB8D4"
                  BorderThickness="0"
                  RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                  AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                  behaviors:DataGridRowNavigationBehavior.EnableArrowRowNavigation="True"
                  behaviors:DataGridLineContextMenuBehavior.EnableLineContextMenu="True">

            <DataGrid.Columns>

                <!-- Mã hàng -->
                <DataGridTextColumn Header="Mã hàng"
                                    Binding="{Binding SelectedProduct.Code}"
                                    Width="90"
                                    IsReadOnly="True"/>

                <!-- Tên hàng -->
                <DataGridTextColumn Header="Tên hàng"
                                    Binding="{Binding SelectedProduct.Name}"
                                    Width="160"
                                    IsReadOnly="True"/>

                <!-- Khoản mục CP -->
                <DataGridTextColumn Header="Khoản mục CP"
                                    Binding="{Binding CostItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>

                <!-- Đối tượng THCP -->
                <DataGridTextColumn Header="Đối tượng THCP"
                                    Binding="{Binding CostObject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="130"/>

                <!-- Công trình -->
                <DataGridTextColumn Header="Công trình"
                                    Binding="{Binding Project, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <!-- Đơn đặt hàng -->
                <DataGridTextColumn Header="Đơn đặt hàng"
                                    Binding="{Binding PurchaseOrderNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <!-- Hợp đồng bán -->
                <DataGridTextColumn Header="Hợp đồng bán"
                                    Binding="{Binding SalesContractNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

                <!-- Số khế ước -->
                <DataGridTextColumn Header="Số khế ước"
                                    Binding="{Binding LoanContractNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="110"/>

                <!-- Mã thống kê -->
                <DataGridTextColumn Header="Mã thống kê"
                                    Binding="{Binding StatisticsCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"/>

            </DataGrid.Columns>
        </DataGrid>
        </TabItem>

        </TabControl>

        <!-- ══════════════════════════════════════════ -->
        <!-- Chân lưới — "Số dòng = N" + tổng số lượng / tổng tiền (như MISA) -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Margin="16,6,16,12"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <controls:AppLabel Text="Số dòng ="
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,6,0"/>
                    <controls:AppLabel Text="{Binding LineCount}"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <controls:AppLabel Text="Tổng số lượng:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,12,0"/>
                    <controls:AppLabel Text="{Binding TotalQuantity, StringFormat=N0, ConverterCulture=vi-VN}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"
                                       Margin="0,0,32,0"/>
                    <controls:AppLabel Text="Tổng tiền:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,12,0"/>
                    <controls:AppLabel helpers:NegativeAmountHighlight.IsEnabled="True" Text="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Error banner                               -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="5"
                Margin="16,4,16,12"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundErrorLight}"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:AppLabel Text="{Binding ErrorMessage}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"/>
        </Border>

    </Grid>

</Window>
