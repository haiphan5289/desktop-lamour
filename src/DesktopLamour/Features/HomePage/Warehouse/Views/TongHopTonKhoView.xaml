<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.TongHopTonKhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GroupHeaderBrush" Color="#BDD7EE"/>
        <SolidColorBrush x:Key="GroupBorderBrush"  Color="#9CB8D4"/>

        <!-- ElementStyle cho ô text (Mã hàng, Tên hàng, ĐVT) -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
        </Style>

        <!-- ElementStyle cho ô số (Qty, Value) — canh phải như MISA -->
        <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>

        <!-- Dòng tổng nhóm kho ("Tên kho : Hàng Hóa (66)") — đậm + nền nhạt để tách khỏi các mặt hàng. -->
        <Style x:Key="SummaryRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                    <Setter Property="Background"  Value="{StaticResource AppColor.BackgroundBrand}"/>
                    <Setter Property="FontWeight"  Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Tiêu đề bảng tự vẽ (khớp MISA): ô gộp, chữ giữa ô cả ngang lẫn dọc, kẻ đủ 4 cạnh ─────────
             Mỗi ô chỉ kẻ cạnh phải + dưới; cạnh trái/trên do khung ngoài HeaderClip kẻ. -->
        <Style x:Key="HeaderCell" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource GroupHeaderBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource GroupBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontWeight"          Value="SemiBold"/>
            <Setter Property="FontSize"            Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="TextAlignment"       Value="Center"/>
        </Style>

        <!-- Ô lọc theo cột (hàng thứ 3 của tiêu đề). -->
        <Style x:Key="FilterCell" TargetType="Border" BasedOn="{StaticResource HeaderCell}">
            <Setter Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
            <Setter Property="Padding"    Value="3,3"/>
        </Style>
        <!-- Ô lọc dùng đúng control/kích thước của hàng lọc ở Sổ chi tiết (InventoryDetailView):
             AppTextField 22px chữ 11; cột số thêm combo toán tử (=, ≤, ≥…) 30px bên trái. -->
        <Style x:Key="FilterField" TargetType="{x:Type controls:AppTextField}"
               BasedOn="{StaticResource {x:Type controls:AppTextField}}">
            <Setter Property="Height"              Value="22"/>
            <Setter Property="FontSize"            Value="11"/>
            <Setter Property="FontWeight"          Value="Normal"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <DataTemplate x:Key="NumberFilterTemplate" DataType="{x:Type models:NumericColumnFilter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                          SelectedItem="{Binding Operator}"
                          Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                       ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right"
                                       Style="{StaticResource FilterField}"
                                       Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="*"/>      <!-- Bảng -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- Thanh công cụ báo cáo — cùng thứ tự/kiểu nút với báo cáo Sổ quỹ (CashLedgerDetailReportView).
             "Chọn tham số..." mở lại hộp tham số, "Nạp" tải lại báo cáo với tham số hiện tại. Hộp tham số
             tự mở khi vào màn (xem TongHopTonKhoViewModel.StartAsync). -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <controls:AppButton Content="⚙️ Chọn tham số..."
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ChooseParamsCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🔄 Nạp"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding LoadCommand}"
                                    Margin="0,0,16,0"/>
                <controls:AppButton Content="🖨️ In"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding PrintCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✉️ Gửi Email"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendEmailCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="💬 Zalo"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendZaloCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✖ Đóng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"/>
            </StackPanel>
        </Border>

        <!-- Tiêu đề báo cáo ở giữa + dòng "Từ ngày … đến ngày …" ngay dưới (khớp MISA) -->
        <StackPanel Grid.Row="1" Margin="24,16,24,0" HorizontalAlignment="Center">
            <controls:AppLabel Text="{Binding ReportTitle}"
                               Style="{StaticResource AppTypography.DisplaySection}"
                               HorizontalAlignment="Center"/>
            <controls:AppLabel Text="{Binding ReportSubtitle}"
                               Style="{StaticResource AppTypography.BodySection}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Bảng -->
        <Grid Grid.Row="2" Margin="24,12,24,12">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <Grid Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề bảng tự vẽ: 3 hàng (nhóm 24 / tiêu đề cột 26 / ô lọc). Độ rộng 12 cột PHẢI khớp
                     DataGrid bên dưới: 110 · 200 · 70 · 100 110 · 90 110 · 90 110 · 100 110 · 130 (tổng 1330).
                     Khi lưới cuộn ngang, HeaderScroll dịch theo (xem code-behind OnGridScrollChanged). -->
                <Border x:Name="HeaderClip" Grid.Row="0" ClipToBounds="True"
                        BorderBrush="{StaticResource GroupBorderBrush}" BorderThickness="1,1,0,0">
                    <Grid x:Name="HeaderGrid" HorizontalAlignment="Left">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="HeaderScroll"/>
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cột thông tin: ô gộp dọc 2 hàng -->
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Mã hàng" Style="{StaticResource HeaderText}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Tên hàng" Style="{StaticResource HeaderText}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="ĐVT" Style="{StaticResource HeaderText}"/>
                        </Border>

                        <!-- Nhóm số liệu: tiêu đề nhóm gộp ngang 2 cột, chữ giữa cả cặp -->
                        <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Đầu kỳ" Style="{StaticResource HeaderText}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Nhập kho" Style="{StaticResource HeaderText}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="7" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Xuất kho" Style="{StaticResource HeaderText}"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="9" Grid.ColumnSpan="2" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Cuối kỳ" Style="{StaticResource HeaderText}"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="3"  Style="{StaticResource HeaderCell}"><TextBlock Text="Số lượng" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="4"  Style="{StaticResource HeaderCell}"><TextBlock Text="Giá trị"  Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="5"  Style="{StaticResource HeaderCell}"><TextBlock Text="Số lượng" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="6"  Style="{StaticResource HeaderCell}"><TextBlock Text="Giá trị"  Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="7"  Style="{StaticResource HeaderCell}"><TextBlock Text="Số lượng" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="8"  Style="{StaticResource HeaderCell}"><TextBlock Text="Giá trị"  Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="9"  Style="{StaticResource HeaderCell}"><TextBlock Text="Số lượng" Style="{StaticResource HeaderText}"/></Border>
                        <Border Grid.Row="1" Grid.Column="10" Style="{StaticResource HeaderCell}"><TextBlock Text="Giá trị"  Style="{StaticResource HeaderText}"/></Border>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="11" Style="{StaticResource HeaderCell}">
                            <TextBlock Text="Ngày HT" Style="{StaticResource HeaderText}"/>
                        </Border>

                        <!-- Hàng ô lọc: lọc ngay trên dữ liệu đã nạp -->
                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FilterCell}">
                            <controls:AppTextField Placeholder="Lọc..." Style="{StaticResource FilterField}"
                                                   Text="{Binding FilterCode, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource FilterCell}">
                            <controls:AppTextField Placeholder="Lọc..." Style="{StaticResource FilterField}"
                                                   Text="{Binding FilterName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FilterCell}">
                            <controls:AppTextField Placeholder="Lọc..." Style="{StaticResource FilterField}"
                                                   Text="{Binding FilterUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding OpeningQtyFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding OpeningValueFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="5" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding ImportQtyFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="6" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding ImportValueFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="7" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding ExportQtyFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="8" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding ExportValueFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="9" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding ClosingQtyFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="10" Style="{StaticResource FilterCell}">
                            <ContentControl Content="{Binding ClosingValueFilter}" Focusable="False"
                                            ContentTemplate="{StaticResource NumberFilterTemplate}"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="11" Style="{StaticResource FilterCell}">
                            <controls:AppTextField Placeholder="Lọc..." Style="{StaticResource FilterField}"
                                                   Text="{Binding FilterDate, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </Grid>
                </Border>

                <DataGrid x:Name="SummaryDataGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          HeadersVisibility="None"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#9CB8D4"
                          VerticalGridLinesBrush="#9CB8D4"
                          BorderBrush="{StaticResource GroupBorderBrush}"
                          BorderThickness="1,0,0,1"
                          RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                          AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                          RowStyle="{StaticResource SummaryRowStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="SummaryDataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Binding="{Binding Name}" Width="200" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Binding="{Binding Unit}" Width="70"  ElementStyle="{StaticResource CellText}"/>

                        <DataGridTextColumn Binding="{Binding OpeningQty,   Converter={StaticResource MoneyConverter}}" Width="100" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding OpeningValue, Converter={StaticResource MoneyConverter}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding ImportQty,    Converter={StaticResource MoneyConverter}}" Width="90"  ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding ImportValue,  Converter={StaticResource MoneyConverter}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding ExportQty,    Converter={StaticResource MoneyConverter}}" Width="90"  ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding ExportValue,  Converter={StaticResource MoneyConverter}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding ClosingQty,   Converter={StaticResource MoneyConverter}}" Width="100" ElementStyle="{StaticResource CellNumber}"/>
                        <DataGridTextColumn Binding="{Binding ClosingValue, Converter={StaticResource MoneyConverter}}" Width="110" ElementStyle="{StaticResource CellNumber}"/>

                        <DataGridTextColumn Binding="{Binding LatestAccountingDate, StringFormat=\{0:yyyyMMddHHmm\}}" Width="130"
                                            ElementStyle="{StaticResource CellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Nhấn &quot;Chọn tham số...&quot; để chọn kỳ báo cáo, kho và xem báo cáo."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- Chân bảng: "Số dòng = N" + tổng số lượng (chỉ cộng các mặt hàng đang hiển thị, không cộng dòng tổng nhóm kho) -->
        <Border Grid.Row="3"
                Margin="24,0,24,24"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Số dòng =" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding RowCount}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,32,0"/>
                <controls:AppLabel Text="Đầu kỳ:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalOpeningQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,24,0"/>
                <controls:AppLabel Text="Nhập kho:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalImportQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,24,0"/>
                <controls:AppLabel Text="Xuất kho:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalExportQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,24,0"/>
                <controls:AppLabel Text="Cuối kỳ:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalClosingQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}"/>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
