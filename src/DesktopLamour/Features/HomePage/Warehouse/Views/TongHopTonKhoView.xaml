<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.TongHopTonKhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GroupHeaderBrush" Color="#BDD7EE"/>
        <SolidColorBrush x:Key="GroupBorderBrush"  Color="#9CB8D4"/>

        <!-- Strip style mặc định → HeaderTemplate kiểm soát hoàn toàn -->
        <Style x:Key="CleanHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ElementStyle cho ô text (Mã hàng, Tên hàng, ĐVT) -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
        </Style>

        <!-- ElementStyle cho ô số (Qty, Value) — right-align để thẳng với header centered -->
        <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>
        <!-- Dòng tổng nhóm kho ("Tên kho : Hàng Hóa (66)") — đậm + nền nhạt để tách khỏi các mặt hàng. -->
        <Style x:Key="SummaryRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                    <Setter Property="Background"  Value="{StaticResource AppColor.BackgroundBrand}"/>
                    <Setter Property="FontWeight"  Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <controls:AppButton Content="← Quay lại"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🏠 Trang chủ"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToHomeCommand}"/>
            </StackPanel>
            <controls:AppLabel Text="Tổng hợp tồn kho"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
        </StackPanel>

        <!-- Thanh công cụ báo cáo (khớp MISA): "Chọn tham số..." mở lại hộp tham số, "Nạp" tải lại báo cáo với
             tham số hiện tại; bên phải là khoảng ngày của báo cáo đang xem. Bộ lọc không còn nằm sẵn
             trên màn hình — hộp tham số tự mở khi vào màn (xem TongHopTonKhoViewModel.StartAsync). -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <controls:AppButton Content="⚙ Chọn tham số..."
                                        Style="{StaticResource AppButton.Secondary.Medium}"
                                        Command="{Binding ChooseParamsCommand}"
                                        Margin="0,0,8,0"/>
                    <controls:AppButton Content="🔄 Nạp"
                                        Style="{StaticResource AppButton.Secondary.Medium}"
                                        Command="{Binding LoadCommand}"/>
                </StackPanel>
                <controls:AppLabel Grid.Column="1"
                                   Text="{Binding ReportSubtitle}"
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="2" Margin="24,12,24,12">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <DataGrid x:Name="SummaryDataGrid"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ColumnHeaderStyle="{StaticResource CleanHeaderStyle}"
                      RowStyle="{StaticResource SummaryRowStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="SummaryDataGrid_MouseDoubleClick"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">

                <DataGrid.Columns>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Cột thông tin (không có nhóm)     -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding Code}" Width="110"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,0,0,1">
                                        <TextBlock Text="Mã hàng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Name}" Width="200"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,0,1"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="Tên hàng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Unit}" Width="70"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,0,1,1">
                                        <TextBlock Text="ĐVT"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Đầu kỳ                      -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding OpeningQty, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Đầu kỳ"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding OpeningValue, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Nhập kho                    -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding ImportQty, Converter={StaticResource MoneyConverter}}" Width="90"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Nhập kho"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ImportValue, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Xuất kho                    -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding ExportQty, Converter={StaticResource MoneyConverter}}" Width="90"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Xuất kho"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ExportValue, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Cuối kỳ                     -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding ClosingQty, Converter={StaticResource MoneyConverter}}" Width="100"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Cuối kỳ"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ClosingValue, Converter={StaticResource MoneyConverter}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Ngày HT gần nhất                  -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding LatestAccountingDate, StringFormat=\{0:yyyyMMddHHmm\}}" Width="130"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,0,1,1">
                                        <TextBlock Text="Ngày HT"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Nhấn &quot;Chọn tham số...&quot; để chọn kỳ báo cáo, kho và xem báo cáo."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>

        <!-- Chân bảng: "Số dòng = N" + tổng số lượng (chỉ cộng các mặt hàng, không cộng dòng tổng nhóm kho) -->
        <Border Grid.Row="3"
                Margin="24,0,24,24"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Số dòng =" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding RowCount}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,32,0"/>
                <controls:AppLabel Text="Đầu kỳ:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalOpeningQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,24,0"/>
                <controls:AppLabel Text="Nhập kho:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalImportQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,24,0"/>
                <controls:AppLabel Text="Xuất kho:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalExportQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}" Margin="0,0,24,0"/>
                <controls:AppLabel Text="Cuối kỳ:" Style="{StaticResource AppTypography.BodyCaption}" Margin="0,0,6,0"/>
                <controls:AppLabel Text="{Binding TotalClosingQty, StringFormat=N0, ConverterCulture=vi-VN}" Style="{StaticResource AppTypography.LabelSection}"/>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
