<UserControl x:Class="DesktopLamour.Features.HomePage.Warehouse.Views.TongHopTonKhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GroupHeaderBrush" Color="#BDD7EE"/>
        <SolidColorBrush x:Key="GroupBorderBrush"  Color="#9CB8D4"/>

        <!-- Strip style mặc định → HeaderTemplate kiểm soát hoàn toàn -->
        <Style x:Key="CleanHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ElementStyle cho ô text (Mã hàng, Tên hàng, ĐVT) -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
        </Style>

        <!-- ElementStyle cho ô số (Qty, Value) — right-align để thẳng với header centered -->
        <Style x:Key="CellNumber" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <controls:AppButton Content="← Quay lại"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding GoBackCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🏠 Trang chủ"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToHomeCommand}"/>
            </StackPanel>
            <controls:AppLabel Text="Tổng hợp tồn kho"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
        </StackPanel>

        <!-- Filter toolbar — chuyển từ popup ra ngay màn hình: hàng 1 là Kỳ/Từ ngày/Đến ngày/Đơn vị
             tính/Nhóm VTHH/Lọc/Xóa điều kiện, hàng 2 là danh sách kho chọn nhiều (checkbox). -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <!-- Mỗi cặp Label + control nằm chung 1 StackPanel để WrapPanel chỉ xuống dòng
                     giữa các cặp, không tách rời label khỏi control của nó khi thu hẹp cửa sổ. -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <controls:AppLabel Text="Kỳ"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PeriodPresetOptions}"
                                  SelectedItem="{Binding PeriodPreset, Mode=TwoWay}"
                                  Width="130" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <controls:AppLabel Text="Từ ngày"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                    Width="130" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <controls:AppLabel Text="Đến ngày"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                    Width="130" Height="44" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <controls:AppLabel Text="Đơn vị tính"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                        <controls:AppSearchableComboBox
                            ItemsSource="{Binding ProductUnits}"
                            SelectedItem="{Binding SelectedProductUnit, Mode=TwoWay}"
                            Placeholder="Tất cả"
                            IsNullable="True"
                            Width="160" Height="44" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                        <controls:AppLabel Text="Nhóm VTHH"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                        <controls:AppSearchableComboBox
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                            Placeholder="Tất cả"
                            IsNullable="True"
                            Width="160" Height="44" VerticalAlignment="Center"/>
                    </StackPanel>

                    <controls:AppButton Content="🔍 Lọc"
                                        Style="{StaticResource AppButton.Primary.Medium}"
                                        Command="{Binding LoadCommand}"
                                        Height="44" VerticalAlignment="Center"
                                        Margin="0,0,8,8"/>
                    <controls:AppButton Content="Xóa điều kiện"
                                        Style="{StaticResource AppButton.Tertiary.Medium}"
                                        Command="{Binding ClearConditionsCommand}"
                                        Height="44" VerticalAlignment="Center"
                                        Margin="0,0,0,8"/>
                </WrapPanel>

                <!-- Kho + Sản phẩm — ẩn theo yêu cầu (2026-08-22). Giữ nguyên field/logic trong
                     TongHopTonKhoViewModel (WarehouseItems/ProductItems/InitializeFilters/LoadCommand
                     vẫn build warehouse_ids/product_ids như cũ — không tick gì = tất cả kho/sản phẩm,
                     hành vi mặc định không đổi), chỉ ẩn khỏi UI nên có thể mở lại dễ dàng sau này (bỏ
                     Visibility="Collapsed" là xong). -->
                <StackPanel Visibility="Collapsed">
                    <!-- Kho — bỏ chọn tất cả = tất cả kho -->
                    <StackPanel Margin="0,0,0,12">
                        <controls:AppLabel Text="Kho — bỏ chọn tất cả = tất cả kho"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           Foreground="{StaticResource AppColor.TextSecondary}"
                                           Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding WarehouseItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Margin="0,0,20,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sản phẩm — bỏ chọn tất cả = tất cả sản phẩm -->
                    <StackPanel>
                        <controls:AppLabel Text="Sản phẩm — bỏ chọn tất cả = tất cả sản phẩm"
                                           Style="{StaticResource AppTypography.BodyCaption}"
                                           Foreground="{StaticResource AppColor.TextSecondary}"
                                           Margin="0,0,0,8"/>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ProductItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayText}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,20,6" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <Grid Grid.Row="2" Margin="24,12,24,24">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <DataGrid x:Name="SummaryDataGrid"
                      ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ColumnHeaderStyle="{StaticResource CleanHeaderStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MouseDoubleClick="SummaryDataGrid_MouseDoubleClick"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">

                <DataGrid.Columns>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Cột thông tin (không có nhóm)     -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding Code}" Width="110"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,0,0,1">
                                        <TextBlock Text="Mã hàng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Name}" Width="200"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,0,1"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="Tên hàng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding Unit}" Width="70"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,0,1,1">
                                        <TextBlock Text="ĐVT"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Đầu kỳ                      -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding OpeningQty, StringFormat=\{0:N0\}}" Width="100"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Đầu kỳ"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding OpeningValue, StringFormat=\{0:N0\}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Nhập kho                    -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding ImportQty, StringFormat=\{0:N0\}}" Width="90"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Nhập kho"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ImportValue, StringFormat=\{0:N0\}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Xuất kho                    -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding ExportQty, StringFormat=\{0:N0\}}" Width="90"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Xuất kho"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ExportValue, StringFormat=\{0:N0\}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Nhóm: Cuối kỳ                     -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding ClosingQty, StringFormat=\{0:N0\}}" Width="100"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Cuối kỳ"
                                                   FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Số lượng"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding ClosingValue, StringFormat=\{0:N0\}}" Width="110"
                                        ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Giá trị"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════════════════ -->
                    <!--  Ngày HT gần nhất                  -->
                    <!-- ═══════════════════════════════════ -->

                    <DataGridTextColumn Binding="{Binding LatestAccountingDate, StringFormat=\{0:yyyyMMddHHmm\}}" Width="130"
                                        ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,0,1,1">
                                        <TextBlock Text="Ngày HT"
                                                   FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Nhấn 🔍 Lọc để chọn kỳ báo cáo và xem báo cáo."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
