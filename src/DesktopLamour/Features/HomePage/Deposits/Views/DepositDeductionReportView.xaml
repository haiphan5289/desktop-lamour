<UserControl x:Class="DesktopLamour.Features.HomePage.Deposits.Views.DepositDeductionReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="Báo cáo đơn trừ cọc"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Theo dõi các lần trừ cọc vào chứng từ bán hàng"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Filter toolbar                                -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Từ ngày"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            Width="140" Margin="0,0,16,0"/>
                <controls:AppLabel Text="Đến ngày"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            Width="140" Margin="0,0,16,0"/>
                <controls:AppTextField Text="{Binding FilterKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="Tìm theo khách hàng / số chứng từ"
                                       Width="220"
                                       Margin="0,0,16,0"/>
                <controls:AppButton Content="🔍 Xem báo cáo"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding LoadCommand}"/>
                <controls:AppButton Content="🗑️ Xóa"
                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                    Command="{Binding DeleteCommand}"
                                    Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Summary                                       -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="24,8,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Tổng số tiền đã trừ cọc:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Margin="0,0,8,0"/>
                <controls:AppLabel Text="{Binding TotalDeducted, StringFormat=\{0:N0\}}"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Foreground="{StaticResource AppColor.TextBrand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid                                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="24,8,24,24">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedDeduction, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      ColumnHeaderHeight="56"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">

                <!-- DataGridColumnHeader centers its content by default — without this, the filter
                     row (StackPanel/Grid + AppTextField/ComboBox, all set to Stretch) still just
                     sizes to its natural width and sits centered instead of filling the column. -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <!-- Số chứng từ — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Số chứng từ"
                                        Binding="{Binding DocumentNumber}"
                                        Width="110">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số chứng từ" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDocumentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ngày — date column: operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Header="Ngày"
                                        Binding="{Binding AccountingDate, StringFormat=\{0:dd/MM/yyyy\}}"
                                        Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Ngày" FontWeight="SemiBold"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.AccountingDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                    SelectedDate="{Binding DataContext.AccountingDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    FontSize="10" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Cọc — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Cọc"
                                        Binding="{Binding DepositDocumentNumber}"
                                        Width="100">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Cọc" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDepositDocumentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Đơn bán hàng — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Đơn bán hàng"
                                        Binding="{Binding SalesOrderDocumentNumber}"
                                        Width="120">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Đơn bán hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterSalesOrderDocumentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Khách hàng — text column: plain Contains filter, inline. Fixed width (not "*") —
                         mixing a star column with HorizontalScrollBarVisibility="Auto" is a known WPF
                         DataGrid quirk that clips trailing columns instead of scrolling to them. -->
                    <DataGridTextColumn Header="Khách hàng"
                                        Binding="{Binding CustomerName}"
                                        Width="170">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Khách hàng" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterCustomerName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Nhân viên — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Header="Nhân viên"
                                        Binding="{Binding EmployeeName}"
                                        Width="140">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Nhân viên" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterEmployeeName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số tiền trừ — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Header="Số tiền trừ"
                                        Binding="{Binding Amount, StringFormat=\{0:N0\}}"
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                                <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight"          Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Số tiền trừ" FontWeight="SemiBold" TextAlignment="Right"/>
                                    <Grid Margin="0,4,4,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                  SelectedItem="{Binding DataContext.AmountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                               ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                               HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.AmountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Diễn giải — text column: plain Contains filter, inline. Fixed width (not "*") —
                         mixing a star column with HorizontalScrollBarVisibility="Auto" is a known WPF
                         DataGrid quirk that clips trailing columns instead of scrolling to them. -->
                    <DataGridTextColumn Header="Diễn giải"
                                        Binding="{Binding Description}"
                                        Width="220">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="Diễn giải" FontWeight="SemiBold"/>
                                    <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                            Text="{Binding DataContext.FilterDescription, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                            FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,4,2"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chưa có đơn trừ cọc nào."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
