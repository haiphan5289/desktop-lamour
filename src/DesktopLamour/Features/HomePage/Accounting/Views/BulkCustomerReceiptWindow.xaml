<Window x:Class="DesktopLamour.Features.HomePage.Accounting.Views.BulkCustomerReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="Phiếu thu tiền mặt khách hàng hàng loạt - CÔNG TY TNHH THƯƠNG MẠI DỊCH VỤ LAMOUR"
        Width="1150"
        Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style x:Key="AppTabItem.Modern" TargetType="TabItem">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabPill"
                                CornerRadius="{StaticResource AppRadius.Medium}"
                                Margin="2"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                TextElement.Foreground="{StaticResource AppColor.TextSecondary}"
                                TextElement.FontWeight="SemiBold"
                                TextElement.FontSize="14">
                            <ContentPresenter ContentSource="Header"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="{StaticResource AppColor.BackgroundPrimary}"/>
                                <Setter TargetName="TabPill" Property="TextElement.Foreground" Value="{StaticResource AppColor.TextBrand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppTabControl.Modern" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <!-- Grid (không phải StackPanel) — StackPanel cấp chiều rộng VÔ HẠN cho
                             children theo trục ngang, khiến DataGrid nhiều cột bên trong tự phình
                             rộng thay vì bị ép đúng chiều rộng TabControl thật, nên ScrollViewer nội
                             bộ của DataGrid không bao giờ kích hoạt dù cột tràn ra ngoài cửa sổ. -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{StaticResource AppColor.BackgroundSecondary}"
                                    CornerRadius="{StaticResource AppRadius.Medium}"
                                    Padding="4"
                                    Margin="0,0,0,8">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          HorizontalAlignment="Left"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{StaticResource AppColor.BackgroundPrimary}"
                                    BorderBrush="{StaticResource AppColor.BorderThin}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource AppRadius.Large}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:AppLoadingOverlay Grid.RowSpan="6" IsLoading="{Binding IsBusy}"/>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="Phiếu thu tiền mặt khách hàng hàng loạt"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Xác nhận thu tiền — gộp nhiều khách hàng vào 1 phiếu"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                        BorderBrush="{StaticResource AppColor.BorderThin}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <controls:AppButton Content="💾 Cất" Style="{StaticResource AppButton.Primary.Medium}"
                                            Command="{Binding SaveCommand}" FontWeight="SemiBold" Margin="0"/>
                        <Rectangle Width="1" Height="24" Fill="{StaticResource AppColor.BorderThin}" Margin="4,0"/>
                        <controls:AppButton Content="Hủy bỏ" Style="{StaticResource AppButton.Tertiary.Medium}"
                                            Click="CancelButton_Click" Margin="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Form — Thông tin chung + Chứng từ -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Người nộp -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Người nộp"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding PayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Tên người nộp / nhân viên thu"/>
                    </Grid>

                    <!-- Địa chỉ -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Địa chỉ"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Địa chỉ"/>
                    </Grid>

                    <!-- Lý do nộp (cố định) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Lý do nộp"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1" Text="{Binding ReasonLabel, Mode=OneWay}" IsReadOnly="True"/>
                    </Grid>

                    <!-- NV thu nợ | Kèm theo | Tham chiếu -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:AppLabel Grid.Column="0" Text="NV thu nợ"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppSearchableComboBox Grid.Column="1"
                            ItemsSource="{Binding Employees}"
                            SelectedItem="{Binding SelectedCollectorEmployee, Mode=TwoWay}"
                            Placeholder="Chọn nhân viên" IsNullable="True"/>

                        <StackPanel Grid.Column="3">
                            <controls:AppLabel Text="Kèm theo"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,0,0,4"/>
                            <controls:AppTextField
                                Text="{Binding Attachment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Placeholder="chứng từ gốc"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5">
                            <controls:AppLabel Text="Tham chiếu"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,0,0,4"/>
                            <controls:AppTextField Text="{Binding Reference, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Chứng từ -->
            <Border Grid.Column="2"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <StackPanel>
                    <controls:AppLabel Text="Ngày hạch toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AccountingDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Ngày chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Số chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <controls:AppTextField Text="{Binding DocumentNumber, Mode=OneWay}" IsReadOnly="True"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tabs -->
        <Grid Grid.Row="3" Margin="16,8,16,0">
            <Border Panel.ZIndex="10" Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12" VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding ErrorMessage}" Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

            <TabControl Style="{StaticResource AppTabControl.Modern}">

                <TabItem Header="1. Hạch toán" Style="{StaticResource AppTabItem.Modern}">
                    <DataGrid ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#9CB8D4"
                              VerticalGridLinesBrush="#9CB8D4"
                              MaxHeight="360"
                              BorderThickness="0"
                              RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                              AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Diễn giải" Binding="{Binding DocumentNumber, StringFormat='Thu tiền khách hàng - {0}'}" Width="220" IsReadOnly="True"/>
                            <DataGridTextColumn Header="TK Nợ" Binding="{Binding DebitAccountDisplay}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="TK Có" Binding="{Binding CreditAccountDisplay}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=\{0:N0\}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="0,0,8,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Mã khách hàng" Binding="{Binding CustomerCode}" Width="110" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding CustomerName}" Width="220" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="2. Chứng từ" Style="{StaticResource AppTabItem.Modern}">
                    <DataGrid ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#9CB8D4"
                              VerticalGridLinesBrush="#9CB8D4"
                              MaxHeight="360"
                              BorderThickness="0"
                              RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                              AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày chứng từ" Binding="{Binding AccountingDate, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Số chứng từ" Binding="{Binding DocumentNumber}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Mã khách hàng" Binding="{Binding CustomerCode}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding CustomerName}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Hạn thanh toán" Binding="{Binding PaymentDueDate, StringFormat=dd/MM/yyyy}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Số phải thu" Binding="{Binding GrandTotal, StringFormat=\{0:N0\}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số chưa thu" Binding="{Binding MaxAmount, StringFormat=\{0:N0\}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số thu" Binding="{Binding Amount, StringFormat=\{0:N0\}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Padding" Value="0,0,8,0"/><Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TK phải thu" Binding="{Binding CreditAccountDisplay}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Điều khoản TT" Binding="{Binding PaymentTerms}" Width="140" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Margin="0,6,0,0">
            <Grid>
                <controls:AppLabel Text="{Binding LineSummary}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <controls:AppLabel Text="Tổng tiền:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,12,0"/>
                    <controls:AppLabel Text="{Binding TotalAmount, StringFormat=\{0:N0\}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Background="{StaticResource AppColor.BackgroundSecondary}"
                Padding="16,6">
            <controls:AppLabel Text="Số chứng từ hiển thị là dự đoán — số thật gán khi bấm Cất."
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"/>
        </Border>

    </Grid>
</Window>
