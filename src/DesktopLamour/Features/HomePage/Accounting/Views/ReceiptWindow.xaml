<Window x:Class="DesktopLamour.Features.HomePage.Accounting.Views.ReceiptWindow"
        xmlns:helpers="clr-namespace:DesktopLamour.Shared.Helpers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        xmlns:behaviors="clr-namespace:DesktopLamour.Shared.Behaviors"
        Title="Phiếu thu - CÔNG TY TNHH THƯƠNG MẠI DỊCH VỤ LAMOUR"
        Width="1100"
        Height="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">

    <Window.Resources>

        <!-- Cùng style lưới "1. Hạch toán" với PaymentWindow. -->
        <!-- 2026-09-29 (khớp MISA, lưới "1. Hạch toán"): ô chữ canh giữa dọc cho thẳng hàng với các ô
             ComboBox (trước canh trên nên dòng bị lệch), chữ dài thì "…" thay vì tràn. -->
        <Style x:Key="EntryTextCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="6,0"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F9" Command="{Binding AddEntryCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="6" IsLoading="{Binding IsBusy}"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Header                                                  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="Phiếu thu"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Lập và quản lý phiếu thu"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Toolbar — dải ribbon dùng chung (DocumentToolbar)       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <controls:DocumentToolbar Grid.Row="1"
                                  PrevCommand="{Binding NavigatePrevCommand}"
                                  NextCommand="{Binding NavigateNextCommand}"
                                  AddCommand="{Binding AddNewCommand}"
                                  EditCommand="{Binding EditCommand}"
                                  DeleteCommand="{Binding DeleteCommand}"
                                  SaveCommand="{Binding SaveCommand}"
                                  SaveLabel="Cất"
                                  UnpostCommand="{Binding ToggleConfirmCommand}"
                                  UnpostLabel="{Binding UnpostButtonLabel}"
                                  PrintCommand="{Binding PrintCommand}"
                                  CloseRequested="CloseButton_Click"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Form — Thông tin chung + Chứng từ                       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- IsEnabled="{Binding IsEditable}" — khóa form khi chứng từ đã Ghi sổ (Confirmed), phải
             bấm "Bỏ ghi" mới sửa lại được. Mirror WarehouseReceiptFormViewModel/SalesReturnWindow. -->
        <Grid Grid.Row="2" Margin="16,12,16,0" IsEnabled="{Binding IsEditable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Thông tin chung ── -->
            <Border Grid.Column="0"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Đối tượng — 1 ô tìm kiếm chung (Khách hàng + Nhân viên), khớp ảnh mẫu MISA -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Đối tượng"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppSearchableComboBox Grid.Column="1"
                            ItemsSource="{Binding PartnerItems}"
                            SelectedItem="{Binding SelectedPartner, Mode=TwoWay}"
                            Placeholder="Chọn đối tượng (khách hàng / nhân viên)"
                            IsNullable="True"/>
                    </Grid>

                    <!-- Người nộp -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Người nộp"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding PayerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Tên người nộp"/>
                    </Grid>

                    <!-- Địa chỉ -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Địa chỉ"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppTextField Grid.Column="1"
                            Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Địa chỉ"/>
                    </Grid>

                    <!-- Lý do nộp + nội dung chi tiết (tự điền theo lý do, sửa tay được) -->
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <controls:AppLabel Grid.Column="0" Text="Lý do nộp"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PaymentReasons}"
                                  SelectedItem="{Binding SelectedPaymentReason, Mode=TwoWay}"
                                  Height="34">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PaymentReasonDisplayConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <controls:AppTextField Grid.Column="3"
                            Text="{Binding ReasonDetail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Placeholder="Nội dung nộp (VD: nhập quỹ)"/>
                    </Grid>

                    <!-- Nhân viên thu | Kèm theo | Tham chiếu -->
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <controls:AppLabel Grid.Column="0" Text="Nhân viên thu"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           VerticalAlignment="Center"/>
                        <controls:AppSearchableComboBox Grid.Column="1"
                            ItemsSource="{Binding Employees}"
                            SelectedItem="{Binding SelectedCollectorEmployee, Mode=TwoWay}"
                            Placeholder="Chọn nhân viên"
                            IsNullable="True"
                            AddCommand="{Binding AddCollectorEmployeeCommand}"/>

                        <StackPanel Grid.Column="3">
                            <controls:AppLabel Text="Kèm theo"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,0,0,4"/>
                            <controls:AppTextField
                                Text="{Binding Attachment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Placeholder="chứng từ gốc"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5">
                            <controls:AppLabel Text="Tham chiếu"
                                               Style="{StaticResource AppTypography.LabelSection}"
                                               Margin="0,0,0,4"/>
                            <controls:AppTextField
                                Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Placeholder="Số tham chiếu"/>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <!-- ── Right: Chứng từ ── -->
            <Border Grid.Column="2"
                    Padding="14,12"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{StaticResource AppColor.BackgroundPrimary}">
                <StackPanel>
                    <controls:AppLabel Text="Ngày hạch toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding AccountingDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Ngày chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}"
                                Height="34" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <controls:AppLabel Text="Số chứng từ"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,4"/>
                    <controls:AppTextField
                        Text="{Binding DocumentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Placeholder="Số chứng từ"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Tab area — Hạch toán DataGrid                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="16,8,16,0" IsEnabled="{Binding IsEditable}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab header -->
            <Border Grid.Row="0"
                    Padding="12,6"
                    Background="{StaticResource AppColor.BackgroundSecondary}"
                    BorderBrush="{StaticResource AppColor.BorderThin}"
                    BorderThickness="1,1,1,0"
                    CornerRadius="6,6,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="3" Height="14" Background="{StaticResource AppColor.BackgroundBrand}"
                            CornerRadius="2" Margin="0,0,8,0"/>
                    <controls:AppLabel Text="1. Hạch toán"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Entries}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#9CB8D4"
                      VerticalGridLinesBrush="#9CB8D4"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      behaviors:DataGridRowNavigationBehavior.EnableArrowRowNavigation="True"
                      behaviors:DataGridLineContextMenuBehavior.EnableLineContextMenu="True"
                      behaviors:DataGridLineContextMenuBehavior.AddCommandName="AddEntryCommand"
                      behaviors:DataGridLineContextMenuBehavior.RemoveCommandName="RemoveEntryCommand"
                      behaviors:DataGridLineContextMenuBehavior.ShowProductStockMenuItem="False">

                <DataGrid.Columns>

                    <!-- Diễn giải — tự lấy theo nội dung Lý do nộp -->
                    <DataGridTextColumn Header="Diễn giải"
                                        Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource EntryTextCell}"
                                        Width="250"/>

                    <!-- TK Nợ — ô tìm kiếm (AppSearchableComboBox dạng gọn) luôn hiện sẵn trong ô (cùng cách PaymentWindow, né edit-mode của DataGrid) -->
                    <DataGridTemplateColumn Header="TK Nợ" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:AppSearchableComboBox
                                            IsCompact="True" CodeOnlyDisplay="True" CommitTypedText="True"
                                            ItemsSource="{Binding DataContext.AccountSettings, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedItem="{Binding SelectedDebitAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding SelectedDebitAccount.DisplayText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TK Có — không có mặc định, kế toán tự chọn -->
                    <DataGridTemplateColumn Header="TK Có" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:AppSearchableComboBox
                                            IsCompact="True" CodeOnlyDisplay="True" CommitTypedText="True"
                                            ItemsSource="{Binding DataContext.AccountSettings, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            SelectedItem="{Binding SelectedCreditAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="{Binding SelectedCreditAccount.DisplayText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Số tiền -->
                    <DataGridTextColumn Header="Số tiền"
                                        Binding="{Binding Amount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BlankPreserveConverter}, ConverterParameter=N0, ConverterCulture=vi-VN}"
                                        Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment"   Value="Center"/>
                                <Setter Property="Padding"             Value="0,0,6,0"/>
                                <Setter Property="Foreground"          Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight"          Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Đối tượng (SubjectCode) -->
                    <DataGridTextColumn Header="Đối tượng"
                                        Binding="{Binding SubjectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource EntryTextCell}"
                                        Width="100"/>

                    <!-- Tên đối tượng -->
                    <DataGridTextColumn Header="Tên đối tượng"
                                        Binding="{Binding SubjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource EntryTextCell}"
                                        Width="210"/>

                    <!-- TK ngân hàng -->
                    <DataGridTextColumn Header="TK ngân hàng"
                                        Binding="{Binding BankAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource EntryTextCell}"
                                        Width="120"/>

                    <!-- Remove -->
                    <DataGridTemplateColumn Header="" Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Ẩn nút xoá ở dòng trống — không có gì để xoá (như SalesOrderWindow) -->
                                <Button Content="✕"
                                        HorizontalAlignment="Center"
                                        Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AppButton.RemoveLineIcon}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Error banner                                            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="4"
                Margin="16,4,16,0"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundErrorLight}"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:AppLabel Text="{Binding ErrorMessage}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"/>
        </Border>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Footer — row count + total + add entry                  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="5"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="16,10"
                Margin="0,6,0,0"
                IsEnabled="{Binding IsEditable}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:AppButton Grid.Column="0"
                                    Content="+ Thêm dòng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding AddEntryCommand}"/>

                <controls:AppLabel Grid.Column="1"
                                   Text="{Binding EntrySummary}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:AppLabel Text="Tổng tiền:"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,12,0"/>
                    <controls:AppLabel helpers:NegativeAmountHighlight.IsEnabled="True" Text="{Binding TotalAmount, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Window>
