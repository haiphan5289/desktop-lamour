<Window x:Class="DesktopLamour.Features.HomePage.Accounting.Views.PaymentReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="Thu tiền khách hàng"
        Width="820"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="5" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════ -->
        <!-- Header                                     -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💳" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="Thu tiền khách hàng"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Lập phiếu thu — tài khoản 131"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Form                                       -->
        <!-- ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row A: Phương thức | Loại tiền | Tỷ giá -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Phương thức thanh toán"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Height="34" VerticalAlignment="Center">
                        <RadioButton Content="Tiền mặt"
                                     IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Cash}"
                                     VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <RadioButton Content="Chuyển khoản"
                                     IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource StringEqualityConverter}, ConverterParameter=BankTransfer}"
                                     VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="Loại tiền"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppTextField Text="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VND"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <controls:AppLabel Text="Tỷ giá"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppTextField Text="{Binding ExchangeRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="1.00"/>
                </StackPanel>
            </Grid>

            <!-- Row B: Khách hàng | Ngày thu tiền | NV bán hàng | Số tiền -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- Khách hàng -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:AppLabel Text="Khách hàng" Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *" Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <controls:AppSearchableComboBox
                        ItemsSource="{Binding Customers}"
                        SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                        Placeholder="Chọn khách hàng"
                        IsNullable="False"/>
                </StackPanel>

                <!-- Ngày thu tiền -->
                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="Ngày thu tiền"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding CollectionDate, Mode=TwoWay}" Height="34"/>
                </StackPanel>

                <!-- NV bán hàng -->
                <StackPanel Grid.Column="4">
                    <controls:AppLabel Text="NV bán hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,5"/>
                    <controls:AppSearchableComboBox
                        ItemsSource="{Binding Employees}"
                        SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                        Placeholder="Chọn nhân viên"
                        IsNullable="True"/>
                </StackPanel>

                <!-- Số tiền -->
                <StackPanel Grid.Column="6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <controls:AppLabel Text="Số tiền" Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *" Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <controls:AppTextField Text="{Binding TotalAmount, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                           Placeholder="0" TextAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- Row C: Diễn giải -->
            <StackPanel Grid.Row="4">
                <controls:AppLabel Text="Diễn giải"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Margin="0,0,0,5"/>
                <controls:AppTextField Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="Ví dụ: Thu tiền hàng tháng 4/2026"/>
            </StackPanel>

            <!-- Row D: Section label -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="14" Background="{StaticResource AppColor.BackgroundBrand}"
                        CornerRadius="2" Margin="0,0,8,0"/>
                <controls:AppLabel Text="Chứng từ công nợ"
                                   Style="{StaticResource AppTypography.LabelSection}"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════ -->
        <!-- DataGrid                                   -->
        <!-- ══════════════════════════════════════════ -->
        <DataGrid Grid.Row="2"
                  Margin="20,6,20,0"
                  ItemsSource="{Binding Lines}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource AppColor.BorderThin}"
                  BorderThickness="1"
                  MinHeight="96"
                  MaxHeight="200"
                  RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                  AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}">

            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Ngày chứng từ" Width="108">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DocumentDate, StringFormat=dd/MM/yyyy}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Số chứng từ"
                                    Binding="{Binding DocumentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100"/>

                <DataGridTextColumn Header="Số hóa đơn"
                                    Binding="{Binding InvoiceNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100"/>

                <DataGridTextColumn Header="Diễn giải"
                                    Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*"/>

                <DataGridTemplateColumn Header="Hạn TT" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DueDate, StringFormat=dd/MM/yyyy}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding DueDate, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Phải thu"
                                    Binding="{Binding AmountDue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Thanh toán"
                                    Binding="{Binding AmountPaid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                    Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Padding"             Value="0,0,6,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="" Width="32">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" FontSize="10" Padding="4,2"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource AppColor.TextSecondary}"
                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══════════════════════════════════════════ -->
        <!-- Error banner                               -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="20,8,20,0"
                Padding="12,8"
                Background="{StaticResource AppColor.BackgroundErrorLight}"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
            <controls:AppLabel Text="{Binding ErrorMessage}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"/>
        </Border>

        <!-- ══════════════════════════════════════════ -->
        <!-- Footer                                     -->
        <!-- ══════════════════════════════════════════ -->
        <Border Grid.Row="4"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="20,14"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:AppButton Grid.Column="0"
                                    Content="+ Thêm dòng"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding AddLineCommand}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <controls:AppButton Content="Hủy bỏ"
                                        Style="{StaticResource AppButton.Tertiary.Medium}"
                                        Command="{Binding CancelCommand}"
                                        Margin="0,0,10,0"/>
                    <controls:AppButton Content="💳 Thu tiền"
                                        Style="{StaticResource AppButton.Primary.Medium}"
                                        Command="{Binding SaveCommand}"
                                        Width="130"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</Window>
