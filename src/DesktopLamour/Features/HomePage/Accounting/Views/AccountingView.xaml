<UserControl x:Class="DesktopLamour.Features.HomePage.Accounting.Views.AccountingView"
             xmlns:helpers="clr-namespace:DesktopLamour.Shared.Helpers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             xmlns:local="clr-namespace:DesktopLamour.Features.HomePage.Accounting.ViewModels"
             xmlns:models="clr-namespace:DesktopLamour.Shared.Models"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <!-- 2026-09-26: phím tắt giống Chứng từ bán hàng (SalesOrderListView) — cùng CanExecute theo trạng
         thái phiếu như nút trên thanh công cụ. Không gán Ctrl+N vì "Thêm" ở đây phải chọn loại phiếu
         (Phiếu thu / Phiếu chi / Thu hàng loạt). -->
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+E" Command="{Binding EditEntryCommand}"/>
        <KeyBinding Gesture="Ctrl+D" Command="{Binding DeleteEntryCommand}"/>
        <KeyBinding Gesture="Ctrl+G" Command="{Binding ConfirmEntryCommand}"/>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding UnconfirmEntryCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <SolidColorBrush x:Key="GroupHeaderBrush" Color="#BDD7EE"/>
        <SolidColorBrush x:Key="GroupBorderBrush"  Color="#9CB8D4"/>

        <Style x:Key="CleanHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <!-- Stretch header content so the per-column inline filter row (StackPanel/Grid +
                 AppTextField/ComboBox, all set to Stretch) fills the column instead of sizing to
                 its natural width and sitting centered — same fix applied in
                 SalesOrderReportDetailView. The ControlTemplate below also hardcodes
                 HorizontalAlignment="Stretch" on its ContentPresenter, so this Setter is a
                 belt-and-suspenders match with that reference pattern. -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
        </Style>

        <Style x:Key="CellNumber" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CellCenter" TargetType="TextBlock" BasedOn="{StaticResource AppNumberCell}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar -->
            <RowDefinition Height="Auto"/>   <!-- Filter bar -->
            <RowDefinition Height="Auto"/>   <!-- Tồn đầu/cuối kỳ -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="5" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="Sổ Kế Toán Chi Tiết Quỹ Tiền Mặt"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Tài khoản: 111 — Tiền mặt"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Toolbar actions — 2026-09-26: cùng bố cục/thứ tự/kiểu nút với Chứng từ bán hàng      -->
        <!--  (SalesOrderListView). Sửa/Ghi sổ/Bỏ ghi/Xóa bật/tắt theo trạng thái phiếu đang chọn   -->
        <!--  (xem CanConfirmSelected/... trong AccountingViewModel).                               -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <!-- "Thêm" gộp 3 loại phiếu (trước đây là 3 nút riêng) — bấm mở menu chọn loại. -->
                <controls:AppButton x:Name="AddButton"
                                    Content="➕ Thêm ▾"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Click="AddButton_Click"
                                    Margin="0,0,8,0">
                    <controls:AppButton.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📄 Phiếu thu" Command="{Binding OpenReceiptCommand}"/>
                            <MenuItem Header="📄 Phiếu chi" Command="{Binding OpenPaymentCommand}"/>
                            <MenuItem Header="📄 Thu tiền khách hàng hàng loạt" Command="{Binding OpenBulkCustomerReceiptCommand}"/>
                        </ContextMenu>
                    </controls:AppButton.ContextMenu>
                </controls:AppButton>
                <controls:AppButton Content="✏️ Sửa"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding EditEntryCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📗 Ghi sổ"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ConfirmEntryCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="↩️ Bỏ ghi"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding UnconfirmEntryCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="🗑️ Xóa"
                                    Style="{StaticResource AppButton.Destructive.Medium}"
                                    Command="{Binding DeleteEntryCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="📤 Xuất khẩu"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding ExportExcelCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="✉️ Gửi email"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendEmailCommand}"
                                    Margin="0,0,8,0"/>
                <controls:AppButton Content="💬 Gửi Zalo"
                                    Style="{StaticResource AppButton.Secondary.Medium}"
                                    Command="{Binding SendZaloCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Filter bar                                    -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="24,8,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <!-- Hàng lọc — mọi ô cùng Height="36" + VerticalAlignment="Center" để nhãn và
                 ComboBox/DatePicker canh giữa theo cùng 1 baseline (tránh nhãn bị lệch lên
                 trên do ComboBox/DatePicker cao hơn text nhãn). -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:AppLabel Text="Kỳ:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{x:Static local:AccountingViewModel.PeriodOptions}"
                          SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"
                          Width="130" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Margin="0,0,16,0"/>

                <controls:AppLabel Text="Từ ngày:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            Width="140" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Margin="0,0,16,0"/>
                <controls:AppLabel Text="Đến ngày:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            Width="140" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Margin="0,0,16,0"/>

                <controls:AppLabel Text="Trạng thái:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{x:Static local:AccountingViewModel.StatusOptions}"
                          SelectedItem="{Binding FilterStatus, Mode=TwoWay}"
                          Width="120" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Margin="0,0,16,0"/>

                <controls:AppLabel Text="Loại:"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{x:Static local:AccountingViewModel.TypeOptions}"
                          SelectedItem="{Binding FilterType, Mode=TwoWay}"
                          Width="100" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Margin="0,0,16,0"/>

                <controls:AppButton Content="🔍 Lấy dữ liệu"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Summary: Số tồn đầu kỳ / cuối kỳ            -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="24,8,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Số tồn đầu kỳ:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Margin="0,0,8,0"/>
                <controls:AppLabel helpers:NegativeAmountHighlight.IsEnabled="True" Text="{Binding OpeningBalance, Converter={StaticResource MoneyConverter}}"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Foreground="{StaticResource AppColor.TextPrimary}"
                                   Margin="0,0,32,0"/>
                <controls:AppLabel Text="Số tồn cuối kỳ:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Margin="0,0,8,0"/>
                <controls:AppLabel helpers:NegativeAmountHighlight.IsEnabled="True" Text="{Binding ClosingBalance, Converter={StaticResource MoneyConverter}}"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Foreground="{StaticResource AppColor.TextPrimary}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid                                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="4" Margin="24,8,24,24">

            <!-- Error banner -->
            <Border Panel.ZIndex="10"
                    Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            FontSize="11"
                            Padding="6,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource AppColor.TextError}"
                            Cursor="Hand"
                            Focusable="False"
                            Command="{Binding DismissErrorCommand}"/>
                    <controls:AppLabel Text="{Binding ErrorMessage}"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextError}"/>
                </DockPanel>
            </Border>

            <DataGrid x:Name="LedgerGrid"
                      ItemsSource="{Binding ItemsView}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      MouseDoubleClick="LedgerGrid_MouseDoubleClick"
                      PreviewMouseRightButtonDown="LedgerGrid_PreviewMouseRightButtonDown"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{StaticResource GroupBorderBrush}"
                      VerticalGridLinesBrush="{StaticResource GroupBorderBrush}"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ColumnHeaderStyle="{StaticResource CleanHeaderStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- 2026-09-26: tô dòng Treo (chưa ghi sổ) giống hệt danh sách Chứng từ bán hàng
                     (SalesOrderListView.xaml): chữ cam đậm cả dòng; lúc chọn dòng Treo thì thay Template
                     của cell (nền cam, chữ trắng) vì DataGridCell mặc định tự đè màu lúc Selected. -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeld}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsHeld}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Background="{StaticResource AppColor.ButtonPrimaryHover}"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  TextElement.Foreground="{StaticResource AppColor.TextInverted}"
                                                                  TextElement.FontWeight="SemiBold"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <!-- Menu chuột phải — cùng bố cục với Chứng từ bán hàng. Chuột phải tự chọn dòng đang
                     trỏ (LedgerGrid_PreviewMouseRightButtonDown) để các lệnh áp đúng phiếu đó. -->
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="➕ Thêm">
                            <MenuItem Header="📄 Phiếu thu" Command="{Binding OpenReceiptCommand}"/>
                            <MenuItem Header="📄 Phiếu chi" Command="{Binding OpenPaymentCommand}"/>
                            <MenuItem Header="📄 Thu tiền khách hàng hàng loạt" Command="{Binding OpenBulkCustomerReceiptCommand}"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="👁 Xem" Command="{Binding ViewEntryCommand}"/>
                        <MenuItem Header="✏️ Sửa" InputGestureText="Ctrl+E" Command="{Binding EditEntryCommand}"/>
                        <MenuItem Header="🗑️ Xóa" InputGestureText="Ctrl+D" Command="{Binding DeleteEntryCommand}"/>
                        <Separator/>
                        <MenuItem Header="📗 Ghi sổ" InputGestureText="Ctrl+G" Command="{Binding ConfirmEntryCommand}"/>
                        <MenuItem Header="↩️ Bỏ ghi" InputGestureText="Ctrl+B" Command="{Binding UnconfirmEntryCommand}"/>
                        <Separator/>
                        <MenuItem Header="📨 Gửi email, Zalo">
                            <MenuItem Header="✉️ Email" Command="{Binding SendEmailCommand}"/>
                            <MenuItem Header="💬 Zalo" Command="{Binding SendZaloCommand}"/>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>


                <DataGrid.Columns>

                    <!-- Ngày hạch toán — date column: operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Binding="{Binding AccountingDate, StringFormat=dd/MM/yyyy}"
                                        Width="130" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="1,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Ngày hạch toán" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Grid Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                      SelectedItem="{Binding DataContext.AccountingDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                                   ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                        SelectedDate="{Binding DataContext.AccountingDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        FontSize="10" Height="22"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ngày chứng từ — date column: operator combo (=, ≤, ≥...) + DatePicker, inline -->
                    <DataGridTextColumn Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}"
                                        Width="130" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Ngày chứng từ" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Grid Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                      SelectedItem="{Binding DataContext.DocumentDateFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                                   ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <DatePicker Grid.Column="1" HorizontalAlignment="Stretch"
                                                        SelectedDate="{Binding DataContext.DocumentDateFilter.Value, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        FontSize="10" Height="22"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số phiếu thu — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Binding="{Binding ReceiptNumber}"
                                        Width="110" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Số phiếu thu" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.FilterReceiptNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,0,2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số phiếu chi — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Binding="{Binding PaymentNumber}"
                                        Width="110" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Số phiếu chi" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.FilterPaymentNumber, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,0,2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Diễn giải — text column: plain Contains filter, inline. Fixed width (not "*") —
                         mixing a star column with HorizontalScrollBarVisibility="Auto" is a known WPF
                         DataGrid quirk that clips trailing columns instead of scrolling to them. -->
                    <DataGridTextColumn Binding="{Binding Description}"
                                        Width="250" ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Diễn giải" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"/>
                                        <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.FilterDescription, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,0,2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số tiền — numeric column: operator combo (=, ≤, ≥...) + value box, inline -->
                    <DataGridTextColumn Binding="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                        Width="130" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Số tiền" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Grid Margin="0,4,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{x:Static models:FilterOperatorSymbols.All}"
                                                      SelectedItem="{Binding DataContext.AmountFilter.Operator, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      Width="30" FontSize="10" Padding="2,0" Margin="0,0,3,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource FilterOperatorSymbolConverter}}"
                                                                   ToolTip="{Binding Converter={StaticResource FilterOperatorLabelConverter}}"
                                                                   HorizontalAlignment="Center"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <controls:AppTextField Grid.Column="1" Placeholder="Giá trị" TextAlignment="Right" HorizontalAlignment="Stretch"
                                                                    Text="{Binding DataContext.AmountFilter.ValueText, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                    FontWeight="Normal" FontSize="11" Height="22"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Người nhận/Người nộp — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Binding="{Binding PersonName}"
                                        Width="170" ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Người nhận/Người nộp" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.FilterPersonName, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,0,2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Lý do thu/chi — text column: plain Contains filter, inline. Display via
                         PaymentReasonDisplayConverter (raw enum string → Vietnamese label). -->
                    <DataGridTextColumn Binding="{Binding PaymentReason, Converter={StaticResource PaymentReasonDisplayConverter}}"
                                        Width="130" ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Lý do thu/chi" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.FilterPaymentReason, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,0,2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Loại chứng từ — text column: plain Contains filter, inline -->
                    <DataGridTextColumn Binding="{Binding DocumentType}"
                                        Width="220" ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,1,1" Padding="6,4">
                                    <StackPanel>
                                        <TextBlock Text="Loại chứng từ" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <controls:AppTextField Placeholder="Lọc..." HorizontalAlignment="Stretch"
                                                                Text="{Binding DataContext.FilterDocumentType, RelativeSource={RelativeSource AncestorType=DataGrid}, UpdateSourceTrigger=PropertyChanged}"
                                                                FontWeight="Normal" FontSize="11" Height="22" Margin="0,4,0,2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chọn khoảng thời gian và nhấn Xem báo cáo."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
