<UserControl x:Class="DesktopLamour.Features.HomePage.Accounting.Views.AccountingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundSecondary}">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GroupHeaderBrush" Color="#BDD7EE"/>
        <SolidColorBrush x:Key="GroupBorderBrush"  Color="#9CB8D4"/>

        <Style x:Key="CleanHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="6,0,0,0"/>
        </Style>

        <Style x:Key="CellNumber" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="Padding"             Value="0,0,8,0"/>
        </Style>

        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="4" IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Page header                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,32,24,0">
            <controls:AppButton Content="← Quay lại"
                                Style="{StaticResource AppButton.Tertiary.Medium}"
                                Command="{Binding GoBackCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"/>
            <controls:AppLabel Text="Sổ Kế Toán Chi Tiết Quỹ Tiền Mặt"
                               Style="{StaticResource AppTypography.DisplayPage}"/>
            <controls:AppLabel Text="Tài khoản: 111 — Tiền mặt"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Filter toolbar                                -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="24,16,24,0"
                Padding="16,12"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:AppLabel Text="Từ ngày"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            Width="140" Margin="0,0,16,0"/>
                <controls:AppLabel Text="Đến ngày"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            Width="140" Margin="0,0,16,0"/>
                <controls:AppButton Content="🔍 Xem báo cáo"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding LoadCommand}"/>
                <controls:AppButton Content="📄 Phiếu Thu"
                                    Style="{StaticResource AppButton.Primary.Medium}"
                                    Command="{Binding OpenReceiptCommand}"
                                    Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Summary: Số tồn đầu kỳ / cuối kỳ            -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="24,8,24,0"
                Padding="16,10"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <controls:AppLabel Text="Số tồn đầu kỳ:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Margin="0,0,8,0"/>
                <controls:AppLabel Text="{Binding OpeningBalance, StringFormat=\{0:N0\}}"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Foreground="{StaticResource AppColor.TextPrimary}"
                                   Margin="0,0,32,0"/>
                <controls:AppLabel Text="Số tồn cuối kỳ:"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Margin="0,0,8,0"/>
                <controls:AppLabel Text="{Binding ClosingBalance, StringFormat=\{0:N0\}}"
                                   Style="{StaticResource AppTypography.LabelSection}"
                                   Foreground="{StaticResource AppColor.TextPrimary}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  DataGrid                                      -->
        <!-- ══════════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="24,8,24,24">

            <!-- Error banner -->
            <Border Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8" Padding="12,10" Margin="0,0,0,12"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding ErrorMessage}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource AppColor.BorderThin}"
                      BorderThickness="1"
                      RowBackground="{StaticResource AppColor.BackgroundPrimary}"
                      AlternatingRowBackground="{StaticResource AppColor.BackgroundSecondary}"
                      ColumnHeaderStyle="{StaticResource CleanHeaderStyle}"
                      Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">

                <DataGrid.Columns>

                    <!-- Ngày hạch toán -->
                    <DataGridTextColumn Binding="{Binding AccountingDate, StringFormat=dd/MM/yyyy}"
                                        Width="110" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="1,1,0,1" Padding="6,4">
                                    <TextBlock Text="Ngày hạch toán" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Ngày chứng từ -->
                    <DataGridTextColumn Binding="{Binding DocumentDate, StringFormat=dd/MM/yyyy}"
                                        Width="110" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="Ngày chứng từ" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số phiếu thu -->
                    <DataGridTextColumn Binding="{Binding ReceiptNumber}"
                                        Width="100" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="Số phiếu thu" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số phiếu chi -->
                    <DataGridTextColumn Binding="{Binding PaymentNumber}"
                                        Width="100" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="Số phiếu chi" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Diễn giải -->
                    <DataGridTextColumn Binding="{Binding Description}"
                                        Width="*" ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="Diễn giải" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Tài khoản -->
                    <DataGridTextColumn Binding="{Binding Account}"
                                        Width="80" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="Tài khoản" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- TK đối ứng -->
                    <DataGridTextColumn Binding="{Binding CounterAccount}"
                                        Width="90" ElementStyle="{StaticResource CellCenter}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="TK đối ứng" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- ═══════════════════════ Nhóm: Số phát sinh ═══════════════════════ -->

                    <!-- Nợ -->
                    <DataGridTextColumn Binding="{Binding DebitAmount, StringFormat=\{0:N0\}}"
                                        Width="110" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,0">
                                        <TextBlock Text="Số phát sinh" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="1,1,0,1">
                                        <TextBlock Text="Nợ" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Có -->
                    <DataGridTextColumn Binding="{Binding CreditAmount, StringFormat=\{0:N0\}}"
                                        Width="110" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="26"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Background="{StaticResource GroupHeaderBrush}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,0"/>
                                    <Border Grid.Row="1"
                                            Background="{StaticResource AppColor.BackgroundSecondary}"
                                            BorderBrush="{StaticResource GroupBorderBrush}"
                                            BorderThickness="0,1,1,1">
                                        <TextBlock Text="Có" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Số tồn -->
                    <DataGridTextColumn Binding="{Binding Balance, StringFormat=\{0:N0\}}"
                                        Width="120" ElementStyle="{StaticResource CellNumber}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="6,4">
                                    <TextBlock Text="Số tồn" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                    <!-- Người nhận/Người nộp -->
                    <DataGridTextColumn Binding="{Binding PersonName}"
                                        Width="160" ElementStyle="{StaticResource CellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource AppColor.BackgroundSecondary}"
                                        BorderBrush="{StaticResource GroupBorderBrush}"
                                        BorderThickness="0,1,1,1" Padding="6,4">
                                    <TextBlock Text="Người nhận/Người nộp" FontWeight="SemiBold" FontSize="12"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center" TextAlignment="Center"/>
                <controls:AppLabel Text="Chọn khoảng thời gian và nhấn Xem báo cáo."
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center"/>
            </StackPanel>

        </Grid>
    </Grid>

</UserControl>
