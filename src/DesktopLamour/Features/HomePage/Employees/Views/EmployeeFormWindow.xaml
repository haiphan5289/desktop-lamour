<Window x:Class="DesktopLamour.Features.HomePage.Employees.Views.EmployeeFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="{Binding WindowTitle}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Decorative header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Form content -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Action buttons -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="{StaticResource AppColor.BackgroundOverlay}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True"
                         Width="40" Height="40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 0: Decorative header strip                -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="{Binding WindowTitle}"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Thông tin nhân viên"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 1: Form content                           -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="24,20,24,8">

            <!-- Tên nhân viên (required) -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:AppLabel Text="Tên nhân viên"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                    <controls:AppLabel Text=" *"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
                <controls:AppTextField Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="VD: Nguyễn Văn A"/>
            </StackPanel>

            <!-- Số điện thoại (required) -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:AppLabel Text="Số điện thoại"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                    <controls:AppLabel Text=" *"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
                <controls:AppTextField Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="VD: 0912345678"/>
            </StackPanel>

            <!-- Chức vụ (required) -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:AppLabel Text="Chức vụ"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                    <controls:AppLabel Text=" *"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding Role, Mode=TwoWay}"
                          Padding="10,8"
                          FontSize="14"/>
            </StackPanel>

            <!-- Đơn vị (required) -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:AppLabel Text="Đơn vị"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                    <controls:AppLabel Text=" *"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Units}"
                          SelectedItem="{Binding Unit, Mode=TwoWay}"
                          Padding="10,8"
                          FontSize="14"/>
            </StackPanel>

            <!-- Mật khẩu -->
            <StackPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <controls:AppLabel Text="Mật khẩu"
                                       Style="{StaticResource AppTypography.LabelSection}"/>
                    <controls:AppLabel Text=" (để trống = dùng số điện thoại)"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <controls:AppLabel Text=" (để trống = không đổi)"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"
                                       Margin="4,0,0,0"
                                       Visibility="{Binding IsAddMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
                <controls:AppTextField Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                       Placeholder="••••••••"/>
            </StackPanel>

            <!-- Hoạt động -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                <controls:AppLabel Text="Nhân viên đang hoạt động"
                                   Style="{StaticResource AppTypography.BodySection}"/>
            </StackPanel>

            <!-- Error message -->
            <Border Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding ErrorMessage}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 2: Action buttons                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton Content="Hủy"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,12,0"/>
                <controls:AppButton Content="💾 Lưu"
                                    Style="{StaticResource AppButton.Primary.Large}"
                                    Command="{Binding SaveCommand}"
                                    Width="140"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
