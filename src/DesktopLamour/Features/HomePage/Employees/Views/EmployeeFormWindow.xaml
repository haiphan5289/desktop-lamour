<Window x:Class="DesktopLamour.Features.HomePage.Employees.Views.EmployeeFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
        Title="{Binding WindowTitle}"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Width="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Row 0: Decorative header -->
            <RowDefinition Height="Auto"/>  <!-- Row 1: Form content -->
            <RowDefinition Height="Auto"/>  <!-- Row 2: Action buttons -->
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <controls:AppLoadingOverlay Grid.RowSpan="3"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 0: Decorative header strip                -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource AppColor.BackgroundBrand}"
                Padding="24,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤"
                           FontSize="28"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <controls:AppLabel Text="{Binding WindowTitle}"
                                       Style="{StaticResource AppTypography.DisplaySection}"
                                       Foreground="{StaticResource AppColor.TextBrand}"/>
                    <controls:AppLabel Text="Thông tin nhân viên"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 1: Form content — 2 cột ngang, bọc trong ScrollViewer -->
        <!-- ══════════════════════════════════════════════ -->
        <!-- MaxHeight=520 (không phải chiều cao nội dung thực — nội dung form chỉ ~420px) — đây là
             trần an toàn: SizeToContent="Height" + ResizeMode="NoResize" khiến WPF không biết chiều
             cao màn hình thật khi dựng cửa sổ, nên nếu header(~90) + MaxHeight + hàng nút(~72) + title
             bar vượt màn hình, chính hàng nút Lưu/Hủy bị đẩy ra ngoài — cùng lỗi ban đầu, chỉ dịch lên
             1 cấp. Khớp trần với ProductFormWindow để nhất quán trong toàn bộ app. -->
        <ScrollViewer Grid.Row="1" Background="Transparent" VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Margin="24,20,24,8">

            <!-- Tên nhân viên (required) | Giới tính (required) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <controls:AppLabel Text="Tên nhân viên"
                                           Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <controls:AppTextField Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VD: Nguyễn Văn A"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <controls:AppLabel Text="Giới tính"
                                           Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Genders}"
                              SelectedItem="{Binding Gender, Mode=TwoWay}"
                              Padding="10,8"
                              FontSize="14"/>
                </StackPanel>
            </Grid>

            <!-- Số điện thoại (optional) | Chức vụ (required) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Số điện thoại"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,6"/>
                    <controls:AppTextField Text="{Binding Phone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VD: 0912345678"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <controls:AppLabel Text="Chức vụ"
                                           Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding Role, Mode=TwoWay}"
                              Padding="10,8"
                              FontSize="14"/>
                </StackPanel>
            </Grid>

            <!-- Đơn vị (required) | Chức danh (required) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <controls:AppLabel Text="Đơn vị"
                                           Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Units}"
                              SelectedItem="{Binding Unit, Mode=TwoWay}"
                              Padding="10,8"
                              FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <controls:AppLabel Text="Chức danh"
                                           Style="{StaticResource AppTypography.LabelSection}"/>
                        <controls:AppLabel Text=" *"
                                           Style="{StaticResource AppTypography.LabelSection}"
                                           Foreground="{StaticResource AppColor.TextBrand}"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding JobTitles}"
                              SelectedItem="{Binding JobTitle, Mode=TwoWay}"
                              Padding="10,8"
                              FontSize="14"/>
                </StackPanel>
            </Grid>

            <!-- Số tài khoản (optional) | Tên ngân hàng (optional) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <controls:AppLabel Text="Số tài khoản"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,6"/>
                    <controls:AppTextField Text="{Binding BankAccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VD: 0123456789"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <controls:AppLabel Text="Tên ngân hàng"
                                       Style="{StaticResource AppTypography.LabelSection}"
                                       Margin="0,0,0,6"/>
                    <controls:AppTextField Text="{Binding BankName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="VD: Vietcombank"/>
                </StackPanel>
            </Grid>

            <!-- Mật khẩu | Hoạt động -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <controls:AppLabel Text="Mật khẩu"
                                           Style="{StaticResource AppTypography.LabelSection}"/>
                    </StackPanel>
                    <controls:AppTextField Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Placeholder="••••••••"/>
                    <controls:AppLabel Text="Để trống = dùng SĐT, hoặc mã NV nếu không có SĐT"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <controls:AppLabel Text="Để trống = không đổi"
                                       Style="{StaticResource AppTypography.BodyCaption}"
                                       Foreground="{StaticResource AppColor.TextSecondary}"
                                       Margin="0,4,0,0"
                                       Visibility="{Binding IsAddMode, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <controls:AppLabel Text="Nhân viên đang hoạt động"
                                           Style="{StaticResource AppTypography.BodySection}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Error message -->
            <Border Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,8,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding ErrorMessage}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Row 2: Action buttons                         -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource AppColor.BorderThin}"
                BorderThickness="0,1,0,0"
                Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <controls:AppButton Content="Hủy"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,12,0"/>
                <controls:AppButton Content="💾 Lưu"
                                    Style="{StaticResource AppButton.Primary.Large}"
                                    Command="{Binding SaveCommand}"
                                    Width="140"/>
            </StackPanel>
        </Border>

    </Grid>

</Window>
