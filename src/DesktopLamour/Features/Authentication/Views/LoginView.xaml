<UserControl x:Class="DesktopLamour.Features.Authentication.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             Background="{StaticResource AppColor.BackgroundPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer actions -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Loading overlay                               -->
        <!-- ══════════════════════════════════════════════ -->
        <controls:AppLoadingOverlay Grid.RowSpan="3"
                                    IsLoading="{Binding IsLoading}"/>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Header                                        -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="24,40,24,0">
            <controls:AppLabel Text="Welcome Back"
                               Style="{StaticResource AppTypography.DisplayPage}"/>

            <controls:AppLabel Text="Sign in to continue."
                               Style="{StaticResource AppTypography.BodySection}"
                               Foreground="{StaticResource AppColor.TextSecondary}"
                               Margin="0,8,0,0"/>
        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Form                                          -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="24,32,24,0">

            <!-- Phone -->
            <controls:AppLabel Text="Phone Number"
                               Style="{StaticResource AppTypography.LabelSection}"/>

            <controls:AppTextField x:Name="PhoneField"
                                   Text="{Binding PhoneNumber, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                                   Placeholder="e.g. 0912345678"
                                   Margin="0,8,0,0"
                                   TabIndex="0"
                                   AutomationProperties.Name="Phone Number"/>

            <controls:AppLabel Text="{Binding PhoneError}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"
                               Margin="0,6,0,0"
                               Visibility="{Binding PhoneError,
                                            Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- Password -->
            <controls:AppLabel Text="Password"
                               Style="{StaticResource AppTypography.LabelSection}"
                               Margin="0,20,0,0"/>

            <Grid Margin="0,8,0,0">
                <!-- Password hidden (default) -->
                <controls:AppPasswordField BoundPassword="{Binding Password, Mode=TwoWay}"
                                           TabIndex="1"
                                           AutomationProperties.Name="Password"
                                           Visibility="{Binding IsPasswordVisible,
                                                        Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <!-- Password visible -->
                <TextBox Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         TabIndex="1"
                         Padding="12,0,44,0"
                         Height="44"
                         VerticalContentAlignment="Center"
                         BorderBrush="{StaticResource AppColor.BorderRegular}"
                         BorderThickness="1"
                         AutomationProperties.Name="Password (visible)"
                         Visibility="{Binding IsPasswordVisible,
                                      Converter={StaticResource BoolToVisibilityConverter}}"/>
                <!-- Eye toggle button -->
                <Button Command="{Binding TogglePasswordVisibilityCommand}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Panel.ZIndex="10"
                        ToolTip="Show / Hide password">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AppColor.TextSecondary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE7B3;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                        <Setter Property="Text" Value="&#xED1A;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <controls:AppLabel Text="{Binding PasswordError}"
                               Style="{StaticResource AppTypography.BodyCaption}"
                               Foreground="{StaticResource AppColor.TextError}"
                               Margin="0,6,0,0"
                               Visibility="{Binding PasswordError,
                                            Converter={StaticResource StringToVisibilityConverter}}"/>

            <!-- General error -->
            <Border Background="{StaticResource AppColor.BackgroundErrorLight}"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,16,0,0"
                    Visibility="{Binding GeneralError,
                                 Converter={StaticResource StringToVisibilityConverter}}">
                <controls:AppLabel Text="{Binding GeneralError}"
                                   Style="{StaticResource AppTypography.BodyCaption}"
                                   Foreground="{StaticResource AppColor.TextError}"/>
            </Border>

        </StackPanel>

        <!-- ══════════════════════════════════════════════ -->
        <!--  Footer actions                                -->
        <!-- ══════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Margin="24,24,24,40">

            <controls:AppButton Content="Sign In"
                                Style="{StaticResource AppButton.Primary.Large}"
                                Command="{Binding LoginCommand}"
                                TabIndex="10"/>

            <!-- Register link -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0">
                <controls:AppLabel Text="Don't have an account?"
                                   Style="{StaticResource AppTypography.BodySection}"
                                   Foreground="{StaticResource AppColor.TextSecondary}"
                                   VerticalAlignment="Center"/>
                <controls:AppButton Content="Create Account"
                                    Style="{StaticResource AppButton.Tertiary.Medium}"
                                    Command="{Binding NavigateToRegisterCommand}"
                                    TabIndex="11"
                                    Margin="4,0,0,0"/>
            </StackPanel>

        </StackPanel>

    </Grid>

</UserControl>
