<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls">

    <!-- ================================================ -->
    <!--  AppLabel base style                              -->
    <!-- ================================================ -->
    <Style TargetType="{x:Type controls:AppLabel}">
        <Setter Property="FontFamily"       Value="Segoe UI"/>
        <Setter Property="FontSize"         Value="14"/>
        <Setter Property="Foreground"       Value="{StaticResource AppColor.TextPrimary}"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppLabel}">
                    <TextBlock Text="{TemplateBinding Content}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}"
                               FontStyle="{TemplateBinding FontStyle}"
                               Foreground="{TemplateBinding Foreground}"
                               Padding="{TemplateBinding Padding}"
                               TextWrapping="Wrap"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--  AppLabel named typography styles                 -->
    <!--  (BasedOn works here — same file as base style)  -->
    <!-- ================================================ -->
    <Style x:Key="AppTypography.DisplayPage" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="AppTypography.DisplaySection" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="AppTypography.HeaderPage" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AppTypography.HeaderSection" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AppTypography.LabelPage" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AppTypography.LabelSection" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AppTypography.LabelCaption" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="AppTypography.BodySection" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="AppTypography.BodyCaption" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource AppColor.TextSecondary}"/>
    </Style>
    <Style x:Key="AppTypography.NoteSection" TargetType="{x:Type controls:AppLabel}"
           BasedOn="{StaticResource {x:Type controls:AppLabel}}">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStyle"  Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource AppColor.TextSecondary}"/>
    </Style>

    <!-- ================================================ -->
    <!--  AppTextField base style                          -->
    <!-- ================================================ -->
    <Style TargetType="{x:Type controls:AppTextField}">
        <Setter Property="FontFamily"     Value="Segoe UI"/>
        <Setter Property="FontSize"       Value="14"/>
        <Setter Property="Foreground"     Value="{StaticResource AppColor.TextPrimary}"/>
        <Setter Property="Background"     Value="{StaticResource AppColor.BackgroundPrimary}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource AppColor.BorderRegular}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="12,10"/>
        <Setter Property="Height"         Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppTextField}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <Grid Margin="{TemplateBinding Padding}">
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="{StaticResource AppColor.TextDisabled}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"   Value="{StaticResource AppColor.TextDisabled}"/>
                            <Setter Property="BorderBrush"  Value="{StaticResource AppColor.BorderThin}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--  AppPasswordField base style                      -->
    <!-- ================================================ -->
    <Style TargetType="{x:Type controls:AppPasswordField}">
        <Setter Property="FontFamily"     Value="Segoe UI"/>
        <Setter Property="FontSize"       Value="14"/>
        <Setter Property="Foreground"     Value="{StaticResource AppColor.TextPrimary}"/>
        <Setter Property="Background"     Value="{StaticResource AppColor.BackgroundPrimary}"/>
        <Setter Property="BorderBrush"    Value="{StaticResource AppColor.BorderRegular}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"        Value="12,10"/>
        <Setter Property="Height"         Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppPasswordField}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <PasswordBox x:Name="PART_PasswordBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderActive}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--  AppButton base style                             -->
    <!-- ================================================ -->
    <Style TargetType="{x:Type controls:AppButton}">
        <Setter Property="FontFamily"   Value="Segoe UI"/>
        <Setter Property="FontSize"     Value="14"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{StaticResource AppColor.TextInverted}"/>
        <Setter Property="Background"   Value="{StaticResource AppColor.ButtonPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppButton}">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource AppColor.ButtonPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background"
                                    Value="{StaticResource AppColor.ButtonPrimaryDisabled}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--  AppButton named styles                           -->
    <!-- ================================================ -->
    <Style x:Key="AppButton.Primary.Small" TargetType="{x:Type controls:AppButton}"
           BasedOn="{StaticResource {x:Type controls:AppButton}}">
        <Setter Property="Height"   Value="32"/>
        <Setter Property="Padding"  Value="12,0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="AppButton.Primary.Medium" TargetType="{x:Type controls:AppButton}"
           BasedOn="{StaticResource {x:Type controls:AppButton}}">
        <Setter Property="Height"   Value="40"/>
        <Setter Property="Padding"  Value="16,0"/>
    </Style>

    <Style x:Key="AppButton.Primary.Large" TargetType="{x:Type controls:AppButton}"
           BasedOn="{StaticResource {x:Type controls:AppButton}}">
        <Setter Property="Height"           Value="52"/>
        <Setter Property="Padding"          Value="16,0"/>
        <Setter Property="FontSize"         Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="AppButton.Secondary.Medium" TargetType="{x:Type controls:AppButton}"
           BasedOn="{StaticResource {x:Type controls:AppButton}}">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="16,0"/>
        <Setter Property="Background"       Value="{StaticResource AppColor.ButtonSecondary}"/>
        <Setter Property="Foreground"       Value="{StaticResource AppColor.TextBrand}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource AppColor.BorderBrand}"/>
        <Setter Property="BorderThickness"  Value="1"/>
    </Style>

    <Style x:Key="AppButton.Tertiary.Medium" TargetType="{x:Type controls:AppButton}"
           BasedOn="{StaticResource {x:Type controls:AppButton}}">
        <Setter Property="Height"           Value="40"/>
        <Setter Property="Padding"          Value="8,0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{StaticResource AppColor.TextBrand}"/>
        <Setter Property="BorderThickness"  Value="0"/>
    </Style>

    <Style x:Key="AppButton.Destructive.Medium" TargetType="{x:Type controls:AppButton}"
           BasedOn="{StaticResource {x:Type controls:AppButton}}">
        <Setter Property="Height"     Value="40"/>
        <Setter Property="Padding"    Value="16,0"/>
        <Setter Property="Background" Value="{StaticResource AppColor.ButtonDestructive}"/>
    </Style>

</ResourceDictionary>
