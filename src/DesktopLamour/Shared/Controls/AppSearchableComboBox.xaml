<UserControl x:Class="DesktopLamour.Shared.Controls.AppSearchableComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls"
             x:Name="Self">

    <UserControl.Resources>
        <controls:SearchableItemDropdownTextConverter x:Key="DropdownTextConverter"/>

        <DataTemplate x:Key="DefaultItemTemplate">
            <TextBlock Text="{Binding Converter={StaticResource DropdownTextConverter}}"/>
        </DataTemplate>

        <!-- 2026-11-15: ShowStockAndPrice=True — bảng "Mã hàng | Tên hàng | SL tồn | Giá bán" khớp MISA.
             Item là Product (ProductList.Domain.Models). Cột cố định để thẳng hàng với StockPriceHeader;
             đổi bề rộng cột ở đây thì đổi luôn ở header bên dưới. -->
        <DataTemplate x:Key="StockPriceItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Code}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding DropdownStockText}" TextAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDropdownOutOfStock}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AppColor.TextError}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="3" Text="{Binding DropdownPriceText}" TextAlignment="Right"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>

        <!-- ══ Field border ═══════════════════════════════════════════════════ -->
        <Border x:Name="FieldBorder"
                Height="44"
                BorderBrush="{StaticResource AppColor.BorderRegular}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{StaticResource AppColor.BackgroundPrimary}">

            <Grid x:Name="FieldGrid" Margin="12,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <!-- Search input -->
                <!-- 2026-09-13: đo pixel thật xác nhận chữ ở đây luôn hiện ra ~#7F7F82 (xám) thay vì
                     #1A1A1A (TextPrimary) khi cả field bị khoá (Grid.IsEnabled=False ở cửa sổ cha) —
                     dù Foreground đã set cứng TextPrimary. Nguyên nhân: TextBox này dùng ControlTemplate
                     MẶC ĐỊNH của WPF, có sẵn hiệu ứng Opacity giảm khi Disabled (bên trong template hệ
                     thống, Foreground không chặn được vì Opacity là lớp render riêng, không cạnh tranh
                     với giá trị Foreground). Cho hẳn 1 Template tối giản (không VisualState Disabled)
                     để loại bỏ hiệu ứng mờ mặc định này — mirror cách AppTextField đã tự viết
                     ControlTemplate riêng và không bị mờ. -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         FontFamily="Segoe UI"
                         FontSize="14"
                         Foreground="{StaticResource AppColor.TextPrimary}"
                         CaretBrush="{StaticResource AppColor.TextPrimary}"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="{TemplateBinding Background}"
                                          Focusable="False"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Placeholder overlay -->
                <TextBlock x:Name="PlaceholderText"
                           Grid.Column="0"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="{StaticResource AppColor.TextDisabled}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Add button — shown only when AddCommand is bound -->
                <Button x:Name="AddButton"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Width="28"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Content="+"
                        Background="Transparent"
                        BorderThickness="1,0,0,0"
                        BorderBrush="{StaticResource AppColor.BorderThin}"
                        Foreground="{StaticResource AppColor.TextBrand}"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="Thêm mới"/>

                <!-- Arrow toggle -->
                <Button x:Name="ToggleButton"
                        Grid.Column="2"
                        Content="▾"
                        FontSize="12"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource AppColor.TextSecondary}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Focusable="False"/>

                <!-- Clear button (visible when IsNullable=True and item selected) -->
                <Button x:Name="ClearButton"
                        Grid.Column="2"
                        Content="✕"
                        FontSize="12"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource AppColor.TextSecondary}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        Focusable="False"/>
            </Grid>
        </Border>

        <!-- ══ Dropdown popup ══════════════════════════════════════════════════ -->
        <Popup x:Name="DropdownPopup"
               PlacementTarget="{Binding ElementName=FieldBorder}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border x:Name="DropdownBorder"
                    MinWidth="{Binding ActualWidth, ElementName=FieldBorder}"
                    Background="{StaticResource AppColor.BackgroundPrimary}"
                    BorderBrush="{StaticResource AppColor.BorderRegular}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,2,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="12" ShadowDepth="2"/>
                </Border.Effect>

                <DockPanel>
                <!-- Header cột — chỉ hiện khi ShowStockAndPrice=True. Lề trái 14 = ListBox Padding 4 +
                     ListBoxItem Padding 10 để thẳng hàng với StockPriceItemTemplate. -->
                <Border x:Name="StockPriceHeader"
                        DockPanel.Dock="Top"
                        Visibility="Collapsed"
                        Padding="14,8,14,6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource AppColor.BorderThin}">
                    <Grid TextBlock.FontFamily="Segoe UI"
                          TextBlock.FontSize="13"
                          TextBlock.FontWeight="SemiBold"
                          TextBlock.Foreground="{StaticResource AppColor.TextSecondary}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mã hàng"/>
                        <TextBlock Grid.Column="1" Text="Tên hàng"/>
                        <TextBlock Grid.Column="2" Text="SL tồn" TextAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="Giá bán" TextAlignment="Right"/>
                    </Grid>
                </Border>

                <ListBox x:Name="ItemsList"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="4"
                         MaxHeight="200"
                         ItemTemplate="{StaticResource DefaultItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI"
                         FontSize="14">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"    Value="10,7"/>
                            <Setter Property="Cursor"     Value="Hand"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background"
                                                        Value="{StaticResource AppColor.BackgroundBrand}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background"
                                                        Value="{StaticResource AppColor.BackgroundBrand}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                </DockPanel>
            </Border>
        </Popup>

    </Grid>
</UserControl>
