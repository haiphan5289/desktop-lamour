<UserControl x:Class="DesktopLamour.Shared.Controls.AppLoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             Panel.ZIndex="100">

    <Grid Background="{StaticResource AppColor.BackgroundOverlay}"
          Visibility="{Binding IsLoading, ElementName=Self,
                       Converter={StaticResource BoolToVisibilityConverter}}">

        <!-- Card -->
        <Border Width="160" Height="160"
                Background="{StaticResource AppColor.BackgroundPrimary}"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="28" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Spinning ring -->
                <Grid Width="56" Height="56" Margin="0,0,0,14" HorizontalAlignment="Center">

                    <!-- Track -->
                    <Ellipse Width="56" Height="56"
                             Stroke="{StaticResource AppColor.BorderThin}"
                             StrokeThickness="4"/>

                    <!-- Arc -->
                    <Ellipse Width="56" Height="56"
                             Stroke="{StaticResource AppColor.ButtonPrimary}"
                             StrokeThickness="4"
                             StrokeDashArray="10 33"
                             StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="SpinnerRotate"
                                            Storyboard.TargetProperty="Angle"
                                            From="0" To="360"
                                            Duration="0:0:0.85"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>

                </Grid>

                <!-- Label -->
                <TextBlock Text="Đang tải..."
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource AppColor.TextSecondary}"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
