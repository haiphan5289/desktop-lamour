<UserControl x:Class="DesktopLamour.Shared.Controls.DocumentToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">

    <!-- ══════════════════════════════════════════════════════════════════════
         Thanh công cụ chứng từ dùng chung cho mọi popup (Bán hàng, Bán hàng
         trả lại, Nhập kho, Phiếu thu, Phiếu chi). Dải ribbon icon-trên/chữ-dưới
         khớp phong cách MISA. Mỗi nút chỉ hiện khi window có bind command tương
         ứng (và cờ *Visibility cho phép) — "chỉ nút có chức năng thật".

         2026-09-01: trước đó toàn bộ icon/chữ đều đen/xám trơn (trừ riêng "Xóa"
         đã đỏ sẵn) và khung bám sát mép cửa sổ (kiểu ribbon Office) — khác hẳn
         màu cam brand (#F28A00) + khung thẻ bo tròn có margin dùng ở mọi màn
         danh sách trong app, khiến popup trông "lạc lõng". Fix: (1) tô màu
         icon/chữ theo đúng vai trò từng nút (cam = hành động chính, đỏ = xóa,
         xám = điều hướng/tiện ích — cùng quy ước AppButton.Primary/Destructive/
         Secondary), (2) đổi khung ngoài từ dải sát mép sang thẻ bo tròn có
         margin, y hệt Border toolbar trên các màn danh sách (vd. SalesReturnListView).
         ══════════════════════════════════════════════════════════════════════ -->

    <UserControl.Resources>

        <!-- Base — điều hướng/tiện ích (Trước, Sau, Bỏ ghi, Treo, In, Đóng): xám trung
             tính, hover nền xám nhạt. Nút mang hành động chính/nguy hiểm override
             Foreground + dùng DocRibbonButton.Brand/Destructive bên dưới. -->
        <Style x:Key="DocRibbonButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AppColor.BackgroundSecondary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hành động chính (Thêm, Sửa, Ghi sổ, Lập PN/Lập phiếu xuất): hover nền cam nhạt
             — cùng tông AppColor.BackgroundBrand mà AppButton.Secondary dùng làm hover. -->
        <Style x:Key="DocRibbonButton.Brand" TargetType="Button" BasedOn="{StaticResource DocRibbonButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AppColor.BackgroundBrand}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Xóa: hover nền đỏ nhạt — cùng tông AppColor.BackgroundErrorLight. -->
        <Style x:Key="DocRibbonButton.Destructive" TargetType="Button" BasedOn="{StaticResource DocRibbonButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AppColor.BackgroundErrorLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocRibbonIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource AppColor.TextSecondary}"/>
        </Style>

        <Style x:Key="DocRibbonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource AppColor.TextSecondary}"/>
        </Style>

        <!-- Icon/chữ hành động chính — cam brand, cùng tông AppButton.Primary/Secondary. -->
        <Style x:Key="DocRibbonIcon.Brand" TargetType="TextBlock" BasedOn="{StaticResource DocRibbonIcon}">
            <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
        </Style>
        <Style x:Key="DocRibbonLabel.Brand" TargetType="TextBlock" BasedOn="{StaticResource DocRibbonLabel}">
            <Setter Property="Foreground" Value="{StaticResource AppColor.TextBrand}"/>
        </Style>

        <!-- Icon/chữ Xóa — đỏ, cùng tông AppButton.Destructive. -->
        <Style x:Key="DocRibbonIcon.Destructive" TargetType="TextBlock" BasedOn="{StaticResource DocRibbonIcon}">
            <Setter Property="Foreground" Value="{StaticResource AppColor.TextError}"/>
        </Style>
        <Style x:Key="DocRibbonLabel.Destructive" TargetType="TextBlock" BasedOn="{StaticResource DocRibbonLabel}">
            <Setter Property="Foreground" Value="{StaticResource AppColor.TextError}"/>
        </Style>

    </UserControl.Resources>

    <!-- Khung thẻ bo tròn có margin — y hệt Border toolbar trên các màn danh sách
         (vd. SalesReturnListView Grid.Row="1"), thay cho dải ribbon sát mép trước đây. -->
    <Border Margin="24,16,24,0"
            Padding="16,12"
            Background="{StaticResource AppColor.BackgroundPrimary}"
            BorderBrush="{StaticResource AppColor.BorderThin}"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel Orientation="Horizontal">

            <!-- ── Nhóm 1: Điều hướng ─────────────────────────────────── -->
            <Button Style="{StaticResource DocRibbonButton}" Command="{Binding PrevCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="PrevCommand" ElementName="Self"/>
                        <Binding Path="PrevVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="◀" Style="{StaticResource DocRibbonIcon}"/>
                    <TextBlock Text="Trước" Style="{StaticResource DocRibbonLabel}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DocRibbonButton}" Command="{Binding NextCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="NextCommand" ElementName="Self"/>
                        <Binding Path="NextVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="▶" Style="{StaticResource DocRibbonIcon}"/>
                    <TextBlock Text="Sau" Style="{StaticResource DocRibbonLabel}"/>
                </StackPanel>
            </Button>

            <Rectangle Width="1" Margin="4,6" Fill="{StaticResource AppColor.BorderThin}">
                <Rectangle.Visibility>
                    <MultiBinding Converter="{StaticResource AnyNotNullToVisibilityConverter}">
                        <Binding Path="AddCommand" ElementName="Self"/>
                        <Binding Path="EditCommand" ElementName="Self"/>
                        <Binding Path="DeleteCommand" ElementName="Self"/>
                    </MultiBinding>
                </Rectangle.Visibility>
            </Rectangle>

            <!-- ── Nhóm 2: Thêm / Sửa / Xóa ───────────────────────────── -->
            <Button Style="{StaticResource DocRibbonButton.Brand}" Command="{Binding AddCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="AddCommand" ElementName="Self"/>
                        <Binding Path="AddVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="➕" Style="{StaticResource DocRibbonIcon.Brand}"/>
                    <TextBlock Text="Thêm" Style="{StaticResource DocRibbonLabel.Brand}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DocRibbonButton.Brand}" Command="{Binding EditCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="EditCommand" ElementName="Self"/>
                        <Binding Path="EditVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="✏️" Style="{StaticResource DocRibbonIcon.Brand}"/>
                    <TextBlock Text="Sửa" Style="{StaticResource DocRibbonLabel.Brand}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DocRibbonButton.Destructive}" Command="{Binding DeleteCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="DeleteCommand" ElementName="Self"/>
                        <Binding Path="DeleteVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="🗑️" Style="{StaticResource DocRibbonIcon.Destructive}"/>
                    <TextBlock Text="Xóa" Style="{StaticResource DocRibbonLabel.Destructive}"/>
                </StackPanel>
            </Button>

            <Rectangle Width="1" Margin="4,6" Fill="{StaticResource AppColor.BorderThin}">
                <Rectangle.Visibility>
                    <MultiBinding Converter="{StaticResource AnyNotNullToVisibilityConverter}">
                        <Binding Path="SaveCommand" ElementName="Self"/>
                        <Binding Path="UnpostCommand" ElementName="Self"/>
                        <Binding Path="HoldCommand" ElementName="Self"/>
                    </MultiBinding>
                </Rectangle.Visibility>
            </Rectangle>

            <!-- ── Nhóm 3: Ghi sổ / Bỏ ghi / Treo ─────────────────────── -->
            <Button Style="{StaticResource DocRibbonButton.Brand}" Command="{Binding SaveCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="SaveCommand" ElementName="Self"/>
                        <Binding Path="SaveVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="💾" Style="{StaticResource DocRibbonIcon.Brand}"/>
                    <TextBlock Text="{Binding SaveLabel, ElementName=Self}" Style="{StaticResource DocRibbonLabel.Brand}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DocRibbonButton}" Command="{Binding UnpostCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="UnpostCommand" ElementName="Self"/>
                        <Binding Path="UnpostVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="↩️" Style="{StaticResource DocRibbonIcon}"/>
                    <TextBlock Text="Bỏ ghi" Style="{StaticResource DocRibbonLabel}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DocRibbonButton}" Command="{Binding HoldCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="HoldCommand" ElementName="Self"/>
                        <Binding Path="HoldVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="⏸" Style="{StaticResource DocRibbonIcon}"/>
                    <TextBlock Text="Treo" Style="{StaticResource DocRibbonLabel}"/>
                </StackPanel>
            </Button>

            <Rectangle Width="1" Margin="4,6" Fill="{StaticResource AppColor.BorderThin}"
                       Visibility="{Binding CreateExportCommand, ElementName=Self, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- ── Nhóm 4: Lập phiếu xuất / Lập PN ────────────────────── -->
            <Button Style="{StaticResource DocRibbonButton.Brand}" Command="{Binding CreateExportCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="CreateExportCommand" ElementName="Self"/>
                        <Binding Path="CreateExportVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="🧾" Style="{StaticResource DocRibbonIcon.Brand}"/>
                    <TextBlock Text="{Binding CreateExportLabel, ElementName=Self}" Style="{StaticResource DocRibbonLabel.Brand}"/>
                </StackPanel>
            </Button>

            <Rectangle Width="1" Margin="4,6" Fill="{StaticResource AppColor.BorderThin}"
                       Visibility="{Binding PrintCommand, ElementName=Self, Converter={StaticResource NullToVisibilityConverter}}"/>

            <!-- ── Nhóm 5: In ─────────────────────────────────────────── -->
            <Button Style="{StaticResource DocRibbonButton}" Command="{Binding PrintCommand, ElementName=Self}">
                <Button.Visibility>
                    <MultiBinding Converter="{StaticResource CommandAndFlagToVisibilityConverter}">
                        <Binding Path="PrintCommand" ElementName="Self"/>
                        <Binding Path="PrintVisibility" ElementName="Self"/>
                    </MultiBinding>
                </Button.Visibility>
                <StackPanel>
                    <TextBlock Text="🖨️" Style="{StaticResource DocRibbonIcon}"/>
                    <TextBlock Text="In" Style="{StaticResource DocRibbonLabel}"/>
                </StackPanel>
            </Button>

            <Rectangle Width="1" Margin="4,6" Fill="{StaticResource AppColor.BorderThin}"
                       Visibility="{Binding ShowClose, ElementName=Self, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- ── Đóng (luôn hiện) ───────────────────────────────────── -->
            <Button Style="{StaticResource DocRibbonButton}"
                    Click="CloseButton_Click"
                    Visibility="{Binding ShowClose, ElementName=Self, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="✖️" Style="{StaticResource DocRibbonIcon}"/>
                    <TextBlock Text="Đóng" Style="{StaticResource DocRibbonLabel}"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </Border>

</UserControl>
