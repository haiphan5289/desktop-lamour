<UserControl x:Class="DesktopLamour.Shared.Controls.AppCurrencyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">

    <Border x:Name="FieldBorder"
            Height="44"
            BorderBrush="{StaticResource AppColor.BorderRegular}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{StaticResource AppColor.BackgroundPrimary}">

        <Grid Margin="12,0">
            <!-- Placeholder -->
            <TextBlock x:Name="PlaceholderBlock"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="{StaticResource AppColor.TextDisabled}"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

            <!-- Input -->
            <!-- 2026-09-14: TextBox dùng ControlTemplate mặc định của WPF có hiệu ứng giảm
                 opacity khi Disabled (đè lên cả Foreground đã set cứng TextPrimary) — chứng từ
                 sau khi "cất" (IsEditable=False) khoá field này qua Grid.IsEnabled ở cửa sổ cha,
                 khiến số tiền hiện mờ dù đã chọn màu đen. Cho hẳn 1 Template tối giản (không
                 VisualState Disabled) để loại bỏ hiệu ứng mờ mặc định — mirror cách
                 AppSearchableComboBox.SearchBox đã sửa cùng vấn đề này. -->
            <TextBox x:Name="InputBox"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     Foreground="{StaticResource AppColor.TextPrimary}"
                     CaretBrush="{StaticResource AppColor.TextPrimary}"
                     TextAlignment="Right"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Background="{TemplateBinding Background}"
                                      Focusable="False"/>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>
        </Grid>
    </Border>

</UserControl>
