<UserControl x:Class="DesktopLamour.Shared.Controls.AppCurrencyField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">

    <Border x:Name="FieldBorder"
            Height="44"
            BorderBrush="{StaticResource AppColor.BorderRegular}"
            BorderThickness="1"
            CornerRadius="8"
            Background="{StaticResource AppColor.BackgroundPrimary}">

        <Grid Margin="12,0">
            <!-- Placeholder -->
            <TextBlock x:Name="PlaceholderBlock"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       Foreground="{StaticResource AppColor.TextDisabled}"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"/>

            <!-- Input -->
            <TextBox x:Name="InputBox"
                     FontFamily="Segoe UI"
                     FontSize="14"
                     Foreground="{StaticResource AppColor.TextPrimary}"
                     CaretBrush="{StaticResource AppColor.TextPrimary}"
                     TextAlignment="Right"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"/>
        </Grid>
    </Border>

</UserControl>
