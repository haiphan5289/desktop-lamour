<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:DesktopLamour.Shared.Helpers">

    <!-- 2026-09-26: ô số CHỈ ĐỌC trong DataGrid (ElementStyle) — căn phải, lề phải 6px (khớp các cột số
         sẵn có), tự tô đỏ khi số âm "(1.458.000)" giống MISA. Dùng kèm Binding ... Converter=MoneyConverter. -->
    <Style x:Key="AppNumberCell" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Padding"             Value="0,0,6,0"/>
        <Setter Property="helpers:NegativeAmountHighlight.IsEnabled" Value="True"/>
    </Style>

</ResourceDictionary>
