<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:DesktopLamour.Shared.Controls">

    <!-- ================================================ -->
    <!--  AppPasswordField base style                      -->
    <!-- ================================================ -->
    <Style TargetType="{x:Type controls:AppPasswordField}">
        <Setter Property="FontFamily"      Value="Segoe UI"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Foreground"      Value="{StaticResource AppColor.TextPrimary}"/>
        <Setter Property="Background"      Value="{StaticResource AppColor.BackgroundPrimary}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource AppColor.BorderRegular}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Height"          Value="44"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AppPasswordField}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <PasswordBox x:Name="PART_PasswordBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderActive}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderThin}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--  Error state variant                              -->
    <!-- ================================================ -->
    <Style x:Key="AppPasswordField.Error" TargetType="{x:Type controls:AppPasswordField}"
           BasedOn="{StaticResource {x:Type controls:AppPasswordField}}">
        <Setter Property="BorderBrush" Value="{StaticResource AppColor.BorderError}"/>
    </Style>

</ResourceDictionary>
