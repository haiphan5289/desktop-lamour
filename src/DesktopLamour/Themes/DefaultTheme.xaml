<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================ -->
    <!--  Text Colors                                      -->
    <!-- ================================================ -->
    <SolidColorBrush x:Key="AppColor.TextPrimary"   Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AppColor.TextSecondary" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="AppColor.TextDisabled"  Color="#B0B0B0"/>
    <SolidColorBrush x:Key="AppColor.TextError"     Color="#D0021B"/>
    <SolidColorBrush x:Key="AppColor.TextBrand"     Color="#F28A00"/>
    <SolidColorBrush x:Key="AppColor.TextInverted"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppColor.TextSuccess"   Color="#27AE60"/>

    <!-- ================================================ -->
    <!--  Background Colors                                -->
    <!-- ================================================ -->
    <SolidColorBrush x:Key="AppColor.BackgroundPrimary"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppColor.BackgroundSecondary"    Color="#F7F7F7"/>
    <SolidColorBrush x:Key="AppColor.BackgroundBrand"        Color="#FFF3E0"/>
    <SolidColorBrush x:Key="AppColor.BackgroundErrorLight"   Color="#FDECEA"/>
    <SolidColorBrush x:Key="AppColor.BackgroundWarningLight" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="AppColor.BackgroundOverlay"      Color="#80000000"/>

    <!-- ================================================ -->
    <!--  Border Colors                                    -->
    <!-- ================================================ -->
    <SolidColorBrush x:Key="AppColor.BorderThin"    Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AppColor.BorderRegular" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="AppColor.BorderActive"  Color="#F28A00"/>
    <SolidColorBrush x:Key="AppColor.BorderBrand"   Color="#F28A00"/>
    <SolidColorBrush x:Key="AppColor.BorderError"   Color="#D0021B"/>

    <!-- ================================================ -->
    <!--  Button Colors                                    -->
    <!-- ================================================ -->
    <SolidColorBrush x:Key="AppColor.ButtonPrimary"          Color="#F28A00"/>
    <SolidColorBrush x:Key="AppColor.ButtonPrimaryHover"     Color="#E07A00"/>
    <SolidColorBrush x:Key="AppColor.ButtonPrimaryDisabled"  Color="#FFD180"/>
    <SolidColorBrush x:Key="AppColor.ButtonSecondary"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppColor.ButtonDestructive"      Color="#D0021B"/>

    <!-- ================================================ -->
    <!--  Spacing Tokens                                   -->
    <!-- ================================================ -->
    <Thickness x:Key="AppSpacing.XSmall"  Left="4"  Top="4"  Right="4"  Bottom="4"/>
    <Thickness x:Key="AppSpacing.Small"   Left="8"  Top="8"  Right="8"  Bottom="8"/>
    <Thickness x:Key="AppSpacing.Medium"  Left="12" Top="12" Right="12" Bottom="12"/>
    <Thickness x:Key="AppSpacing.Large"   Left="16" Top="16" Right="16" Bottom="16"/>
    <Thickness x:Key="AppSpacing.XLarge"  Left="20" Top="20" Right="20" Bottom="20"/>
    <Thickness x:Key="AppSpacing.XXLarge" Left="24" Top="24" Right="24" Bottom="24"/>

    <!-- ================================================ -->
    <!--  Corner Radius Tokens                             -->
    <!-- ================================================ -->
    <CornerRadius x:Key="AppRadius.Small"  TopLeft="4"  TopRight="4"  BottomLeft="4"  BottomRight="4"/>
    <CornerRadius x:Key="AppRadius.Medium" TopLeft="8"  TopRight="8"  BottomLeft="8"  BottomRight="8"/>
    <CornerRadius x:Key="AppRadius.Large"  TopLeft="12" TopRight="12" BottomLeft="12" BottomRight="12"/>
    <CornerRadius x:Key="AppRadius.Full"   TopLeft="999" TopRight="999" BottomLeft="999" BottomRight="999"/>

</ResourceDictionary>
